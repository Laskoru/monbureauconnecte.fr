---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { coverSrcSet } from '../lib/covers';
import { getRating } from '../lib/ratings';
import AmazonProduct from '../components/AmazonProduct.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ShareButtons from '../components/ShareButtons.astro';
import AuthorBox from '../components/AuthorBox.astro';
import SelectionMethod from '../components/SelectionMethod.astro';
import { siteConfig } from '../siteConfig';
import { categories, type CategorySlug } from '../categories';
import { isAvailable, productUrl } from '../lib/availability';
import AmazonSearchCTA from '../components/AmazonSearchCTA.astro';
import InteractiveGuide from '../components/InteractiveGuide.astro';
import Icon from '../components/Icon.astro';
import { frenchNbsp } from '../lib/typo';
import { mesuresProduit } from '../lib/mesures';

interface Heading { depth: number; slug: string; text: string }
interface FaqItem { question: string; answer: string }
interface Comparison { columns: string[]; rows: string[][] }
interface Source { label: string; url: string }
interface GuideOption { label: string; result: string }
interface InteractiveGuideData { title: string; question: string; intro?: string; options: GuideOption[] }
interface HowToStep { name: string; text: string }
interface HowToData { name?: string; steps: HowToStep[] }
interface Product { asin: string; title: string; image?: string; blurb?: string; search?: string; pros?: string[]; cons?: string[]; award?: string }

interface Props {
  slug: string;
  title: string;
  seoTitle?: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  coverImage?: string;
  coverAlt?: string;
  category: CategorySlug;
  products?: Product[];
  headings?: Heading[];
  readingMinutes?: number;
  faq?: FaqItem[];
  comparison?: Comparison;
  sources?: Source[];
  interactiveGuide?: InteractiveGuideData;
  howto?: HowToData;
  topPick?: { name: string; blurb?: string; url: string; ctaLabel?: string };
  hasAmazonLinks?: boolean;
}

const {
  slug, title, seoTitle, description, pubDate, updatedDate, author, coverImage, coverAlt, category,
  keywords = [], products = [], headings = [], readingMinutes, faq = [], comparison,
  interactiveGuide, howto, sources = [], topPick, hasAmazonLinks = false,
} = Astro.props;
const hasProducts = siteConfig.amazon.enabled && products.length > 0;
const hasAffiliateLinks = hasProducts || Boolean(topPick) || hasAmazonLinks;

// Le badge « Notre choix » suit le premier produit RÉELLEMENT disponible ;
// les colonnes du comparatif dont le produit est épuisé sont marquées.
const productsAvailability = products.map((p) => isAvailable(p.asin));
const featuredIndex = productsAvailability.findIndex(Boolean);
const someProductUnavailable = productsAvailability.some((a) => !a);
const comparisonColumnUnavailable = comparison?.columns.map((_, i) => i > 0 && productsAvailability[i - 1] === false);
const searchTopic = keywords[0];

// Verdict rapide : produits disponibles avec leur distinction (award) ou, à défaut, le premier disponible.
const nf = new Intl.NumberFormat('fr-FR');
const shortTitle = (t: string) => t.split(/\s[—–-]\s/)[0].trim();
const verdict = products.map((p, i) => ({ p, i, available: productsAvailability[i], rating: getRating(p.asin) })).filter((v) => v.available && (v.p.award || v.i === featuredIndex)).slice(0, 5);
const choice = featuredIndex >= 0 ? { p: products[featuredIndex], rating: getRating(products[featuredIndex].asin) } : null;

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const choiceMesures = choice ? mesuresProduit(choice.p) : [];
const choicePct = choice?.rating ? Math.round((choice.rating.rating / 5) * 1000) / 10 : 0;
// Cartouche : numéro de planche (ordre de publication), rubrique, révision, mesures
const tousLesArticles = await getCollection('articles', (a) => !a.data.draft);
const ordre = [...tousLesArticles].sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf() || a.slug.localeCompare(b.slug));
const planche = String(ordre.findIndex((a) => a.slug === slug) + 1).padStart(2, '0');
const nbPlanches = String(ordre.length).padStart(2, '0');
const dateCourte = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
const categoryInfo = categories.find((c) => c.slug === category);
const relatedArticles = (await getCollection('articles', (a) => !a.data.draft && a.data.category === category && a.slug !== slug))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat(siteConfig.locale.replace('_', '-'), { year: 'numeric', month: 'long', day: 'numeric' });
const siteUrl = Astro.site?.origin ?? Astro.url.origin;
const shareUrl = new URL(Astro.url.pathname, siteUrl).toString();
const coverImageAbs = coverImage ? new URL(coverImage, siteUrl).toString() : undefined;

const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description,
  datePublished: pubDate.toISOString(), dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', '@id': `${siteUrl}/auteur/#person`, name: author ?? siteConfig.author, url: new URL('/auteur/', siteUrl).toString() },
  publisher: { '@type': 'Organization', name: siteConfig.name, '@id': `${siteUrl}/#organization` },
  ...(coverImageAbs ? { image: coverImageAbs } : {}),
  ...(sources.length > 0 ? { citation: sources.map((s) => ({ '@type': 'CreativeWork', name: s.label, url: s.url })) } : {}),
  mainEntityOfPage: new URL(Astro.url.pathname, siteUrl).toString(),
};
const faqSchema = faq.length > 0 ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) } : null;
const howtoSchema = howto && howto.steps.length > 1 ? { '@context': 'https://schema.org', '@type': 'HowTo', name: howto.name ?? title, description, ...(coverImageAbs ? { image: coverImageAbs } : {}), step: howto.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.name, text: s.text })) } : null;
const jsonLdArticle = [articleSchema, ...(howtoSchema ? [howtoSchema] : []), ...(faqSchema ? [faqSchema] : [])];
const breadcrumbItems = [{ label: 'Accueil', href: '/' }, ...(categoryInfo ? [{ label: categoryInfo.label, href: `/categorie/${categoryInfo.slug}/` }] : []), { label: title }];
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  ogImage={coverImageAbs}
  ogType="article"
  jsonLd={jsonLdArticle}
  article={{ publishedTime: pubDate.toISOString(), modifiedTime: (updatedDate ?? pubDate).toISOString(), author: author ?? siteConfig.author, section: categoryInfo?.label, tags: keywords }}
>
  <article class="art">
    <div class="wide art__top">
      <Breadcrumbs items={breadcrumbItems} />
      <h1 class="art__title">{frenchNbsp(title)}</h1>
      <p class="art__lede">{description}</p>
      <dl class="cartouche art__cartouche">
        <div><dt>Planche</dt><dd class="mono">{planche}/{nbPlanches}</dd></div>
        <div><dt>Rubrique</dt><dd>{categoryInfo ? <a href={`/categorie/${categoryInfo.slug}/`}>{categoryInfo.label}</a> : 'Guide'}</dd></div>
        <div><dt>{updatedDate && updatedDate.getTime() !== pubDate.getTime() ? 'Mis à jour' : 'Publié'}</dt><dd class="mono">{dateCourte.format(updatedDate ?? pubDate)}</dd></div>
        <div><dt>Mesures</dt><dd class="mono">{products.length > 0 ? `${products.length} produit${products.length > 1 ? 's' : ''}` : 'conseil'}{readingMinutes ? ` · ${readingMinutes} min` : ''}</dd></div>
        <div><dt>Par</dt><dd><a href="/auteur/">{author ?? siteConfig.author}</a></dd></div>
      </dl>
    </div>

    <div class="wide art__grid">
      <div class="art__main">
        {coverImage && (
          <figure class="art__cover cadre">
            <img src={coverImage} srcset={coverSrcSet(coverImage)} sizes="(max-width: 800px) 100vw, 740px" alt={coverAlt ?? ''} width="1600" height="1000" fetchpriority="high" />
          </figure>
        )}

        {(choice || topPick) && (
          <aside class="verdict" aria-label="Notre choix">
            <p class="verdict__label">Notre choix{choice?.p.award && choice.p.award !== 'Notre choix' ? ` · ${choice.p.award}` : ''}</p>
            <div class="verdict__body">
              <div class="verdict__text">
                <p class="verdict__name">{topPick ? topPick.name : shortTitle(choice!.p.title)}</p>
                {!topPick && choiceMesures.length > 0 && <ul class="mesures" aria-label="Mesures du produit">{choiceMesures.map((m) => <li>{m}</li>)}</ul>}
                {choice?.rating && (
                  <p class="reglette">
                    <span class="reglette__rule" style={`--p:${choicePct}%`} role="img" aria-label={`Note Amazon : ${choice.rating.rating.toFixed(1).replace('.', ',')} sur 5`}></span>
                    <span class="reglette__val"><b>{choice.rating.rating.toFixed(1).replace('.', ',')}</b>/5 · {nf.format(choice.rating.count)} avis Amazon</span>
                  </p>
                )}
                {(topPick?.blurb ?? choice?.p.blurb) && <p class="verdict__blurb">{topPick?.blurb ?? choice?.p.blurb}</p>}
                {choice?.p.pros && choice.p.pros.length > 0 && <p class="verdict__pros"><span>Points forts</span> {choice.p.pros.slice(0, 3).join(' · ')}</p>}
              </div>
              <div class="verdict__cta">
                <a class="btn btn--buy" href={topPick ? topPick.url : productUrl(choice!.p.asin)} target="_blank" rel="nofollow sponsored noopener">{topPick?.ctaLabel ?? 'Voir le prix sur Amazon'} <Icon name="external" size={16} /></a>
                {hasProducts && <a class="verdict__more" href="#recommandations">Voir tous les produits comparés</a>}
              </div>
            </div>
          </aside>
        )}

        {verdict.length > 1 && (
          <section class="quick" aria-labelledby="quick-titre">
            <h2 id="quick-titre" class="quick__title">Ce qu'on retient en 30 secondes</h2>
            <ul class="quick__list">
              {verdict.map((v) => (
                <li><span class="quick__award">{v.p.award ?? 'Notre choix'}</span><a href={`#produit-${v.i + 1}`}>{shortTitle(v.p.title)}</a>{v.rating && <span class="quick__rating">{v.rating.rating.toFixed(1).replace('.', ',')}/5 · {nf.format(v.rating.count)} avis</span>}{v.p.blurb && <span class="quick__blurb">{v.p.blurb}</span>}</li>
              ))}
            </ul>
          </section>
        )}

        {hasAffiliateLinks && <AffiliateDisclosure />}

        {tocHeadings.length > 1 && (
          <nav class="toc toc--inline" aria-label="Sommaire">
            <p class="toc__title">Sommaire</p>
            <ol>{tocHeadings.map((h) => <li data-depth={h.depth}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}

        <div class="article-body"><slot /></div>

        {interactiveGuide && <InteractiveGuide guide={interactiveGuide} />}
        {hasProducts && searchTopic && <AmazonSearchCTA topic={searchTopic} />}

        {comparison && comparison.rows.length > 0 && (
          <div class="article-comparison" id="comparatif">
            <h2>Comparatif en un coup d'œil</h2>
            <div class="compare-table-wrap">
              <table class="compare-table">
                <thead><tr>{comparison.columns.map((col, i) => <th class:list={{ 'is-choice': i > 0 && i - 1 === featuredIndex }}>{col}{comparisonColumnUnavailable?.[i] && <span class="compare-table__tag">épuisé</span>}</th>)}</tr></thead>
                <tbody>{comparison.rows.map((row) => <tr>{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td class:list={{ 'is-choice': i - 1 === featuredIndex }}>{cell}</td>))}</tr>)}</tbody>
              </table>
            </div>
            {someProductUnavailable && <p class="compare-table__note"><strong>épuisé</strong> : ce modèle n'est plus en vente chez Amazon. Les caractéristiques restent indicatives ; le bouton sous le produit propose des équivalents disponibles.</p>}
          </div>
        )}

        {sources.length > 0 && (
          <div class="article-sources">
            <h2>Sources et références</h2>
            <p class="article-sources__intro">Les informations de cet article s'appuient sur des sources publiques et reconnues.</p>
            <ul class="article-sources__list">{sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}<Icon name="external" size={14} /></a></li>)}</ul>
          </div>
        )}

        <ShareButtons url={shareUrl} title={title} image={coverImage} />

        {hasProducts && <SelectionMethod />}

        {hasProducts && (
          <div class="article-recommendations" id="recommandations">
            <h2>{products.length > 1 ? 'Nos recommandations' : 'Notre choix'}</h2>
            {products.map((p, i) => (
              <div id={`produit-${i + 1}`} class="article-recommendations__item">
                <AmazonProduct asin={p.asin} title={p.title} image={p.image} blurb={p.blurb} search={p.search} pros={p.pros} cons={p.cons} award={p.award} fallbackSearch={keywords[0]} featured={i === featuredIndex} />
              </div>
            ))}
          </div>
        )}

        {faq.length > 0 && (
          <div class="article-faq">
            <h2>Questions fréquentes</h2>
            {faq.map((f) => <details class="article-faq__item"><summary><span>{f.question}</span><span class="faq-signe" aria-hidden="true"></span></summary><p>{f.answer}</p></details>)}
          </div>
        )}

        <AuthorBox author={author} />
      </div>

      <aside class="art__rail" aria-label="Navigation dans l'article">
        <div class="art__rail-in">
          {tocHeadings.length > 1 && (
            <nav class="toc toc--rail" aria-label="Sommaire">
              <p class="toc__title">Sommaire</p>
              <ol>{tocHeadings.map((h) => <li data-depth={h.depth}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
            </nav>
          )}
          <div class="rail-box">
            <p class="rail-box__title">Régler ton poste</p>
            <a href="/calculateur-hauteur-bureau/"><Icon name="ruler" size={18} /> Calculer ma hauteur de bureau</a>
            <a href="/poste-de-travail-ideal/"><Icon name="posture" size={18} /> Le poste de travail idéal</a>
            <a href="/checklist-bureau-ergonomique/"><Icon name="checklist" size={18} /> Checklist ergonomie</a>
            <a href="/guides/"><Icon name="map" size={18} /> Guides par besoin</a>
          </div>
        </div>
      </aside>
    </div>

    {relatedArticles.length > 0 && (
      <section class="art__related">
        <div class="wide">
          <span class="regle" aria-hidden="true"></span>
          <div class="section__head">
            <h2 class="section__title">À lire aussi{categoryInfo && <> : {categoryInfo.label}</>}</h2>
            {categoryInfo && <a class="section__link" href={`/categorie/${categoryInfo.slug}/`}>Toute la rubrique <Icon name="arrow" size={16} /></a>}
          </div>
          <div class="art__related-grid">{relatedArticles.map((a) => <ArticleCard article={a} />)}</div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .art__top { padding-top: 1.4rem; padding-bottom: 2rem; }
  .art__title { margin: 0.3rem 0 1rem; font-size: clamp(2.1rem, 1.1rem + 3vw, 3.5rem); max-width: 24ch; }
  .art__lede { margin: 0 0 1.6rem; font-size: 1.15rem; line-height: 1.6; color: var(--gris); max-width: 68ch; }
  .art__cartouche { grid-template-columns: 0.8fr 1.3fr 1fr 1.2fr 1fr; max-width: 980px; }
  .art__cartouche a { text-decoration: none; }
  .art__cartouche a:hover { text-decoration: underline; text-decoration-color: var(--jaune); text-decoration-thickness: 2px; }

  .art__grid { display: grid; grid-template-columns: minmax(0, 760px) 280px; gap: 3.5rem; justify-content: space-between; padding-bottom: 3.5rem; }
  .art__main { min-width: 0; }
  .art__cover { margin: 0 0 2rem; }
  .art__cover img { aspect-ratio: 16 / 9; object-fit: cover; }
  .art__rail-in { position: sticky; top: 88px; display: flex; flex-direction: column; gap: 1.6rem; }
  .toc--rail { margin: 0; max-height: calc(100vh - 260px); overflow: auto; }
  .toc--inline { display: none; }
  .rail-box { display: flex; flex-direction: column; border-top: 1.5px solid var(--mine); padding-top: 0.9rem; }
  .rail-box__title { margin: 0 0 0.4rem; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gris); }
  .rail-box a { display: flex; align-items: center; gap: 0.6em; min-height: 40px; border-bottom: 1px solid var(--filet); font-size: 0.93rem; text-decoration: none; }
  .rail-box a:hover { background: var(--jaune-pale); }

  /* ══ Notre choix ══ */
  .verdict { position: relative; margin: 0.6rem 0 2rem; background: var(--papier); border: 1px solid var(--mine); border-top: 4px solid var(--jaune); }
  .verdict__label { position: absolute; top: -2px; right: 1.4rem; transform: translateY(-50%); margin: 0; padding: 0.3rem 0.6rem; font-family: var(--font-mono); font-weight: 700; font-size: 0.75rem; line-height: 1; letter-spacing: 0.05em; text-transform: uppercase; color: #15171a; background: var(--jaune); }
  .verdict__body { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1.5rem 2rem; align-items: end; padding: 1.3rem 1.4rem 1.3rem; }
  .verdict__text { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
  .verdict__name { margin: 0; font-family: var(--font-display); font-stretch: 125%; font-weight: 400; font-size: clamp(1.45rem, 1.1rem + 1vw, 1.9rem); line-height: 1.1; letter-spacing: -0.02em; }
  .verdict__blurb { margin: 0; color: var(--gris); line-height: 1.55; }
  .verdict__pros { margin: 0; font-size: 0.93rem; line-height: 1.5; }
  .verdict__pros span { margin-right: 0.4em; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ok); }
  .verdict__cta { display: flex; flex-direction: column; align-items: stretch; gap: 0.6rem; min-width: 230px; }
  .verdict__more { text-align: center; font-size: 0.88rem; font-weight: 600; }

  /* ══ Ce qu'on retient ══ */
  .quick { margin: 0 0 2rem; }
  .quick__title { margin: 0 0 0.8rem; font-family: var(--font-body); font-stretch: 100%; font-weight: 600; font-size: 1.15rem; letter-spacing: -0.005em; }
  .quick__list { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--mine); }
  .quick__list li { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 0.2rem 1rem; padding: 0.75rem 0.2rem; border-bottom: 1px solid var(--filet); font-size: 0.95rem; line-height: 1.5; }
  .quick__award { grid-row: span 3; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--gris); padding-top: 0.2em; }
  .quick__list a { font-weight: 600; }
  .quick__rating { font-family: var(--font-mono); font-size: 0.8rem; color: var(--gris); }
  .quick__blurb { color: var(--gris); }

  /* ══ Corps de l'article ══ */
  .article-body { font-size: 1.0625rem; line-height: 1.75; }
  .article-body :global(p) { margin: 0 0 1.25em; }
  .article-body :global(h2) { margin: 2.6em 0 0.7em; padding-top: 0.8em; border-top: 1px solid var(--filet); scroll-margin-top: 5.5rem; font-size: clamp(1.5rem, 1.15rem + 1.1vw, 2rem); line-height: 1.12; }
  .article-body :global(h3) { margin-top: 2em; scroll-margin-top: 5.5rem; font-size: 1.2rem; }
  .article-body :global(a) { font-weight: 500; }
  .article-body :global(img) { display: block; width: 100%; height: auto; margin: 2rem 0; border: 1px solid var(--filet); }
  .article-body :global(ul) { list-style: none; padding-left: 0; margin: 0 0 1.4em; display: flex; flex-direction: column; gap: 0.5em; }
  .article-body :global(ul li) { position: relative; padding-left: 1.5em; }
  .article-body :global(ul li::before) { content: ''; position: absolute; left: 0.1em; top: 0.82em; width: 0.7em; height: 2px; background: var(--mine); }
  .article-body :global(ol) { padding-left: 1.7em; margin: 0 0 1.4em; display: flex; flex-direction: column; gap: 0.55em; }
  .article-body :global(ol li::marker) { font-family: var(--font-mono); font-size: 0.85em; color: var(--gris); }
  .article-body :global(blockquote) { margin: 2rem 0; padding: 1.2rem 1.4rem; background: var(--papier); border: 1px solid var(--filet); border-top: 1.5px solid var(--mine); font-style: normal; }
  .article-body :global(blockquote p) { margin: 0 0 0.5em; }
  .article-body :global(blockquote p:last-child) { margin-bottom: 0; }
  .article-body :global(table) { width: 100%; border-collapse: collapse; margin: 1.8rem 0; font-size: 0.95rem; display: block; overflow-x: auto; border-top: 1.5px solid var(--mine); }
  .article-body :global(th), .article-body :global(td) { text-align: left; padding: 0.7rem 0.85rem; border-bottom: 1px solid var(--filet); vertical-align: top; }
  .article-body :global(thead th) { font-family: var(--font-mono); font-weight: 400; font-size: 0.75rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--gris); white-space: nowrap; border-bottom: 1.5px solid var(--mine); }
  .article-body :global(tbody th) { font-weight: 600; }
  .article-body :global(hr) { margin: 2.8rem 0; }
  .article-recommendations__item { scroll-margin-top: 5.5rem; }

  /* ══ FAQ, sources ══ */
  .article-faq { margin-top: 3rem; }
  .article-faq h2 { margin-bottom: 0.8rem; }
  .article-faq__item { border-bottom: 1px solid var(--filet); }
  .article-faq__item:first-of-type { border-top: 1.5px solid var(--mine); }
  .article-faq__item summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; cursor: pointer; padding: 1rem 0.2rem; font-weight: 600; font-size: 1.05rem; line-height: 1.35; list-style: none; }
  .article-faq__item summary::-webkit-details-marker { display: none; }
  .faq-signe { position: relative; flex-shrink: 0; width: 14px; height: 14px; }
  .faq-signe::before, .faq-signe::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: var(--mine); transition: transform 0.2s var(--ease-out); }
  .faq-signe::after { transform: rotate(90deg); }
  .article-faq__item[open] .faq-signe::after { transform: rotate(0deg); }
  .article-faq__item p { margin: 0 0 1.1rem; padding-right: 2rem; color: var(--gris); line-height: 1.65; }
  .article-sources { margin-top: 3rem; padding-top: 1rem; border-top: 1.5px solid var(--mine); }
  .article-sources h2 { margin: 0 0 0.4rem; font-family: var(--font-body); font-stretch: 100%; font-weight: 600; font-size: 1.15rem; letter-spacing: -0.005em; }
  .article-sources__intro { margin: 0 0 0.9rem; font-size: 0.9rem; color: var(--gris); }
  .article-sources__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.35rem; }
