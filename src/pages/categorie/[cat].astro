---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../siteConfig';
import { categories } from '../../categories';

export async function getStaticPaths() {
  return categories.map((cat) => ({
    params: { cat: cat.slug },
    props: { cat },
  }));
}

const { cat } = Astro.props;

const articles = (await getCollection('articles', ({ data }) => !data.draft && data.category === cat.slug)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const others = categories.filter((c) => c.slug !== cat.slug);
---

<BaseLayout
  title={cat.label}
  noindex={articles.length === 0}
  description={`${cat.description} Tous les guides ${cat.label.toLowerCase()} sur ${siteConfig.name}.`}
>
  <PageHead
    eyebrow="Catégorie"
    title={cat.label}
    lede={cat.description}
    icon={cat.slug}
    crumbs={[{ label: 'Accueil', href: '/' }, { label: cat.label }]}
    count={String(articles.length).padStart(2, '0')}
  />

  <section class="wide cat-body">
    <div class="cat-grid">
      <div class="cat-main">
        {articles.length === 0 && <p class="cat-empty">Aucun guide publié dans cette catégorie pour le moment — les prochains arrivent chaque semaine.</p>}
        <div class="grid2">
          {articles.map((article, i) => <ArticleCard article={article} eager={i < 2} />)}
        </div>
      </div>
      <aside class="cat-side">
        {'intro' in cat && cat.intro && (
          <div class="cat-intro">
            <p class="cat-intro__title"><Icon name="map" size={16} /> Pourquoi cette catégorie</p>
            <p>{cat.intro}</p>
          </div>
        )}
        <div class="cat-others">
          <p class="cat-intro__title"><Icon name="sliders" size={16} /> Explorer aussi</p>
          {others.map((c) => (
            <a class="cat-others__link" href={`/categorie/${c.slug}/`}><Icon name={c.slug} size={18} /> <span>{c.label}</span> <Icon name="arrow" size={14} /></a>
          ))}
          <a class="cat-others__link" href="/guides/"><Icon name="map" size={18} /> <span>Guides par besoin</span> <Icon name="arrow" size={14} /></a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .cat-body { padding-top: 2.6rem; padding-bottom: 4.5rem; }
  .cat-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 3.5rem; align-items: start; }
  .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.4rem 2rem; }
  .cat-empty { margin: 0; padding: 1rem 0.2rem; border-top: 1.5px solid var(--mine); border-bottom: 1px solid var(--filet); color: var(--gris); }
  /* Colonne latérale : blocs réglés (filet mine en tête), liens en lignes à filets */
  .cat-side { position: sticky; top: 88px; display: flex; flex-direction: column; gap: 2rem; }
  .cat-intro, .cat-others { display: flex; flex-direction: column; padding-top: 0.9rem; border-top: 1.5px solid var(--mine); }
  .cat-intro p { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--gris); }
  .cat-side .cat-intro__title { display: flex; align-items: center; gap: 0.5em; margin: 0 0 0.5rem; font-weight: 600; font-size: 1rem; line-height: 1.3; color: var(--mine); }
  .cat-others__link { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.7rem; padding: 0.65rem 0.3rem; border-bottom: 1px solid var(--filet); text-decoration: none; color: var(--mine); font-weight: 600; font-size: 0.95rem; line-height: 1.35; transition: background-color 0.18s ease; }
  .cat-others__link:hover { background: var(--jaune-pale); }
  @media (max-width: 960px) { .cat-grid { grid-template-columns: 1fr; } .cat-side { position: static; } }
  @media (max-width: 640px) { .grid2 { grid-template-columns: 1fr; } }
</style>
