---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../siteConfig';
import { categories } from '../../categories';

export async function getStaticPaths() {
  return categories.map((cat) => ({
    params: { cat: cat.slug },
    props: { cat },
  }));
}

const { cat } = Astro.props;

const articles = (await getCollection('articles', ({ data }) => !data.draft && data.category === cat.slug)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const others = categories.filter((c) => c.slug !== cat.slug);
---

<BaseLayout
  title={cat.label}
  noindex={articles.length === 0}
  description={`${cat.description} Tous les guides ${cat.label.toLowerCase()} sur ${siteConfig.name}.`}
>
  <PageHead
    eyebrow="Catégorie"
    title={cat.label}
    lede={cat.description}
    icon={cat.slug}
    crumbs={[{ label: 'Accueil', href: '/' }, { label: cat.label }]}
    count={String(articles.length).padStart(2, '0')}
  />

  <section class="wide cat-body">
    <div class="cat-grid">
      <div class="cat-main">
        {cat.intro && <div class="cat-intro" set:html={cat.intro} />}
        {articles.length === 0 && <p class="cat-empty">Aucun guide publié dans cette catégorie pour le moment — les prochains arrivent chaque semaine.</p>}
        <div class="grid2">
          {articles.map((article, i) => <ArticleCard article={article} eager={i < 2} />)}
        </div>
      </div>
      <aside class="cat-side">
        <div class="cat-others">
          <p class="cat-intro__title"><Icon name="sliders" size={16} /> Explorer aussi</p>
          {others.map((c) => (
            <a class="cat-others__link" href={`/categorie/${c.slug}/`}><Icon name={c.slug} size={18} /> <span>{c.label}</span> <Icon name="arrow" size={14} /></a>
          ))}
          <a class="cat-others__link" href="/guides/"><Icon name="map" size={18} /> <span>Guides par besoin</span> <Icon name="arrow" size={14} /></a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .cat-body { padding-top: 2.6rem; padding-bottom: 4.5rem; }
  .cat-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 3.5rem; align-items: start; }
  .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.4rem 2rem; }
  .cat-empty { margin: 0; padding: 1.1rem 1.3rem; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); color: var(--gris); }
  /* Texte d'introduction en tête de liste : même lecture que l'intro des pages budget */
  .cat-intro { max-width: 66ch; margin: 0 0 2.4rem; font-size: 1.08rem; line-height: 1.7; }
  .cat-intro :global(p) { margin: 0 0 1em; }
  .cat-intro :global(p:last-child) { margin-bottom: 0; }
  /* Colonne latérale : cartes papier, liens en lignes à filets, flèche en pastille */
  .cat-side { position: sticky; top: 88px; display: flex; flex-direction: column; gap: 1.2rem; }
  .cat-others { display: flex; flex-direction: column; padding: 1.1rem 1.2rem 1.2rem; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); box-shadow: var(--ombre); }
  .cat-side .cat-intro__title { display: flex; align-items: center; gap: 0.5em; margin: 0 0 0.4rem; font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; line-height: 1.3; letter-spacing: -0.01em; color: var(--mine); }
  .cat-others__link { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.7rem; padding: 0.6rem 0; text-decoration: none; color: var(--mine); font-weight: 600; font-size: 0.95rem; line-height: 1.35; }
  .cat-others__link + .cat-others__link { border-top: 1px solid var(--filet); }
  .cat-others__link :global(svg:last-child) { width: 28px; height: 28px; padding: 7px; border-radius: 50%; border: 1px solid var(--filet); transition: transform 0.18s var(--ease-out), background-color 0.18s ease, border-color 0.18s ease; }
  .cat-others__link:hover :global(svg:last-child) { transform: translateX(3px); background: var(--jaune); border-color: var(--jaune); color: var(--sur-jaune); }
  @media (max-width: 960px) { .cat-grid { grid-template-columns: 1fr; } .cat-side { position: static; } }
  @media (max-width: 640px) { .grid2 { grid-template-columns: 1fr; } }
</style>
