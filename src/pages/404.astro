---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { categories } from '../categories';

const latest = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas ou a été déplacée." noindex>
  <section class="container not-found">
    <div class="not-found__head">
      <h1 class="not-found__title">Cette page n'existe pas (ou plus)</h1>
      <p class="not-found__code"><span class="not-found__num">404</span><span class="not-found__unit">hors plan</span></p>
    </div>
    <p class="not-found__lede">
      Le lien est peut-être cassé ou la page a été déplacée. Voici comment retrouver ton chemin :
    </p>

    <div class="not-found__categories">
      {categories.map((cat) => (
        <a class="chip not-found__cat" href={`/categorie/${cat.slug}/`}>
          <Icon name={cat.slug} size={16} /> {cat.label}
        </a>
      ))}
    </div>

    {latest.length > 0 && (
      <>
        <h2 class="not-found__h2">Derniers comparatifs</h2>
        <ul class="not-found__list">
          {latest.map((article) => (
            <li><a href={`/articles/${article.slug}/`}><span>{article.data.title}</span><Icon name="arrow" size={18} /></a></li>
          ))}
        </ul>
      </>
    )}

    <a class="btn btn--primary" href="/">Retour à l'accueil</a>
  </section>
</BaseLayout>

<style>
  .not-found { padding-top: 2.4rem; padding-bottom: 4.5rem; }
  /* Le code d'erreur en grand chiffre Unbounded, dans une carte papier à côté du titre */
  .not-found__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.2rem 2rem; }
  .not-found__title { margin: 0; max-width: 16ch; font-size: clamp(2.1rem, 1.2rem + 3vw, 3.4rem); }
  .not-found__code { flex-shrink: 0; margin: 0; display: flex; flex-direction: column; align-items: center; padding: 0.8rem 1.3rem; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); box-shadow: var(--ombre); }
  .not-found__num { font-family: var(--font-display); font-weight: 900; font-size: 2.8rem; line-height: 0.95; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .not-found__unit { margin-top: 0.3rem; font-size: 0.8rem; font-weight: 600; color: var(--gris); }
  .not-found__lede { margin: 1.2rem 0 2.2rem; max-width: 60ch; font-size: 1.1rem; line-height: 1.6; color: var(--gris); }
  .not-found__categories { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 2.2rem 0 0; }
  .not-found__cat { min-height: 40px; padding: 0.45em 0.95em; font-size: 0.9rem; }
  .not-found__h2 { margin: 3rem 0 0.9rem; font-size: clamp(1.5rem, 1.2rem + 1vw, 1.9rem); }
  /* Les derniers comparatifs : une carte papier, une ligne par article, flèche en pastille */
  .not-found__list { list-style: none; margin: 0 0 2.5rem; padding: 0 1.2rem; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); box-shadow: var(--ombre); }
  .not-found__list li + li { border-top: 1px solid var(--filet); }
  .not-found__list a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.9rem 0; font-weight: 600; line-height: 1.35; color: var(--mine); text-decoration: none; }
  .not-found__list a:hover span { text-decoration: underline; text-decoration-color: var(--jaune); text-decoration-thickness: 0.35em; text-underline-offset: -0.14em; text-decoration-skip-ink: none; }
  .not-found__list :global(svg) { flex-shrink: 0; width: 36px; height: 36px; padding: 9px; border-radius: 50%; border: 1px solid var(--filet); transition: transform 0.18s var(--ease-out), background-color 0.18s ease, border-color 0.18s ease; }
  .not-found__list a:hover :global(svg) { transform: translateX(4px); background: var(--jaune); border-color: var(--jaune); color: var(--sur-jaune); }
  @media (max-width: 560px) {
    .not-found__head { flex-direction: column; align-items: flex-start; }
    .not-found__code { flex-direction: row; align-items: baseline; gap: 0.6rem; padding: 0.6rem 1rem; }
    .not-found__num { font-size: 2.2rem; }
    .not-found__list { padding: 0 1rem; }
  }
</style>
