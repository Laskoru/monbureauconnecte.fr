---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { categories } from '../categories';

const latest = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas ou a été déplacée." noindex>
  <section class="container not-found">
    <div class="not-found__head">
      <h1 class="not-found__title">Cette page n'existe pas (ou plus)</h1>
      <p class="not-found__code"><span class="not-found__num">404</span><span class="not-found__unit">hors plan</span></p>
    </div>
    <p class="not-found__lede">
      Le lien est peut-être cassé ou la page a été déplacée. Voici comment retrouver ton chemin :
    </p>
    <span class="regle" aria-hidden="true"></span>

    <div class="not-found__categories">
      {categories.map((cat) => (
        <a class="chip not-found__cat" href={`/categorie/${cat.slug}/`}>
          <Icon name={cat.slug} size={16} /> {cat.label}
        </a>
      ))}
    </div>

    {latest.length > 0 && (
      <>
        <h2 class="not-found__h2">Derniers comparatifs</h2>
        <ul class="not-found__list">
          {latest.map((article) => (
            <li><a href={`/articles/${article.slug}/`}><span>{article.data.title}</span><Icon name="arrow" size={18} /></a></li>
          ))}
        </ul>
      </>
    )}

    <a class="btn btn--primary" href="/">Retour à l'accueil</a>
  </section>
</BaseLayout>

<style>
  .not-found { padding-top: 2.4rem; padding-bottom: 4.5rem; }
  /* Le code d'erreur coté comme un chiffre d'épure, à droite du titre */
  .not-found__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.2rem 2rem; }
  .not-found__title { margin: 0; max-width: 16ch; font-size: clamp(2.1rem, 1.2rem + 3vw, 3.4rem); }
  .not-found__code { flex-shrink: 0; margin: 0; display: flex; flex-direction: column; align-items: flex-end; padding-left: 1.2rem; border-left: 1px solid var(--mine); }
  .not-found__num { font-family: var(--font-display); font-stretch: 125%; font-weight: 300; font-size: 3.4rem; line-height: 0.9; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .not-found__unit { margin-top: 0.4rem; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--gris); }
  .not-found__lede { margin: 1.2rem 0 2.2rem; max-width: 60ch; font-size: 1.1rem; line-height: 1.6; color: var(--gris); }
  .not-found__categories { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 2.2rem 0 0; }
  .not-found__cat { min-height: 40px; padding: 0.45em 0.85em; font-size: 0.9rem; }
  .not-found__h2 { margin: 3rem 0 0.9rem; font-size: clamp(1.5rem, 1.2rem + 1vw, 1.9rem); }
  .not-found__list { list-style: none; margin: 0 0 2.5rem; padding: 0; border-top: 1.5px solid var(--mine); }
  .not-found__list li { border-bottom: 1px solid var(--filet); }
  .not-found__list a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.9rem 0.3rem; font-weight: 600; line-height: 1.35; color: var(--mine); text-decoration: none; transition: background-color 0.18s ease; }
  .not-found__list a:hover { background: var(--jaune-pale); }
  .not-found__list :global(svg) { flex-shrink: 0; transition: transform 0.18s var(--ease-out); }
  .not-found__list a:hover :global(svg) { transform: translateX(4px); }
  @media (max-width: 560px) {
    .not-found__head { flex-direction: column; align-items: flex-start; }
    .not-found__code { flex-direction: row; align-items: baseline; gap: 0.6rem; padding-left: 0.8rem; }
    .not-found__num { font-size: 2.2rem; }
  }
</style>
