---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../siteConfig';

// Outils gratuits — l'aimant à liens de Mon Bureau Connecté.
const tools = [
  { icon: 'ruler', title: 'Calculateur de hauteur de bureau', desc: 'Trouve la hauteur idéale de ton bureau — assis et assis-debout —, de ton siège et de ton écran selon ta taille, en un instant.', href: '/calculateur-hauteur-bureau/', cta: 'Ouvrir le calculateur' },
  { icon: 'posture', title: 'Le poste de travail idéal', desc: "Le schéma coté des bons réglages : hauteur d'écran, angle des coudes, soutien du dos, pieds à plat — tout en un coup d'œil.", href: '/poste-de-travail-ideal/', cta: 'Voir le schéma' },
  { icon: 'checklist', title: 'Checklist ergonomie du poste', desc: 'Règle ton poste comme il faut : écran, siège, clavier, souris, lumière et pauses. La checklist complète, cochable et mémorisée.', href: '/checklist-bureau-ergonomique/', cta: 'Voir la checklist' },
  { icon: 'cpu', title: 'Guide PC gaming pièce par pièce', desc: '4 configurations complètes selon ton budget, du premier PC au haut de gamme, avec les critères de chaque composant.', href: '/guide-pc-gaming/', cta: 'Composer mon PC' },
  { icon: 'book', title: 'Lexique du bureau', desc: 'VESA, DPI, ANC, Power Delivery, switchs… les termes techniques expliqués simplement, avec le comparatif qui va avec.', href: '/lexique/', cta: 'Consulter le lexique' },
  { icon: 'map', title: 'Guides par besoin', desc: 'Un parcours pour chaque problème : télétravail, setup gaming, mal de dos, poignets, petit bureau. On te dit quoi lire, dans quel ordre.', href: '/guides/', cta: 'Choisir mon parcours' },
];
---

<BaseLayout title="Outils gratuits" description={`Des outils gratuits pour équiper et régler ton poste de travail : calculateur de hauteur de bureau, schéma du poste idéal, checklist ergonomie, guide de montage PC, lexique. ${siteConfig.name}.`}>
  <PageHead
    eyebrow="100 % gratuit · sans inscription"
    title="Outils gratuits"
    lede="Des outils pratiques pour aménager ton poste sans te tromper — calculs, réglages et montage. Utilise-les autant que tu veux, et partage-les si ça peut aider quelqu'un."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Outils gratuits' }]}
  />

  <section class="wide tools">
    <div class="tools__grid">
      {tools.map((t) => (
        <article class="tool">
          <h2 class="tool__title"><Icon name={t.icon} size={22} /><a class="stretched-link" href={t.href}>{t.title}</a></h2>
          <p class="tool__desc">{t.desc}</p>
          <span class="tool__cta">{t.cta} <Icon name="arrow" size={16} /></span>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .tools { padding-top: 2.6rem; padding-bottom: 4.5rem; }
  /* Une bande réglée découpée en cases à filets, comme sur l'accueil */
  .tools__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1.5px solid var(--mine); }
  .tool { position: relative; display: flex; flex-direction: column; gap: 0.6rem; padding: 1.4rem 1.3rem 1.5rem; border-bottom: 1px solid var(--filet); transition: background-color 0.18s ease; }
  .tool:not(:nth-child(3n + 1)) { border-left: 1px solid var(--filet); }
  .tool:hover, .tool:focus-within { background: var(--papier); }
  .tool__title { display: flex; align-items: flex-start; gap: 0.6rem; margin: 0; font-family: var(--font-body); font-stretch: 100%; font-weight: 600; font-size: 1.15rem; line-height: 1.3; letter-spacing: -0.005em; }
  .tool__title :global(svg) { flex-shrink: 0; margin-top: 0.02rem; }
  .tool__title a { color: var(--mine); text-decoration: none; }
  .tool__desc { flex: 1; margin: 0; font-size: 0.95rem; line-height: 1.55; color: var(--gris); }
  .tool__cta { display: inline-flex; align-items: center; gap: 0.4em; margin-top: 0.3rem; font-weight: 600; font-size: 0.92rem; color: var(--mine); }
  .tool__cta :global(svg) { transition: transform 0.18s var(--ease-out); }
  .tool:hover .tool__cta :global(svg) { transform: translateX(4px); }
  @media (max-width: 900px) {
    .tools__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tool:not(:nth-child(3n + 1)) { border-left: 0; }
    .tool:nth-child(even) { border-left: 1px solid var(--filet); }
  }
  @media (max-width: 600px) {
    .tools__grid { grid-template-columns: 1fr; }
    .tool:nth-child(even) { border-left: 0; }
  }
</style>
