---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../siteConfig';
import { categories } from '../categories';
import { resolveProductImages } from '../lib/products';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const latest = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 10);

const dateFormatter = new Intl.DateTimeFormat(siteConfig.locale.replace('_', '-'), {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

function readingTime(body: string) {
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.round(words / 200));
}

const categoryCounts = categories.map((cat) => ({
  ...cat,
  count: allArticles.filter((a) => a.data.category === cat.slug).length,
}));

const stats = [
  { value: String(allArticles.length), label: 'Comparatifs publiés' },
  { value: String(categories.length), label: 'Catégories couvertes' },
  { value: '100%', label: 'Rédaction indépendante' },
];
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="hero">
    <div class="wide hero__inner">
      <p class="hero__badge">🏆 Comparatifs indépendants pour ton poste de travail</p>
      <h1>{siteConfig.tagline}</h1>
      <p class="hero__lede">{siteConfig.description}</p>
      <div class="hero__actions">
        {latest.length > 0 && (
          <a class="btn btn--light" href={`/articles/${latest[0].slug}`}>Lire le dernier comparatif</a>
        )}
        <a class="btn btn--ghost" href="/articles">Voir tous les articles</a>
      </div>

      <div class="hero__stats">
        {stats.map((stat) => (
          <div class="hero__stat">
            <p class="hero__stat-value">{stat.value}</p>
            <p class="hero__stat-label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="wide categories">
    <h2 class="categories__title">Trouve ce qu'il te faut</h2>
    <p class="categories__lede">Nos guides sont classés par ce que tu es en train d'équiper.</p>
    <div class="categories__grid">
      {categoryCounts.map((cat) => (
        <a class="categories__item card card--hover" href={`/categorie/${cat.slug}`}>
          <span class="categories__icon">{cat.icon}</span>
          <p class="categories__label">{cat.label}</p>
          <p class="categories__count">{cat.count} article{cat.count > 1 ? 's' : ''}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="container intro">
    <h2>Notre approche</h2>
    <p>
      Choisir un accessoire de bureau, ce n'est pas se ruiner sur le premier modèle à la mode. Que ce soit pour
      un setup gaming, un poste de télétravail au quotidien ou simplement un bureau plus confortable, chaque
      article part d'un usage concret et compare des critères mesurables — charge admise, plage de réglage,
      niveau sonore, autonomie — plutôt que des impressions vagues.
    </p>
    <p>
      On évite le jargon marketing et les classements gonflés artificiellement : chaque produit recommandé est
      vraiment testé et comparé avant d'atterrir dans un article, avec ses compromis assumés. Les accessoires
      bureau, gaming et télétravail évoluent vite, alors les comparatifs déjà publiés sont revus régulièrement
      pour vérifier que les modèles conseillés restent pertinents et que les prix collent encore au marché.
    </p>
  </section>

  <section class="container article-list">
    <h2 class="article-list__title">Derniers articles</h2>
    {latest.length === 0 && <p>Aucun article publié pour le moment.</p>}
    {latest.map((article) => {
      const thumbs = resolveProductImages(article.data.products, 2);
      return (
        <article class="article-card card card--hover">
          <div class="article-card__body">
            <p class="eyebrow">{dateFormatter.format(article.data.pubDate)} · {readingTime(article.body)} min de lecture</p>
            <h3><a class="stretched-link" href={`/articles/${article.slug}`}>{article.data.title}</a></h3>
            <p class="article-card__desc">{article.data.description}</p>
          </div>
          {thumbs.length > 0 && (
            <div class="article-card__thumbs">
              {thumbs.map((src) => (
                <img class="article-card__thumb" src={src} alt="" loading="lazy" onerror="this.remove()" />
              ))}
            </div>
          )}
        </article>
      );
    })}
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--gradient-hero);
    color: #fff;
    overflow: hidden;
  }
  .hero__inner { padding: 3.6rem 1.25rem 3rem; text-align: center; }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.28);
    padding: 0.5em 1.1em;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0 0 1.4rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    line-height: 1.1;
    margin: 0 auto 1.1rem;
    max-width: 20ch;
    text-wrap: balance;
  }
  .hero__lede {
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    max-width: 60ch;
    margin: 0 auto 1.9rem;
  }
  .hero__actions { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem; }
  .btn--ghost {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }
  .btn--ghost:hover { background: rgba(255, 255, 255, 0.18); }

  .hero__stats {
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    flex-wrap: wrap;
  }
  .hero__stat-value {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
  }
  .hero__stat-label {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.82);
    margin: 0.2rem 0 0;
  }

  .intro { padding: 3.6rem 1.25rem 0.5rem; }
  .intro h2 { margin-top: 0; }
  .intro p { color: var(--color-text-muted); line-height: 1.7; }

  .categories { padding: 3.4rem 1.25rem 1rem; }
  .categories__title { margin: 0 0 0.4rem; }
  .categories__lede { color: var(--color-text-muted); margin: 0 0 1.8rem; }
  .categories__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .categories__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: inherit;
    padding: 1.8rem 1.2rem;
  }
  .categories__icon { font-size: 2.1rem; margin-bottom: 0.6rem; }
  .categories__label { font-weight: 700; margin: 0 0 0.25rem; }
  .categories__count { font-size: 0.82rem; color: var(--color-text-faint); margin: 0; }

  .article-list { display: flex; flex-direction: column; gap: 1.1rem; padding: 2.8rem 1.25rem 3.5rem; }
  .article-list__title { margin-top: 0; }
  .article-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.4rem 1.5rem;
  }
  .article-card__body { flex: 1; min-width: 0; }
  .article-card h3 {
    margin: 0.35rem 0 0.4rem;
    font-size: 1.3rem;
  }
  .article-card h3 a { color: var(--color-text); text-decoration: none; }
  .article-card:hover h3 a { color: var(--color-accent); }
  .article-card__desc { color: var(--color-text-muted); margin: 0; }

  /* Miniatures produits, côte à côte à droite du titre */
  .article-card__thumbs {
    display: flex;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .article-card__thumb {
    width: 84px;
    height: 84px;
    object-fit: contain;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 4px;
  }
  @media (max-width: 560px) {
    .article-card { flex-direction: column; align-items: flex-start; }
    .article-card__thumbs { order: -1; }
    .article-card__thumb { width: 72px; height: 72px; }
  }

  @media (max-width: 680px) {
    .categories__grid { grid-template-columns: 1fr; }
  }
</style>
