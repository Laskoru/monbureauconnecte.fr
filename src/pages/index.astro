  .hero .btn--outline:hover { background: rgba(255,255,255,0.12); border-color: #fff; }
  .hero__stats { border-top-color: rgba(255,255,255,0.22); }
  .hero__stat-value { color: #fff; }
  .hero__stat-label { color: rgba(255,255,255,0.75); }
</style>

<script>
  // Compteurs animés du hero
  document.querySelectorAll('.hero__stat-value').forEach((el) => {
    const raw = el.textContent || ''; const m = raw.match(/\d+/); if (!m) return;
    const end = +m[0], post = raw.slice(m.index + m[0].length); let cur = 0;
    const step = Math.max(1, Math.ceil(end / 26));
    const t = setInterval(() => { cur += step; if (cur >= end) { cur = end; clearInterval(t); } el.textContent = cur + post; }, 26);
  });
</script>
