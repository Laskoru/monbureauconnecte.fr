---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { coverSrcSet } from '../lib/covers';
import ArticleCard from '../components/ArticleCard.astro';
import GearFinder from '../components/GearFinder.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../siteConfig';
import { categories } from '../categories';
import { guides } from '../guides';
import { budgets } from '../budgets';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const sorted = [...allArticles].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const bySlug = new Map(allArticles.map((a) => [a.slug, a]));
const published = new Set(allArticles.map((a) => a.slug));

// Comparatifs de référence : 1 grand + 3 compacts, un par grand besoin
const featuredSlugs = ['bureau-assis-debout-electrique', 'meilleures-chaises-gaming', 'souris-ergonomique-verticale', 'casque-reduction-bruit-teletravail'];
const featured = featuredSlugs.map((s) => bySlug.get(s)).filter(Boolean);
const [lead, ...side] = featured;
const latest = sorted.filter((a) => !featuredSlugs.includes(a.slug)).slice(0, 6);

// Navigation par problème : nos guides-hubs
const needCounts = guides.map((g) => ({ ...g, count: g.articles.filter((slug) => published.has(slug)).length }));
// Navigation par budget
const budgetCounts = budgets.map((b) => ({ ...b, count: b.articles.filter((slug) => published.has(slug)).length }));
const categoryCounts = categories.map((cat) => ({ ...cat, count: allArticles.filter((a) => a.data.category === cat.slug).length }));

const promises = [
  { icon: 'shield', label: '100 % indépendant', note: 'aucun placement payé' },
  { icon: 'ruler', label: 'Critères mesurables', note: 'plage de réglage, charge, dB, autonomie' },
  { icon: 'refresh', label: 'Mis à jour en 2026', note: 'modèles et prix revus' },
  { icon: 'tag', label: 'Affiliation transparente', note: 'sans surcoût pour toi' },
];

const tools = [
  { icon: 'posture', title: 'Le poste de travail idéal', desc: 'Le schéma coté des 7 repères : écran, coudes, dos, pieds.', href: '/poste-de-travail-ideal/', cta: 'Voir le schéma' },
  { icon: 'ruler', title: 'Calculateur de hauteur de bureau', desc: 'Bureau assis et debout, siège et écran calculés selon ta taille.', href: '/calculateur-hauteur-bureau/', cta: 'Calculer' },
  { icon: 'checklist', title: 'Checklist ergonomie', desc: 'Le tour complet pour vérifier que ton poste est bien réglé.', href: '/checklist-bureau-ergonomique/', cta: 'Vérifier' },
  { icon: 'cpu', title: 'Guide PC gaming pièce par pièce', desc: '4 configurations complètes selon ton budget, du premier PC au haut de gamme.', href: '/guide-pc-gaming/', cta: 'Découvrir' },
  { icon: 'book', title: 'Lexique du bureau', desc: 'VESA, DPI, ANC, Power Delivery, switchs : les termes expliqués simplement.', href: '/lexique/', cta: 'Consulter' },
];

// FAQ générale du site (aussi bonne pour le SEO)
const faqs = [
  { q: 'Vos comparatifs sont-ils sponsorisés ?', a: "Non. Aucune marque ne paie pour figurer ou être mieux classée. On se rémunère uniquement via les liens affiliés : si tu achètes après avoir cliqué, on touche une petite commission, sans surcoût pour toi. Ça ne change ni nos choix, ni nos critiques." },
  { q: 'Comment choisissez-vous les produits recommandés ?', a: "On part toujours d'un usage concret (mal de dos, petit bureau, visio…) et on compare des critères vérifiables : plage de réglage, charge admise, niveau sonore, autonomie. On assume les compromis de chaque modèle plutôt que de gonfler un classement." },
  { q: 'À quelle fréquence les articles sont-ils mis à jour ?', a: "Régulièrement. Les modèles conseillés et les prix évoluent vite : on révise les comparatifs pour qu'ils restent d'actualité, et la date de dernière mise à jour est indiquée en haut de chaque article." },
  { q: "C'est quoi, un « lien affilié Amazon » ?", a: "C'est un lien qui indique à Amazon que tu viens de chez nous. Si tu achètes, Amazon nous reverse une petite commission — le prix reste exactement le même pour toi. C'est ce qui finance le site et nous permet de rester indépendants." },
  { q: 'Pourquoi des liens de recherche plutôt qu’un produit précis ?', a: "Parce qu'un modèle précis peut être en rupture ou changer de prix du jour au lendemain. Un lien vers une recherche Amazon t'amène aux modèles disponibles aujourd'hui, correspondant au type de produit qu'on recommande — plus fiable dans le temps." },
];
---

<BaseLayout title="Mon Bureau Connecté — bureau, gaming & télétravail" description={siteConfig.description}>
  <!-- ═══════ HERO : photo + fiche de réglage ═══════ -->
  <section class="hero">
    <img class="hero__bg" src="/covers/bureau-assis-debout-electrique.webp" srcset={coverSrcSet('/covers/bureau-assis-debout-electrique.webp')} sizes="100vw" width="1600" height="900" fetchpriority="high" decoding="async" alt="Poste de travail avec bureau assis-debout, écran sur bras et fauteuil ergonomique" />
    <div class="wide hero__grid">
      <div class="hero__text">
        <p class="hero__eyebrow"><span class="hero__tick" aria-hidden="true"></span> Bureau · Gaming · Télétravail</p>
        <h1 class="hero__title">Un poste de travail réglé <span class="hero__hl">au millimètre.</span></h1>
        <p class="hero__lede">Comparatifs indépendants et outils gratuits pour choisir chaise, bureau, périphériques et casque sur des critères mesurables — pas sur le marketing.</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href="/guides/"><Icon name="sliders" size={18} /> Trouver par problème</a>
          <a class="btn btn--ghost-night" href="/articles/">Tous les comparatifs</a>
        </div>
        <p class="hero__data" aria-label="Le site en chiffres"><span><b>{allArticles.length}</b> comparatifs</span><span><b>{guides.length}</b> problèmes couverts</span><span><b>0</b> placement payé</span></p>
      </div>

      <aside class="fr" aria-label="Fiche de réglage : la hauteur de ton bureau selon ta taille">
        <p class="fr__title"><Icon name="ruler" size={16} /> Fiche de réglage</p>
        <label class="fr__field" for="fr-taille">
          <span class="fr__label">Ta taille</span>
          <span class="fr__val"><output id="fr-out" for="fr-taille">175</output> cm</span>
        </label>
        <input class="fr__range" type="range" id="fr-taille" min="140" max="210" value="175" step="1" aria-label="Ta taille en centimètres" />
        <dl class="fr__specs">
          <div><dt>Plateau assis</dt><dd><b data-fr="0.42">74</b> cm</dd></div>
          <div><dt>Plateau debout</dt><dd><b data-fr="0.62">109</b> cm</dd></div>
          <div><dt>Assise du siège</dt><dd><b data-fr="0.25">44</b> cm</dd></div>
          <div><dt>Haut de l'écran</dt><dd><b data-fr="0.70">123</b> cm</dd></div>
        </dl>
        <p class="fr__verdict" id="fr-verdict">Un bureau standard (74 cm) est à ta hauteur.</p>
        <a class="fr__more" href="/calculateur-hauteur-bureau/">Le détail, le schéma et quoi corriger <Icon name="arrow" size={14} /></a>
      </aside>
    </div>
  </section>

  <!-- ═══════ PROMESSES ═══════ -->
  <div class="promises">
    <ul class="wide promises__list">
      {promises.map((p) => (
        <li><Icon name={p.icon} size={20} /><span><strong>{p.label}</strong><small>{p.note}</small></span></li>
      ))}
    </ul>
  </div>

  <!-- ═══════ PAR PROBLÈME ═══════ -->
  <section class="section section--soft blueprint" id="besoins">
    <div class="wide">
      <div class="section__head">
        <div><p class="eyebrow section__eyebrow">Navigation par besoin</p><h2 class="section__title">Quel est ton problème ?</h2></div>
        <a class="section__link" href="/guides/">Tous les guides <Icon name="arrow" size={16} /></a>
      </div>
      <p class="section__lede">Nos comparatifs sont rangés par situation réelle. Choisis la tienne : on t'emmène droit aux produits qui la règlent, dans l'ordre.</p>
      <div class="needs reveal">
        {needCounts.map((n) => (
          <a class="need card card--hover" href={`/guides/${n.slug}/`}>
            <span class="need__icon"><Icon name={n.slug} size={22} /></span>
            <span class="need__body">
              <span class="need__title">{n.title}</span>
              <span class="need__count">{n.count} comparatif{n.count > 1 ? 's' : ''}</span>
            </span>
            <Icon name="arrow" size={18} class="need__arrow" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ PAR BUDGET ═══════ -->
  <section class="section">
    <div class="wide">
      <div class="section__head">
        <div><p class="eyebrow section__eyebrow">Par budget</p><h2 class="section__title">Combien veux-tu y mettre ?</h2></div>
        <a class="section__link" href="/budget/">Choisir par budget <Icon name="arrow" size={16} /></a>
      </div>
      <p class="section__lede">Chaque enveloppe a ses bons choix. Du geste gratuit à l'investissement qui dure.</p>
      <div class="budgets reveal">
        {budgetCounts.map((b) => (
          <a class="budget card card--hover" href={`/budget/${b.slug}/`}>
            <span class="budget__top"><span class="budget__icon"><Icon name={b.slug} size={22} /></span><span class="spec budget__range"><b>{b.range}</b></span></span>
            <span class="budget__label">{b.label}</span>
            <span class="budget__desc">{b.tagline}</span>
            <span class="budget__count">{b.count} comparatif{b.count > 1 ? 's' : ''} <Icon name="arrow" size={14} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ INCONTOURNABLES ═══════ -->
  {lead && (
    <section class="section section--soft">
      <div class="wide">
        <div class="section__head">
          <div><p class="eyebrow section__eyebrow">La sélection de la rédaction</p><h2 class="section__title">Les comparatifs de référence</h2></div>
          <a class="section__link" href="/articles/">Tous les comparatifs <Icon name="arrow" size={16} /></a>
        </div>
        <div class="una reveal">
          <div class="una__lead"><ArticleCard article={lead} variant="feature" eager /></div>
          <div class="una__side">{side.map((a) => <ArticleCard article={a} variant="row" />)}</div>
        </div>
      </div>
    </section>
  )}

  <GearFinder />

  <!-- ═══════ CATÉGORIES ═══════ -->
  <section class="section" id="categories">
    <div class="wide">
      <p class="eyebrow section__eyebrow">Par type de matériel</p>
      <h2 class="section__title">Ou va droit au rayon</h2>
      <p class="section__lede">Tu sais déjà ce que tu cherches ? Mobilier, périphériques, audio & visio, PC gaming.</p>
      <div class="cats reveal">
        {categoryCounts.map((cat) => (
          <a class="cat card card--hover" href={`/categorie/${cat.slug}/`}>
            <span class="cat__icon"><Icon name={cat.slug} size={24} /></span>
            <span class="cat__label">{cat.label}</span>
            <span class="cat__desc">{cat.description}</span>
            <span class="cat__count">{cat.count} comparatif{cat.count > 1 ? 's' : ''} <Icon name="arrow" size={14} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ DERNIERS COMPARATIFS ═══════ -->
  {latest.length > 0 && (
    <section class="section section--soft">
      <div class="wide">
        <div class="section__head">
          <div><p class="eyebrow section__eyebrow">Fraîchement publiés</p><h2 class="section__title">Les derniers comparatifs</h2></div>
          <a class="section__link" href="/articles/">Voir tout <Icon name="arrow" size={16} /></a>
        </div>
        <div class="grid3 reveal">{latest.map((a) => <ArticleCard article={a} />)}</div>
      </div>
    </section>
  )}

  <!-- ═══════ OUTILS ═══════ -->
  <section class="section blueprint" id="outils">
    <div class="wide">
      <div class="section__head">
        <div><p class="eyebrow section__eyebrow">Outils gratuits</p><h2 class="section__title">Règle ton poste avant d'acheter</h2></div>
        <a class="section__link" href="/outils/">Tous les outils <Icon name="arrow" size={16} /></a>
      </div>
      <p class="section__lede">Souvent, le premier gain ne coûte rien : un écran à la bonne hauteur, un siège bien réglé. Nos outils te donnent les cotes.</p>
      <div class="tools reveal">
        {tools.map((t) => (
          <a class="tool card card--hover" href={t.href}>
            <span class="tool__icon"><Icon name={t.icon} size={22} /></span>
            <span class="tool__title">{t.title}</span>
            <span class="tool__desc">{t.desc}</span>
            <span class="tool__cta">{t.cta} <Icon name="arrow" size={14} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ MÉTHODE ═══════ -->
  <section class="section section--soft">
    <div class="wide method reveal">
      <div class="method__text">
        <p class="eyebrow section__eyebrow">Notre méthode</p>
        <h2 class="section__title">Des critères qu'on peut mesurer, pas des impressions</h2>
        <p>Chaque comparatif part d'un usage concret — setup gaming, télétravail, dos fragile — et compare ce qui se vérifie : <strong>plage de réglage, charge admise, niveau sonore, autonomie, compatibilité</strong>. Pas de classement gonflé, pas de « meilleur » universel qui n'existe pas.</p>
        <p>Le site est <strong>100 % indépendant</strong> : aucune marque ne paie pour figurer. On se finance par l'affiliation, et on l'indique toujours.</p>
        <a class="btn btn--outline" href="/a-propos/">Notre méthode en détail</a>
      </div>
      <dl class="method__specs">
        <div><dt>Critères</dt><dd>Mesurables et vérifiables</dd></div>
        <div><dt>Marques</dt><dd>Aucune sponsorisée</dd></div>
        <div><dt>Avis affichés</dt><dd>Vraies notes Amazon, jamais retouchées</dd></div>
        <div><dt>Révision</dt><dd>Comparatifs relus dans le temps</dd></div>
        <div><dt>Affiliation</dt><dd>Transparente, sans surcoût</dd></div>
      </dl>
    </div>
  </section>

  <!-- ═══════ FAQ ═══════ -->
  <section class="section" id="faq">
    <div class="wide faq">
      <p class="eyebrow section__eyebrow">FAQ</p>
      <h2 class="section__title">Les questions qu'on nous pose</h2>
      <p class="section__lede">Transparence totale sur notre fonctionnement et notre indépendance.</p>
      <div class="faq__list reveal">
        {faqs.map((item, i) => (
          <details class="faq__item" open={i === 0}>
            <summary class="faq__q"><span class="faq__idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span>{item.q}</span><span class="faq__chevron" aria-hidden="true"></span></summary>
            <p class="faq__a">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) })} />
</BaseLayout>

<script is:inline>
  (function () {
    // Fiche de réglage du hero : mêmes ratios que le calculateur (points de départ à ajuster)
    var r = document.getElementById('fr-taille'), o = document.getElementById('fr-out'), v = document.getElementById('fr-verdict');
    if (!r) return;
    var outs = document.querySelectorAll('[data-fr]');
    function update() {
      var t = Number(r.value); o.textContent = t;
      outs.forEach(function (el) { el.textContent = Math.round(t * Number(el.getAttribute('data-fr'))); });
      var assis = Math.round(t * 0.42), d = assis - 74;
      v.textContent = Math.abs(d) <= 2 ? 'Un bureau standard (74 cm) est à ta hauteur.' : d < 0 ? 'Un bureau standard (74 cm) est ' + Math.abs(d) + ' cm trop haut pour toi : pense au repose-pieds ou au bureau réglable.' : 'Un bureau standard (74 cm) est ' + d + ' cm trop bas pour toi : un bureau réglable règle ça.';
    }
    r.addEventListener('input', update); update();
  })();
</script>

<style>
  /* ═══ HERO ═══ */
  .hero { position: relative; isolation: isolate; overflow: hidden; background: var(--color-night); color: var(--color-on-night); }
  .hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; z-index: -2; transform-origin: 60% 50%; animation: hero-zoom 34s ease-in-out infinite alternate; will-change: transform; }
  @keyframes hero-zoom { from { transform: scale(1); } to { transform: scale(1.06); } }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(11,21,48,.95) 0%, rgba(11,21,48,.8) 40%, rgba(11,21,48,.4) 72%, rgba(11,21,48,.55) 100%), linear-gradient(0deg, rgba(11,21,48,.92) 0%, rgba(11,21,48,0) 45%); }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background-image: var(--grid-dark); background-size: 96px 96px; opacity: .5; -webkit-mask-image: linear-gradient(90deg, #000 0%, transparent 60%); mask-image: linear-gradient(90deg, #000 0%, transparent 60%); pointer-events: none; }
  .hero__grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, 400px); gap: 3rem; align-items: center; padding-top: clamp(2.5rem, 6vh, 4.5rem); padding-bottom: clamp(2.5rem, 6vh, 4rem); min-height: min(640px, calc(100vh - 68px)); }
  .hero__eyebrow { display: inline-flex; align-items: center; gap: .6em; margin: 0 0 1rem; font-family: var(--font-mono); font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; color: var(--color-signal); }
  .hero__tick { width: 14px; height: 2px; background: var(--color-signal); }
  .hero__title { font-size: clamp(2.5rem, 5vw, 4.4rem); line-height: 1; margin: 0 0 1.1rem; color: #fff; font-weight: 800; font-stretch: 112%; letter-spacing: -.03em; text-shadow: 0 2px 30px rgba(0,0,0,.35); max-width: 15ch; }
  .hero__hl { color: var(--color-signal); }
  .hero__lede { font-size: clamp(1.05rem, 1.6vw, 1.18rem); color: #d9e0ee; max-width: 52ch; margin: 0 0 1.8rem; line-height: 1.55; }
  .hero__cta { display: flex; gap: .8rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .hero__data { display: flex; gap: 1.6rem; flex-wrap: wrap; margin: 0; padding-top: 1.2rem; border-top: 1px solid rgba(255,255,255,.18); font-family: var(--font-mono); font-size: .74rem; letter-spacing: .06em; text-transform: uppercase; color: var(--color-on-night-muted); }
  .hero__data b { font-family: var(--font-display); font-weight: 800; font-stretch: 110%; font-size: 1.5rem; color: #fff; margin-right: .3em; }
  @media (min-width: 900px) and (max-height: 760px) {
    .hero__grid { padding-top: 2rem; padding-bottom: 2rem; gap: 2rem; }
    .hero__title { font-size: clamp(2.3rem, 4.2vw, 3.6rem); margin-bottom: .8rem; }
    .hero__lede { font-size: 1.02rem; margin-bottom: 1.2rem; }
    .hero__cta { margin-bottom: 1.2rem; }
    .hero__data { padding-top: .9rem; }
    .hero__data b { font-size: 1.25rem; }
    .fr { padding: 1rem 1.1rem .9rem; }
    .fr__specs { gap: .5rem .8rem; }
  }

  /* Fiche de réglage (carte du hero) : papier millimétré, repères de coin */
  .fr { position: relative; background: var(--color-surface); background-image: var(--grid-light); background-size: 96px 96px; color: var(--color-text); border-radius: var(--radius-lg); padding: 1.25rem 1.3rem 1.1rem; box-shadow: var(--shadow-lg); border-top: 4px solid var(--color-signal); }
  .fr::before, .fr::after { content: ''; position: absolute; width: 10px; height: 10px; border: 2px solid var(--color-accent); pointer-events: none; }
  .fr::before { left: 8px; bottom: 8px; border-top: 0; border-right: 0; }
  .fr::after { right: 8px; bottom: 8px; border-top: 0; border-left: 0; }
  .fr__title { margin: 0 0 .9rem; display: flex; align-items: center; gap: .5em; font-family: var(--font-mono); font-weight: 500; font-size: .74rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-accent-text); }
  .fr__field { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: .4rem; }
  .fr__label { font-weight: 600; font-size: .95rem; }
  .fr__val { font-family: var(--font-mono); font-size: .9rem; color: var(--color-text-muted); }
  .fr__val output { font-family: var(--font-display); font-weight: 800; font-stretch: 110%; font-size: 1.6rem; color: var(--color-text); font-variant-numeric: tabular-nums; }
  .fr__range { width: 100%; accent-color: var(--color-accent); margin: 0 0 1rem; height: 28px; cursor: pointer; }
  .fr__specs { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem .9rem; margin: 0 0 .9rem; padding-top: .9rem; border-top: 1px dashed var(--color-border-strong); }
  .fr__specs div { display: flex; flex-direction: column; gap: .1rem; }
  .fr__specs dt { font-family: var(--font-mono); font-size: .66rem; letter-spacing: .08em; text-transform: uppercase; color: var(--color-text-muted); }
  .fr__specs dd { margin: 0; font-size: .95rem; color: var(--color-text-muted); }
  .fr__specs dd b { font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; color: var(--color-text); font-variant-numeric: tabular-nums; margin-right: .15em; }
  .fr__verdict { margin: 0 0 .8rem; font-size: .86rem; line-height: 1.45; color: var(--color-text-muted); padding: .55rem .7rem; background: var(--color-signal-soft); border-left: 3px solid var(--color-signal); }
  .fr__more { display: inline-flex; align-items: center; gap: .35em; color: var(--color-accent-text); text-decoration: none; font-weight: 700; font-size: .88rem; min-height: 28px; }
  .fr__more:hover { text-decoration: underline; }

  /* ═══ PROMESSES ═══ */
  .promises { background: var(--color-night-2); color: var(--color-on-night); border-bottom: 1px solid var(--color-night-border); }
  .promises__list { list-style: none; margin: 0 auto; padding-top: .9rem; padding-bottom: .9rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .promises__list li { display: flex; align-items: center; gap: .75rem; color: var(--color-signal); }
  .promises__list span { display: flex; flex-direction: column; line-height: 1.2; color: #fff; }
  .promises__list strong { font-size: .9rem; }
  .promises__list small { font-size: .76rem; color: var(--color-on-night-muted); }

  /* ═══ PAR PROBLÈME ═══ */
  .needs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
