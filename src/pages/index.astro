---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import GearFinder from '../components/GearFinder.astro';
import { siteConfig } from '../siteConfig';
import { categories } from '../categories';
import { guides } from '../guides';
import { budgets } from '../budgets';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const latest = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 6);

const bySlug = new Map(allArticles.map((a) => [a.slug, a]));
const published = new Set(allArticles.map((a) => a.slug));

// Navigation "par besoin" : nos guides-hubs, chacun répond à un problème concret.
const needCounts = guides.map((g) => ({
  ...g,
  count: g.articles.filter((slug) => published.has(slug)).length,
}));

// Navigation "par budget"
const budgetCounts = budgets.map((b) => ({
  ...b,
  count: b.articles.filter((slug) => published.has(slug)).length,
}));

// Barre de confiance — des signaux honnêtes, rien d'inventé.
const trust = [
  { icon: '🎯', label: '100% indépendant', note: 'aucun placement payé' },
  { icon: '🔄', label: 'Mis à jour en 2026', note: 'modèles et prix revus' },
  { icon: '📐', label: 'Critères mesurables', note: 'pas d’impressions vagues' },
  { icon: '🤝', label: 'Affiliation transparente', note: 'on l’indique toujours' },
];

// FAQ générale du site (aussi bon pour le SEO)
const faqs = [
  {
    q: 'Vos comparatifs sont-ils sponsorisés ?',
    a: "Non. Aucune marque ne paie pour figurer ou être mieux classée. On se rémunère uniquement via les liens affiliés : si tu achètes après avoir cliqué, on touche une petite commission, sans surcoût pour toi. Ça ne change ni nos choix, ni nos critiques.",
  },
  {
    q: 'Comment choisissez-vous les produits recommandés ?',
    a: "On part toujours d'un usage concret (mal de dos, petit bureau, visio…) et on compare des critères vérifiables : plage de réglage, charge admise, niveau sonore, autonomie. On assume les compromis de chaque modèle plutôt que de gonfler un classement.",
  },
  {
    q: 'À quelle fréquence les articles sont-ils mis à jour ?',
    a: "Régulièrement. Les modèles conseillés et les prix évoluent vite : on révise les comparatifs pour qu'ils restent d'actualité, et la date de dernière mise à jour est indiquée en haut de chaque article.",
  },
  {
    q: "C'est quoi, un « lien affilié Amazon » ?",
    a: "C'est un lien qui indique à Amazon que tu viens de chez nous. Si tu achètes, Amazon nous reverse une petite commission — le prix reste exactement le même pour toi. C'est ce qui finance le site et nous permet de rester indépendants.",
  },
  {
    q: 'Pourquoi des liens de recherche plutôt qu’un produit précis ?',
    a: "Parce qu'un modèle précis peut être en rupture ou changer de prix du jour au lendemain. Un lien vers une recherche Amazon t'amène aux modèles disponibles aujourd'hui, correspondant au type de produit qu'on recommande — plus fiable dans le temps.",
  },
];

// Comparatifs de référence : nos guides d'achat phares, un par grand besoin.
const featuredSlugs = [
  'bureau-assis-debout-electrique',
  'meilleures-chaises-gaming',
  'souris-ergonomique-verticale',
  'casque-reduction-bruit-teletravail',
];
const featured = featuredSlugs.map((s) => bySlug.get(s)).filter(Boolean);

const categoryCounts = categories.map((cat) => ({
  ...cat,
  count: allArticles.filter((a) => a.data.category === cat.slug).length,
}));

const stats = [
  { value: String(allArticles.length), label: 'Comparatifs publiés' },
  { value: String(guides.length), label: 'Besoins couverts' },
  { value: '100%', label: 'Rédaction indépendante' },
];
---

<BaseLayout title="Mon Bureau Connecté — bureau, gaming & télétravail" description={siteConfig.description}>
  <section class="hero">
    <img class="hero__bg" src="/covers/bureau-assis-debout-electrique.webp" alt="" width="1600" height="900" fetchpriority="high" />
    <div class="hero__scrim"></div>
    <div class="wide hero__inner">
      <p class="hero__badge"><span class="hero__badge-dot"></span> Comparatifs indépendants · bureau · gaming · télétravail</p>
      <h1 class="hero__title">Le matériel qui transforme ton <span class="hero__hl">bureau</span> en poste de pro.</h1>
      <p class="hero__lede">{siteConfig.tagline} — pour choisir juste, sans te faire avoir par le marketing.</p>
      <div class="hero__actions">
        {latest.length > 0 && (
          <a class="btn btn--primary" href={`/articles/${latest[0].slug}/`}>Lire le dernier comparatif →</a>
        )}
        <a class="btn btn--outline" href="/articles/">Voir tous les articles</a>
      </div>

      <div class="hero__stats">
        {stats.map((stat) => (
          <div class="hero__stat">
            <p class="hero__stat-value">{stat.value}</p>
            <p class="hero__stat-label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="trustband">
    <div class="wide trustband__inner">
      {trust.map((t) => (
        <div class="trustband__item">
          <span class="trustband__icon">{t.icon}</span>
          <span class="trustband__text">
            <strong>{t.label}</strong>
            <span>{t.note}</span>
          </span>
        </div>
      ))}
    </div>
  </div>

  <GearFinder />

  <section class="section section--soft" id="besoins">
    <div class="wide">
      <p class="section__eyebrow">Par besoin</p>
      <h2 class="section__title">Quel est ton problème ?</h2>
      <p class="section__lede">
        Nos guides sont organisés autour des situations les plus fréquentes au bureau. Choisis la tienne :
        on t'emmène directement aux comparatifs qui la règlent.
      </p>
      <div class="needs__grid">
        {needCounts.map((need) => (
          <a class="needs__item card card--hover" href={`/guides/${need.slug}/`}>
            <span class="needs__icon">{need.icon}</span>
            <span class="needs__label">{need.title}</span>
            <span class="needs__desc">{need.description}</span>
            <span class="needs__count">{need.count} comparatif{need.count > 1 ? 's' : ''} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wide">
      <p class="section__eyebrow">Par budget</p>
      <h2 class="section__title">Combien veux-tu y mettre ?</h2>
      <p class="section__lede">Chaque enveloppe a ses bons choix. Du geste gratuit à l'investissement qui dure.</p>
      <div class="budgets__grid">
        {budgetCounts.map((b) => (
          <a class="budgets__item card card--hover" href={`/budget/${b.slug}/`}>
            <span class="budgets__icon">{b.icon}</span>
            <span class="budgets__label">{b.label}</span>
            <span class="budgets__range">{b.range}</span>
            <span class="budgets__desc">{b.tagline}</span>
            <span class="budgets__count">{b.count} comparatif{b.count > 1 ? 's' : ''} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section section--soft">
      <div class="wide">
        <div class="section__head">
          <div>
            <p class="section__eyebrow">La sélection de la rédaction</p>
            <h2 class="section__title">Nos incontournables</h2>
          </div>
          <a class="section__link" href="/articles/">Tous les comparatifs →</a>
        </div>
        <p class="section__lede">Les guides d'achat qu'on recommande les yeux fermés — un pour chaque grand besoin, testés sur les critères qui comptent.</p>
        <div class="featured__grid">
          {featured.map((article) => <ArticleCard article={article} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wide">
      <div class="section__head">
        <div>
          <p class="section__eyebrow">Derniers articles</p>
          <h2 class="section__title">Les comparatifs récents</h2>
        </div>
        <a class="section__link" href="/articles/">Voir tout →</a>
      </div>
      <div class="article-list">
        {latest.length === 0 && <p>Aucun article publié pour le moment.</p>}
        {latest.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wide">
      <p class="section__eyebrow">Par type de matériel</p>
      <h2 class="section__title">Ou parcours par catégorie</h2>
      <p class="section__lede">Tu sais déjà ce que tu cherches ? Va droit au rayon.</p>
      <div class="categories__grid">
        {categoryCounts.map((cat) => (
          <a class="categories__item card card--hover" href={`/categorie/${cat.slug}/`}>
            <span class="categories__icon">{cat.icon}</span>
            <span class="categories__label">{cat.label}</span>
            <span class="categories__desc">{cat.description}</span>
            <span class="categories__count">{cat.count} article{cat.count > 1 ? 's' : ''} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="outils">
    <div class="wide">
      <p class="section__eyebrow">Outils gratuits</p>
      <h2 class="section__title">Va plus vite avec nos guides interactifs</h2>
      <div class="tools__grid">
        <a class="tools__item card card--hover" href="/guide-pc-gaming">
          <span class="tools__icon">🖥️</span>
          <span class="tools__label">Guide PC gaming pièce par pièce</span>
          <span class="tools__desc">4 configurations complètes selon ton budget, du premier PC au haut de gamme.</span>
          <span class="tools__cta">Découvrir →</span>
        </a>
        <a class="tools__item card card--hover" href="/calculateur-hauteur-bureau">
          <span class="tools__icon">📐</span>
          <span class="tools__label">Calculateur de hauteur de bureau</span>
          <span class="tools__desc">Les bonnes hauteurs de bureau, siège et écran calculées selon ta taille.</span>
          <span class="tools__cta">Calculer →</span>
        </a>
        <a class="tools__item card card--hover" href="/checklist-bureau-ergonomique">
          <span class="tools__icon">✅</span>
          <span class="tools__label">Checklist ergonomie</span>
          <span class="tools__desc">Le tour complet pour vérifier que ton poste est bien réglé.</span>
          <span class="tools__cta">Vérifier →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wide approach">
      <div class="approach__text">
        <p class="section__eyebrow">Notre méthode</p>
        <h2 class="section__title">Pourquoi nous faire confiance</h2>
        <p>
          Chaque comparatif part d'un usage concret — setup gaming, télétravail, bureau plus confortable —
          et compare des critères <strong>mesurables</strong> : charge admise, plage de réglage, niveau sonore,
          autonomie. Pas d'impressions vagues ni de classements gonflés artificiellement.
        </p>
        <p>
          On est <strong>100 % indépendants</strong> : aucune marque ne paie pour figurer. Le site se finance
          via l'affiliation — une petite commission si tu achètes, sans surcoût pour toi — et on l'indique
          toujours clairement. Les comparatifs sont revus régulièrement pour rester d'actualité.
        </p>
        <a class="btn btn--outline" href="/a-propos">Découvrir notre méthode en détail</a>
      </div>
      <ul class="approach__points">
        <li><span>✓</span> Critères concrets et vérifiables</li>
        <li><span>✓</span> Aucune marque sponsorisée</li>
        <li><span>✓</span> Affiliation transparente, sans surcoût</li>
        <li><span>✓</span> Comparatifs mis à jour dans le temps</li>
      </ul>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wide faq">
      <p class="section__eyebrow">FAQ</p>
      <h2 class="section__title">Les questions qu'on nous pose</h2>
      <p class="section__lede">Transparence totale sur notre fonctionnement et notre indépendance.</p>
      <div class="faq__list">
        {faqs.map((item, i) => (
          <details class="faq__item" open={i === 0}>
            <summary class="faq__q">
              <span>{item.q}</span>
              <span class="faq__chevron" aria-hidden="true"></span>
            </summary>
            <p class="faq__a">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    })}
  />
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(75% 120% at 88% -12%, color-mix(in srgb, var(--color-accent) 13%, transparent), transparent 60%),
      radial-gradient(60% 90% at 6% 0%, color-mix(in srgb, var(--color-signal) 9%, transparent), transparent 55%),
      linear-gradient(180deg, #ffffff 0%, var(--color-bg) 100%);
    border-bottom: 1px solid var(--color-border);
  }
  /* fine grille de points, très discrète, fondue vers le coin haut-droit */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in srgb, var(--color-text) 7%, transparent) 1px, transparent 1.4px);
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(72% 65% at 85% 0%, #000, transparent 72%);
    mask-image: radial-gradient(72% 65% at 85% 0%, #000, transparent 72%);
    opacity: 0.55;
    z-index: -1;
    pointer-events: none;
  }
  .hero__inner {
    padding: clamp(3.4rem, 11vh, 6.5rem) 1.25rem clamp(3rem, 8vh, 5rem);
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    padding: 0.5em 1em;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-text-muted);
    margin: 0 0 1.6rem;
  }
  .hero__badge-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-signal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-signal) 22%, transparent);
  }
  .hero__title {
    font-size: clamp(2.4rem, 5.4vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin: 0 0 1.3rem;
    max-width: 18ch;
    text-wrap: balance;
    color: var(--color-text);
  }
  .hero__hl {
    color: var(--color-accent);
    background: linear-gradient(180deg, transparent 64%, color-mix(in srgb, var(--color-signal) 32%, transparent) 64%);
    padding: 0 0.05em;
    white-space: nowrap;
  }
  .hero__lede {
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 56ch;
    margin: 0 0 2rem;
  }
  .hero__actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 3rem; }

  .hero__stats {
    display: flex;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    flex-wrap: wrap;
    padding-top: 1.8rem;
    border-top: 1px solid var(--color-border);
    max-width: 560px;
  }
  .hero__stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3vw, 2.4rem);
    font-weight: 600;
    margin: 0;
    color: var(--color-text);
  }
  .hero__stat-label {
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0.2rem 0 0;
  }

  /* ---- Sections génériques ---- */
  .section { padding: 3.6rem 0; scroll-margin-top: 5rem; }
  .section--soft { background: var(--color-bg-soft); }
  .section__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.5rem;
  }
  .section__title { margin: 0 0 0.5rem; font-size: clamp(1.5rem, 3vw, 2rem); }
  .section__lede { color: var(--color-text-muted); margin: 0 0 1.8rem; max-width: 60ch; }
  .section__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.8rem;
  }
  .section__head .section__title { margin-bottom: 0; }
  .section__link {
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .section__link:hover { text-decoration: underline; }

  /* ---- Outils gratuits ---- */
  .tools__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    margin-top: 1.8rem;
  }
  .tools__item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    padding: 1.6rem 1.5rem;
  }
  .tools__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    font-size: 1.5rem;
    border-radius: 12px;
    background: var(--color-accent-soft);
    margin-bottom: 1rem;
  }
  .tools__label { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; }
  .tools__desc { color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.5; margin: 0.3rem 0 1rem; flex: 1; }
  .tools__cta { font-size: 0.82rem; font-weight: 600; color: var(--color-accent); }

  /* ---- Catégories ---- */
  .categories__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
  }
  .categories__item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    padding: 1.6rem 1.5rem;
  }
  .categories__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    font-size: 1.5rem;
    border-radius: 12px;
    background: var(--color-accent-soft);
    margin-bottom: 1rem;
  }
  .categories__label { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; }
  .categories__desc { color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.5; margin: 0.3rem 0 1rem; flex: 1; }
  .categories__count { font-size: 0.82rem; font-weight: 600; color: var(--color-accent); }

  /* ---- Par besoin (problèmes) ---- */
  .needs__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.8rem;
  }
  .needs__item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    padding: 1.6rem 1.5rem;
  }
  .needs__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    font-size: 1.6rem;
    border-radius: 14px;
    background: var(--color-accent-soft);
    margin-bottom: 1rem;
  }
  .needs__label { font-family: var(--font-display); font-weight: 700; font-size: 1.12rem; line-height: 1.25; }
  .needs__desc { color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.5; margin: 0.45rem 0 1rem; flex: 1; }
  .needs__count { font-size: 0.82rem; font-weight: 600; color: var(--color-accent); }

  /* ---- Comparatifs de référence ---- */
  .featured__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  /* ---- Barre de confiance ---- */
  .trustband {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .trustband__inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
  }
  .trustband__item { display: flex; align-items: center; gap: 0.7rem; }
  .trustband__icon {
    font-size: 1.2rem;
    width: 40px; height: 40px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--color-accent-soft);
    border-radius: 10px;
    flex-shrink: 0;
  }
  .trustband__text { display: flex; flex-direction: column; line-height: 1.25; }
  .trustband__text strong { font-size: 0.9rem; color: var(--color-text); }
  .trustband__text span { font-size: 0.78rem; color: var(--color-text-muted); }

  /* ---- Par budget ---- */
  .budgets__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.8rem;
  }
  .budgets__item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    padding: 1.6rem 1.5rem;
  }
  .budgets__icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; height: 48px; font-size: 1.5rem;
    border-radius: 12px; background: var(--color-accent-soft);
    margin-bottom: 1rem;
  }
  .budgets__label { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; }
  .budgets__range { font-size: 0.8rem; font-weight: 600; color: var(--color-accent); margin: 0.2rem 0 0.5rem; }
  .budgets__desc { color: var(--color-text-muted); font-size: 0.92rem; line-height: 1.5; margin: 0 0 1rem; flex: 1; }
  .budgets__count { font-size: 0.82rem; font-weight: 600; color: var(--color-accent); }

  /* ---- FAQ ---- */
  .faq__list { margin-top: 1.8rem; display: flex; flex-direction: column; gap: 0.75rem; max-width: 780px; }
  .faq__item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 0 1.3rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .faq__item[open] { border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border)); box-shadow: var(--shadow-sm); }
  .faq__q {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    cursor: pointer; list-style: none;
    padding: 1.1rem 0;
