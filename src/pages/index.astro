---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { coverSrcSet, resolveCoverImage } from '../lib/covers';
import { resolveProductImage } from '../lib/products';
import { getRating } from '../lib/ratings';
import { isAvailable, productUrl } from '../lib/availability';
import { mesuresProduit } from '../lib/mesures';
import ArticleCard from '../components/ArticleCard.astro';
import EpurePoste from '../components/EpurePoste.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../siteConfig';
import { categories } from '../categories';
import { guides } from '../guides';
import { budgets } from '../budgets';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const sorted = [...allArticles].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// Numéro de planche : ordre de publication, stable (01 = le premier comparatif publié)
const chrono = [...allArticles].sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf() || a.slug.localeCompare(b.slug));
const numero = new Map(chrono.map((a, i) => [a.slug, String(i + 1).padStart(2, '0')]));
const bySlug = new Map(allArticles.map((a) => [a.slug, a]));
const published = new Set(allArticles.map((a) => a.slug));
const total = allArticles.length;
const nf = new Intl.NumberFormat('fr-FR');
const dateCourte = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
const shortTitle = (t: string) => t.split(/\s[—–-]\s/)[0].trim();

const cote = (r: number) => Math.round(r * 175); // taille de départ : 175 cm, même arrondi que l'épure

// Nomenclature : les comparatifs de référence, un par grand besoin
const refSlugs = ['bureau-assis-debout-electrique', 'meilleures-chaises-gaming', 'souris-ergonomique-verticale', 'casque-reduction-bruit-teletravail', 'claviers-mecaniques-silencieux', 'bras-support-ecran-articule', 'webcams-1080p-vs-4k', 'hub-usb-c-station-accueil'];
const refs = refSlugs.map((s) => bySlug.get(s)).filter((a): a is NonNullable<typeof a> => Boolean(a)).map((a) => ({
  a,
  n: a.data.products?.length ?? 0,
  cover: resolveCoverImage(a.slug, a.data.coverImage),
  cat: categories.find((c) => c.slug === a.data.category),
  date: a.data.updatedDate ?? a.data.pubDate,
  planche: numero.get(a.slug),
}));

// Choix cotés : le premier produit disponible (avec photo) de comparatifs choisis
const picks = refSlugs
  .map((slug) => {
    const article = bySlug.get(slug); if (!article) return null;
    const product = (article.data.products ?? []).find((x) => isAvailable(x.asin) && resolveProductImage(x.asin, x.image));
    if (!product) return null;
    return { article, product, image: resolveProductImage(product.asin, product.image)!, rating: getRating(product.asin), mesures: mesuresProduit(product) };
  })
  .filter((x): x is NonNullable<typeof x> => Boolean(x))
  .slice(0, 4);

// Par problème : libellé court (avant les deux-points)
const needs = guides.map((g) => ({ ...g, court: g.title.split(/\s:\s/)[0], count: g.articles.filter((s) => published.has(s)).length }));

// Par budget : trois plages sur une même échelle de prix (0 à 300 €, la dernière ouverte)
const bornes: Record<string, [number, number, boolean]> = { 'petit-budget': [0, 40, false], equilibre: [50, 150, false], 'setup-complet': [150, 300, true] };
const echelle = 300;
const budgetRows = budgets.map((b) => {
  const [de, a, ouvert] = bornes[b.slug] ?? [0, echelle, true];
  return { ...b, de, a, ouvert, gauche: (de / echelle) * 100, largeur: ((a - de) / echelle) * 100, count: b.articles.filter((s) => published.has(s)).length };
});
const graduations = [0, 100, 200, 300];
const categoryCounts = categories.map((c) => ({ ...c, count: allArticles.filter((x) => x.data.category === c.slug).length }));
const latest = sorted.filter((a) => !refSlugs.includes(a.slug)).slice(0, 3);

const tools = [
  { icon: 'ruler', title: 'Calculateur de hauteur de bureau', desc: 'Plateau, siège et écran selon ta taille.', href: '/calculateur-hauteur-bureau/' },
  { icon: 'posture', title: 'Le poste de travail idéal', desc: 'Le schéma coté des bons réglages.', href: '/poste-de-travail-ideal/' },
  { icon: 'checklist', title: 'Checklist ergonomie', desc: 'Ce qu’il faut vérifier, point par point.', href: '/checklist-bureau-ergonomique/' },
  { icon: 'cpu', title: 'Guide PC gaming', desc: 'Chaque pièce expliquée, sans jargon.', href: '/guide-pc-gaming/' },
  { icon: 'book', title: 'Lexique du bureau', desc: 'Les mots du matériel, en clair.', href: '/lexique/' },
];

const faqs = [
  { q: 'Vos comparatifs sont-ils sponsorisés ?', a: "Non. Aucune marque ne paie pour figurer ou être mieux classée. On se rémunère uniquement via les liens affiliés : si tu achètes après avoir cliqué, on touche une petite commission, sans surcoût pour toi. Ça ne change ni nos choix, ni nos critiques." },
  { q: 'Comment choisissez-vous les produits recommandés ?', a: "On part toujours d'un usage concret (mal de dos, petit bureau, visio…) et on compare des critères vérifiables : plage de réglage, charge admise, niveau sonore, autonomie. On assume les compromis de chaque modèle plutôt que de gonfler un classement." },
  { q: 'D’où viennent les notes affichées ?', a: "La note et le nombre d'avis proviennent directement de la fiche Amazon du produit, relevés automatiquement et réactualisés régulièrement. Nous n'écrivons aucun avis client : ce sont ceux, réels, laissés par les acheteurs." },
  { q: 'À quelle fréquence les articles sont-ils mis à jour ?', a: "Régulièrement. Les modèles conseillés et les prix évoluent vite : on révise les comparatifs pour qu'ils restent d'actualité, et la date de dernière mise à jour est indiquée en haut de chaque article." },
  { q: "C'est quoi, un « lien affilié Amazon » ?", a: "C'est un lien qui indique à Amazon que tu viens de chez nous. Si tu achètes, Amazon nous reverse une petite commission, et le prix reste exactement le même pour toi. C'est ce qui finance le site et nous permet de rester indépendants." },
];
---

<BaseLayout title="Mon Bureau Connecté : ton poste de travail, réglé au millimètre" description={siteConfig.description}>
  <!-- ═══ OUVERTURE : l'épure du poste, cotée selon ta taille ═══ -->
  <section class="hero" aria-labelledby="hero-titre">
    <div class="wide hero__grid">
      <div class="hero__texte">
        <h1 id="hero-titre" class="hero__titre">Ton poste, réglé au millimètre.</h1>
        <p class="hero__chapo">Donne ta taille : on calcule les cotes de ton poste, puis on compare le matériel qui les respecte. {total} comparatifs indépendants, avec les vraies notes Amazon, jamais retouchées.</p>
        <div class="taille">
          <label class="taille__label" for="taille-nb">Ta taille</label>
          <div class="taille__champ">
            <input id="taille-nb" class="taille__nb" type="number" inputmode="numeric" min="140" max="210" step="1" value="175" aria-describedby="taille-aide" />
            <span class="taille__unite" aria-hidden="true">cm</span>
          </div>
          <input id="taille-curseur" class="taille__curseur" type="range" min="140" max="210" step="1" value="175" aria-label="Ta taille en centimètres" />
          <p id="taille-aide" class="taille__aide">De 140 à 210 cm. Les cotes se recalculent au centimètre près.</p>
        </div>
      </div>
      <figure class="hero__epure">
        <EpurePoste taille={175} />
        <dl class="cartouche hero__cartouche">
          <div><dt>Planche</dt><dd class="mono">00</dd></div>
          <div><dt>Sujet</dt><dd>Poste assis-debout</dd></div>
          <div><dt>Échelle</dt><dd>Ta taille</dd></div>
          <div><dt>Comparatifs</dt><dd class="mono">{total}</dd></div>
        </dl>
      </figure>
      <div class="hero__suite">
        <dl class="hero__valeurs">
          <div class="cote-cell"><dt>Assise</dt><dd><b data-ratio="0.25">{cote(0.25)}</b> cm</dd></div>
          <div class="cote-cell"><dt>Plateau assis</dt><dd><b data-ratio="0.42">{cote(0.42)}</b> cm</dd></div>
          <div class="cote-cell"><dt>Plateau debout</dt><dd><b data-ratio="0.62">{cote(0.62)}</b> cm</dd></div>
          <div class="cote-cell"><dt>Haut de l'écran</dt><dd><b data-ratio="0.7">{cote(0.7)}</b> cm</dd></div>
        </dl>
        <p class="hero__verdict" id="verdict" aria-live="polite">Un bureau standard (74 cm) te va : règle ta chaise pour garder les coudes à 90°.</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href="/articles/bureau-assis-debout-electrique/">Voir les bureaux réglables <Icon name="arrow" size={18} /></a>
          <a class="hero__lien" href="/calculateur-hauteur-bureau/">Le calculateur complet</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ NOMENCLATURE : les comparatifs de référence ═══ -->
  <div class="wide"><span class="regle" aria-hidden="true"></span></div>
  <section class="section" aria-labelledby="nomen-titre">
    <div class="wide">
      <div class="section__head">
        <div>
          <h2 id="nomen-titre" class="section__title">Les comparatifs de référence</h2>
          <p class="section__lede">Un comparatif par grand besoin : les critères qui comptent, les mesures qui départagent, et notre choix.</p>
        </div>
        <a class="section__link" href="/articles/">Les {total} comparatifs <Icon name="arrow" size={16} /></a>
      </div>
      <div class="nomen">
        <ul class="nomen__liste">
          {refs.map((r, i) => (
            <li class="nomen__item" data-i={i}>
              <a class="nomen__lien" href={`/articles/${r.a.slug}/`}>
                <span class="nomen__no mono" title="Numéro de planche">{r.planche}</span>
                <span class="nomen__corps">
                  <span class="nomen__titre">{r.a.data.title}</span>
                  <span class="nomen__sous"><span>{r.cat?.label}</span><span class="mono">{r.n} produit{r.n > 1 ? 's' : ''}</span><span class="mono">{dateCourte.format(r.date)}</span></span>
                </span>
                <Icon name="arrow" size={18} class="nomen__fleche" />
              </a>
            </li>
          ))}
        </ul>
        <div class="nomen__vue cadre" aria-hidden="true">
          {refs.map((r, i) => r.cover && <img class="nomen__img" data-i={i} src={r.cover} srcset={coverSrcSet(r.cover)} sizes="(max-width: 1000px) 1px, 460px" alt="" width="1600" height="1000" loading="lazy" decoding="async" />)}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ NOS CHOIX, COTÉS : une feuille de caractéristiques ═══ -->
  {picks.length > 0 && (
    <>
      <div class="wide"><span class="regle" aria-hidden="true"></span></div>
      <section class="section" aria-labelledby="choix-titre">
        <div class="wide">
          <div class="section__head">
            <div>
              <h2 id="choix-titre" class="section__title">Nos choix, cotés</h2>
              <p class="section__lede">Le premier choix de nos comparatifs : ses mesures d'abord, puis sa note Amazon réelle. Le prix s'affiche sur la fiche Amazon.</p>
            </div>
          </div>
          <div class="feuille">
            {picks.map(({ article, product, image, rating, mesures }) => (
              <article class="feuille__col">
                <a class="feuille__media" href={`/articles/${article.slug}/`} tabindex="-1" aria-hidden="true"><img src={image} alt="" loading="lazy" decoding="async" width="400" height="400" /></a>
                <div class="feuille__nom">
                  <h3><a href={`/articles/${article.slug}/`}>{shortTitle(product.title)}</a></h3>
                  <p class="feuille__award">{product.award ?? 'Notre choix'}</p>
                </div>
                {mesures.length > 0 ? <ul class="mesures" aria-label="Mesures">{mesures.map((m) => <li>{m}</li>)}</ul> : <p class="feuille__vide">Mesures détaillées dans le comparatif</p>}
                {rating ? (
                  <p class="reglette">
                    <span class="reglette__rule" style={`--p:${Math.round((rating.rating / 5) * 1000) / 10}%`} role="img" aria-label={`Note Amazon : ${rating.rating.toFixed(1).replace('.', ',')} sur 5`}></span>
                    <span class="reglette__val"><b>{rating.rating.toFixed(1).replace('.', ',')}</b>/5 · {nf.format(rating.count)} avis</span>
                  </p>
                ) : <p class="feuille__vide">Note Amazon indisponible</p>}
                <div class="feuille__cta">
                  <a class="btn btn--buy btn--sm" href={productUrl(product.asin)} target="_blank" rel="nofollow sponsored noopener">Voir sur Amazon <Icon name="external" size={14} /></a>
                  <a class="feuille__lire" href={`/articles/${article.slug}/`}>Lire le comparatif</a>
                </div>
              </article>
            ))}
          </div>
          <p class="feuille__disc">Liens partenaires : en tant que Partenaire Amazon, {siteConfig.name} perçoit une commission sur les achats éligibles, sans surcoût pour toi.</p>
        </div>
      </section>
    </>
  )}

  <!-- ═══ PAR PROBLÈME ═══ -->
  <div class="wide"><span class="regle" aria-hidden="true"></span></div>
  <section class="section" aria-labelledby="pb-titre">
    <div class="wide">
      <div class="section__head">
        <div>
          <h2 id="pb-titre" class="section__title">Quel est ton problème ?</h2>
          <p class="section__lede">Nos comparatifs rangés par situation réelle : on te dit quoi lire, et dans quel ordre.</p>
        </div>
        <a class="section__link" href="/guides/">Tous les guides <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="pb">
        {needs.map((n) => (
          <li><a class="pb__lien" href={`/guides/${n.slug}/`}><span class="pb__titre">{n.court}</span><span class="pb__n mono">{n.count} comparatif{n.count > 1 ? 's' : ''}</span><Icon name="arrow" size={24} class="pb__fleche" /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ PAR BUDGET (règle de prix) + RAYONS ═══ -->
  <div class="wide"><span class="regle" aria-hidden="true"></span></div>
  <section class="section" aria-labelledby="budget-titre">
    <div class="wide budg">
      <div>
        <h2 id="budget-titre" class="section__title">Combien veux-tu y mettre ?</h2>
        <p class="section__lede">Trois plages de prix posées sur la même règle, pour voir d'un coup d'œil où se situe chaque sélection.</p>
        <div class="plages">
          {budgetRows.map((b) => (
            <a class="plage" href={`/budget/${b.slug}/`}>
              <span class="plage__nom">{b.label}<span class="plage__n mono">{b.count} comparatifs</span></span>
              <span class="plage__piste" aria-hidden="true"><span class:list={['plage__barre', { 'plage__barre--ouverte': b.ouvert }]} style={`--g:${b.gauche}%;--l:${b.largeur}%`}></span></span>
              <span class="plage__prix mono">{b.range}</span>
            </a>
          ))}
          <div class="plages__axe" aria-hidden="true">
            <span class="plages__graduations">{graduations.map((g) => <span style={`--x:${(g / echelle) * 100}%`}>{g === echelle ? `${g} € et +` : `${g} €`}</span>)}</span>
          </div>
        </div>
      </div>
      <div class="rayons">
        <h3 class="rayons__titre">Ou va droit au rayon</h3>
        <ul>
          {categoryCounts.map((c) => <li><a href={`/categorie/${c.slug}/`}><Icon name={c.slug} size={20} /><span>{c.label}</span><span class="mono">{c.count}</span></a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ DERNIÈRES PLANCHES ═══ -->
  {latest.length > 0 && (
    <>
      <div class="wide"><span class="regle" aria-hidden="true"></span></div>
      <section class="section" aria-labelledby="derniers-titre">
        <div class="wide">
          <div class="section__head">
            <h2 id="derniers-titre" class="section__title">Fraîchement publiés</h2>
            <a class="section__link" href="/articles/">Voir tout <Icon name="arrow" size={16} /></a>
          </div>
          <div class="grid3">{latest.map((a) => <ArticleCard article={a} />)}</div>
        </div>
      </section>
    </>
  )}

  <!-- ═══ OUTILS : régler avant d'acheter ═══ -->
  <div class="wide"><span class="regle" aria-hidden="true"></span></div>
  <section class="section" aria-labelledby="outils-titre">
    <div class="wide">
      <div class="section__head">
        <div>
          <h2 id="outils-titre" class="section__title">Règle ton poste avant d'acheter</h2>
          <p class="section__lede">Le premier gain ne coûte souvent rien : un écran à la bonne hauteur, un siège bien réglé. Nos outils gratuits donnent les repères.</p>
        </div>
        <a class="section__link" href="/outils/">Tous les outils <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="outils">
        {tools.map((t) => <li><a href={t.href}><Icon name={t.icon} size={26} /><span class="outils__titre">{t.title}</span><span class="outils__desc">{t.desc}</span></a></li>)}
      </ul>
    </div>
  </section>

  <!-- ═══ MÉTHODE + FAQ ═══ -->
  <div class="wide"><span class="regle" aria-hidden="true"></span></div>
  <section class="section" aria-labelledby="methode-titre">
    <div class="wide methode">
      <div class="methode__texte">
        <h2 id="methode-titre" class="section__title">Comment on mesure</h2>
        <p>Chaque comparatif part d'un usage concret (setup gaming, télétravail, dos fragile) et compare ce qui se vérifie : <strong>plage de réglage, charge admise, niveau sonore, autonomie, compatibilité</strong>. Pas de classement gonflé, pas de « meilleur » universel qui n'existe pas.</p>
        <p>Les notes affichées sont les <strong>vraies notes Amazon</strong>, jamais retouchées, et on regarde le volume d'avis autant que la note. Le site est <strong>100 % indépendant</strong> : on se finance par l'affiliation, et on l'indique toujours.</p>
        <a class="btn btn--outline" href="/a-propos/">Notre méthode en détail</a>
      </div>
      <div class="faq">
        <h2 class="section__title">Questions fréquentes</h2>
        <div class="faq__liste">
          {faqs.map((item, i) => (
            <details class="faq__item" open={i === 0}>
              <summary class="faq__q"><span>{item.q}</span><span class="faq__signe" aria-hidden="true"></span></summary>
              <p class="faq__a">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) })} />
</BaseLayout>

<script is:inline>
  // Calculateur de l'ouverture : les cotes de l'épure et la liste suivent la taille.
  (function () {
    var nb = document.getElementById('taille-nb');
    var curseur = document.getElementById('taille-curseur');
    var verdict = document.getElementById('verdict');
    if (!nb || !curseur) return;
    var cibles = Array.prototype.slice.call(document.querySelectorAll('[data-ratio]'));
    var reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function texteVerdict(assis) {
      var d = assis - 74;
      if (Math.abs(d) <= 1) return 'Un bureau standard (74 cm) te va : règle ta chaise pour garder les coudes à 90°.';
      if (d < 0) return 'Un bureau standard (74 cm) est ' + (-d) + ' cm trop haut pour toi : monte ta chaise et ajoute un <a href="/articles/repose-pieds-ergonomique-bureau/">repose-pieds</a>, ou passe au <a href="/articles/bureau-assis-debout-electrique/">bureau réglable</a>.';
      return 'Un bureau standard (74 cm) est ' + d + ' cm trop bas pour toi : un <a href="/articles/bureau-assis-debout-electrique/">bureau réglable en hauteur</a> corrige ça.';
    }
    function rendre(t) {
      cibles.forEach(function (el) {
        var v = String(Math.round(parseFloat(el.getAttribute('data-ratio')) * t));
        if (el.textContent === v) return;
        el.textContent = v;
        var g = el.closest('.cote-label, .cote-cell');
        if (g && !reduit) { g.classList.remove('is-new'); void (g.getBBox ? g.getBBox() : g.offsetWidth); g.classList.add('is-new'); clearTimeout(g._t); g._t = setTimeout(function () { g.classList.remove('is-new'); }, 400); }
      });
      if (verdict) verdict.innerHTML = texteVerdict(Math.round(0.42 * t));
    }
    function sync(val, source) {
      var t = parseInt(val, 10);
      if (isNaN(t)) return;
      var borne = Math.min(210, Math.max(140, t));
      if (source !== 'nb' || String(borne) === String(t)) nb.value = borne;
      curseur.value = borne;
      curseur.style.setProperty('--p', ((borne - 140) / 70) * 100 + '%');
      rendre(borne);
    }
    curseur.addEventListener('input', function () { sync(curseur.value, 'curseur'); });
    nb.addEventListener('input', function () { sync(nb.value, 'nb'); });
    nb.addEventListener('blur', function () { sync(nb.value || 175, ''); });
    sync(175, '');
  })();
</script>

<style>
  /* ═══ OUVERTURE ═══ */
  .hero__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-rows: auto auto; gap: 0 clamp(2rem, 4vw, 4rem); align-items: start; padding-top: clamp(2.2rem, 6vh, 4.5rem); padding-bottom: clamp(2.5rem, 7vh, 5rem); }
  .hero__titre { margin: 0 0 1.2rem; font-size: clamp(2.4rem, 1rem + 3.4vw, 4rem); line-height: 1.02; letter-spacing: -0.03em; }
  .hero__chapo { margin: 0 0 2rem; font-size: 1.1rem; line-height: 1.6; color: var(--gris); max-width: 48ch; }

  .taille { display: grid; grid-template-columns: auto 1fr; align-items: end; gap: 0.3rem 1.2rem; margin: 0 0 1.4rem; }
  .taille__label { grid-column: 1 / -1; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--gris); }
  .taille__champ { display: flex; align-items: baseline; gap: 0.4rem; border-bottom: 1.5px solid var(--mine); }
  .taille__nb { width: 3.4ch; padding: 0; border: 0; background: transparent; color: var(--mine); font-family: var(--font-display); font-stretch: 125%; font-weight: 300; font-size: 3rem; line-height: 1.1; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; -moz-appearance: textfield; appearance: textfield; }
  .taille__nb::-webkit-outer-spin-button, .taille__nb::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .taille__nb:focus { outline: none; }
