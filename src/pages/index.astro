---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { coverSrcSet, resolveCoverImage } from '../lib/covers';
import { resolveProductImage } from '../lib/products';
import { getRating } from '../lib/ratings';
import { isAvailable, productUrl } from '../lib/availability';
import { mesuresProduit } from '../lib/mesures';
import ArticleCard from '../components/ArticleCard.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../siteConfig';
import { categories } from '../categories';
import { guides } from '../guides';
import { budgets } from '../budgets';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const sorted = [...allArticles].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const bySlug = new Map(allArticles.map((a) => [a.slug, a]));
const published = new Set(allArticles.map((a) => a.slug));
const total = allArticles.length;
const nf = new Intl.NumberFormat('fr-FR');
const shortTitle = (t: string) => t.split(/\s[—–-]\s/)[0].trim();
const cote = (r: number) => Math.round(r * 175); // taille de départ : 175 cm

// Photo d'ouverture : la couverture du comparatif de référence
const heroCover = '/covers/accueil-setup.webp';

// Comparatifs de référence, un par grand besoin
const refSlugs = ['bureau-assis-debout-electrique', 'meilleures-chaises-gaming', 'souris-ergonomique-verticale', 'casque-reduction-bruit-teletravail', 'claviers-mecaniques-silencieux', 'bras-support-ecran-articule', 'webcams-1080p-vs-4k', 'hub-usb-c-station-accueil'];
const refs = refSlugs.map((s) => bySlug.get(s)).filter((a): a is NonNullable<typeof a> => Boolean(a)).slice(0, 6);

// Nos choix : le premier produit disponible (avec photo) des comparatifs de référence
const picks = refSlugs
  .map((slug) => {
    const article = bySlug.get(slug); if (!article) return null;
    const product = (article.data.products ?? []).find((x) => isAvailable(x.asin) && resolveProductImage(x.asin, x.image));
    if (!product) return null;
    return { article, product, image: resolveProductImage(product.asin, product.image)!, rating: getRating(product.asin), mesures: mesuresProduit(product) };
  })
  .filter((x): x is NonNullable<typeof x> => Boolean(x))
  .slice(0, 6);

// Par problème : libellé court (avant les deux-points)
const needs = guides.map((g) => ({ ...g, court: g.title.split(/\s:\s/)[0], count: g.articles.filter((s) => published.has(s)).length }));
const marquee = [...needs.map((n) => n.court), 'Visio', 'Budget'];

// Par budget : trois plages sur une même échelle de prix (0 à 300 €, la dernière ouverte)
const bornes: Record<string, [number, number, boolean]> = { 'petit-budget': [0, 40, false], equilibre: [50, 150, false], 'setup-complet': [150, 300, true] };
const echelle = 300;
const budgetRows = budgets.map((b) => {
  const [de, a, ouvert] = bornes[b.slug] ?? [0, echelle, true];
  return { ...b, de, a, ouvert, gauche: (de / echelle) * 100, largeur: ((a - de) / echelle) * 100, count: b.articles.filter((s) => published.has(s)).length };
});
const graduations = [0, 100, 200, 300];
const categoryCounts = categories.map((c) => ({ ...c, count: allArticles.filter((x) => x.data.category === c.slug).length }));
const latest = sorted.filter((a) => !refSlugs.includes(a.slug)).slice(0, 3);

const tools = [
  { icon: 'ruler', title: 'Calculateur de hauteur de bureau', desc: 'Plateau, siège et écran selon ta taille.', href: '/calculateur-hauteur-bureau/' },
  { icon: 'posture', title: 'Le poste de travail idéal', desc: 'Le schéma des bons réglages, repère par repère.', href: '/poste-de-travail-ideal/' },
  { icon: 'checklist', title: 'Checklist ergonomie', desc: 'Ce qu’il faut vérifier, point par point.', href: '/checklist-bureau-ergonomique/' },
  { icon: 'cpu', title: 'Guide PC gaming', desc: 'Chaque pièce expliquée, sans jargon.', href: '/guide-pc-gaming/' },
  { icon: 'book', title: 'Lexique du bureau', desc: 'Les mots du matériel, en clair.', href: '/lexique/' },
];

const faqs = [
  { q: 'Vos comparatifs sont-ils sponsorisés ?', a: "Non. Aucune marque ne paie pour figurer ou être mieux classée. On se rémunère uniquement via les liens affiliés : si tu achètes après avoir cliqué, on touche une petite commission, sans surcoût pour toi. Ça ne change ni nos choix, ni nos critiques." },
  { q: 'Comment choisissez-vous les produits recommandés ?', a: "On part toujours d'un usage concret (mal de dos, petit bureau, visio…) et on compare des critères vérifiables : plage de réglage, charge admise, niveau sonore, autonomie. On assume les compromis de chaque modèle plutôt que de gonfler un classement." },
  { q: 'D’où viennent les notes affichées ?', a: "La note et le nombre d'avis proviennent directement de la fiche Amazon du produit, relevés automatiquement et réactualisés régulièrement. Nous n'écrivons aucun avis client : ce sont ceux, réels, laissés par les acheteurs." },
  { q: 'À quelle fréquence les articles sont-ils mis à jour ?', a: "Régulièrement. Les modèles conseillés et les prix évoluent vite : on révise les comparatifs pour qu'ils restent d'actualité, et la date de dernière mise à jour est indiquée en haut de chaque article." },
  { q: "C'est quoi, un « lien affilié Amazon » ?", a: "C'est un lien qui indique à Amazon que tu viens de chez nous. Si tu achètes, Amazon nous reverse une petite commission, et le prix reste exactement le même pour toi. C'est ce qui finance le site et nous permet de rester indépendants." },
];
---

<BaseLayout title="Mon Bureau Connecté : ton setup, pièce par pièce" description={siteConfig.description}>
  <!-- ═══ OUVERTURE : la photo de poste annotée ═══ -->
  <section class="hero" aria-labelledby="hero-titre">
    <img class="hero__bg" src={heroCover} srcset={coverSrcSet(heroCover)} sizes="100vw" width="1600" height="1000" alt="" fetchpriority="high" decoding="async" />
    <div class="wide hero__in">
      <div class="hero__txt">
        <h1 id="hero-titre" class="hero__titre">Ton setup, pièce <span class="hl">par pièce.</span></h1>
        <p class="hero__lede">Chaise, bureau, écran, clavier : {total} comparatifs sur des critères mesurables, avec les vraies notes Amazon, jamais retouchées. Et des outils gratuits pour tout régler avant d'acheter.</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href="/guides/">Trouver par besoin <Icon name="arrow" size={18} /></a>
          <a class="btn btn--outline" href="/calculateur-hauteur-bureau/">Régler mon poste</a>
        </div>
        <form class="taille" onsubmit="return false">
          <label class="taille__label" for="taille-nb">Ta taille</label>
          <span class="taille__champ"><input id="taille-nb" class="taille__nb" type="number" inputmode="numeric" min="140" max="210" step="1" value="175" aria-describedby="taille-aide" /><span aria-hidden="true">cm</span></span>
          <span id="taille-aide" class="taille__aide">les repères sur la photo se recalculent</span>
        </form>
        <p class="hero__verdict" id="verdict" aria-live="polite">Un bureau standard (74 cm) te va : règle ta chaise pour garder les coudes à 90°.</p>
      </div>
      <div class="hots">
        <div class="hot h1"><i></i><span><b>Écran</b> haut à hauteur des yeux · <em class="cote-val" data-ratio="0.7">{cote(0.7)}</em> cm</span></div>
        <div class="hot h2"><i></i><span><b>Bureau</b> assis <em class="cote-val" data-ratio="0.42">{cote(0.42)}</em> cm, debout <em class="cote-val" data-ratio="0.62">{cote(0.62)}</em> cm</span></div>
        <div class="hot h3"><i></i><span><b>Assise</b> à <em class="cote-val" data-ratio="0.25">{cote(0.25)}</em> cm, coudes à 90°</span></div>
      </div>
    </div>
  </section>

  <!-- ═══ BANDEAU DES BESOINS ═══ -->
  <div class="marq" aria-hidden="true"><div>{[...marquee, ...marquee].map((m) => <span>{m}</span>)}</div></div>

  <!-- ═══ NOS CHOIX : le rail des pièces ═══ -->
  {picks.length > 0 && (
    <section class="section" aria-labelledby="choix-titre">
      <div class="wide">
        <div class="section__head">
          <div>
            <h2 id="choix-titre" class="section__title">Nos choix, pièce par pièce</h2>
            <p class="section__lede">Le premier choix de nos comparatifs de référence : ses mesures, sa vraie note Amazon, et le comparatif complet à un clic.</p>
          </div>
          <a class="section__link" href="/articles/">Tous les comparatifs <Icon name="arrow" size={16} /></a>
        </div>
      </div>
      <div class="rail-wrap"><div class="wide rail">
        {picks.map(({ article, product, image, rating, mesures }) => (
          <article class="piece">
            <a class="piece__media" href={`/articles/${article.slug}/`} tabindex="-1" aria-hidden="true"><img src={image} alt="" loading="lazy" decoding="async" width="400" height="400" /></a>
            <h3 class="piece__nom"><a href={`/articles/${article.slug}/`}>{shortTitle(product.title)}</a></h3>
            <p class="piece__mesures mono">{mesures.length > 0 ? mesures.join(' · ') : (product.award ?? 'Notre choix')}</p>
            {rating ? (
              <p class="reglette">
                <span class="reglette__rule" style={`--p:${Math.round((rating.rating / 5) * 1000) / 10}%`} role="img" aria-label={`Note Amazon : ${rating.rating.toFixed(1).replace('.', ',')} sur 5`}></span>
                <span class="reglette__val"><b>{rating.rating.toFixed(1).replace('.', ',')}</b>/5 · {nf.format(rating.count)} avis</span>
              </p>
            ) : <p class="piece__vide">Note Amazon indisponible</p>}
            <div class="piece__cta">
              <a class="btn btn--buy btn--sm" href={productUrl(product.asin)} target="_blank" rel="nofollow sponsored noopener">Voir sur Amazon <Icon name="external" size={14} /></a>
              <a class="piece__lire" href={`/articles/${article.slug}/`}>Le comparatif</a>
            </div>
          </article>
        ))}
      </div></div>
      <p class="wide rail__disc">Liens partenaires : en tant que Partenaire Amazon, {siteConfig.name} perçoit une commission sur les achats éligibles, sans surcoût pour toi.</p>
    </section>
  )}

  <!-- ═══ PAR PROBLÈME ═══ -->
  <section class="section section--tight" aria-labelledby="pb-titre">
    <div class="wide">
      <div class="section__head">
        <div>
          <h2 id="pb-titre" class="section__title">Quel est ton problème ?</h2>
          <p class="section__lede">Nos comparatifs rangés par situation réelle : on te dit quoi lire, et dans quel ordre.</p>
        </div>
        <a class="section__link" href="/guides/">Tous les guides <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="pb">
        {needs.map((n) => (
          <li><a class="pb__lien" href={`/guides/${n.slug}/`}><span class="pb__titre">{n.court}</span><span class="pb__n mono">{n.count} comparatif{n.count > 1 ? 's' : ''}</span><span class="pb__fleche" aria-hidden="true"><Icon name="arrow" size={22} /></span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ COMPARATIFS DE RÉFÉRENCE ═══ -->
  <section class="section section--tight" aria-labelledby="refs-titre">
    <div class="wide">
      <div class="section__head">
        <div>
          <h2 id="refs-titre" class="section__title">Les comparatifs de référence</h2>
          <p class="section__lede">Un comparatif par grand besoin : les critères qui comptent, les mesures qui départagent, et notre choix.</p>
        </div>
        <a class="section__link" href="/articles/">Les {total} comparatifs <Icon name="arrow" size={16} /></a>
      </div>
      <div class="grid3">{refs.map((a, i) => <ArticleCard article={a} eager={i < 3} />)}</div>
    </div>
  </section>

  <!-- ═══ PAR BUDGET + RAYONS ═══ -->
  <section class="section section--tight" aria-labelledby="budget-titre">
    <div class="wide budg">
      <div>
        <h2 id="budget-titre" class="section__title">Combien veux-tu y mettre ?</h2>
        <p class="section__lede">Trois plages de prix posées sur la même règle, pour voir d'un coup d'œil où se situe chaque sélection.</p>
        <div class="plages">
          {budgetRows.map((b) => (
            <a class="plage" href={`/budget/${b.slug}/`}>
              <span class="plage__nom">{b.label}<span class="plage__n mono">{b.count} comparatifs</span></span>
              <span class="plage__piste" aria-hidden="true"><span class:list={['plage__barre', { 'plage__barre--ouverte': b.ouvert }]} style={`--g:${b.gauche}%;--l:${b.largeur}%`}></span></span>
              <span class="plage__prix mono">{b.range}</span>
            </a>
          ))}
          <div class="plages__axe" aria-hidden="true"><span class="plages__graduations">{graduations.map((g) => <span style={`--x:${(g / echelle) * 100}%`}>{g === echelle ? `${g} € et +` : `${g} €`}</span>)}</span></div>
        </div>
      </div>
      <div class="rayons">
        <h3 class="rayons__titre">Ou va droit au rayon</h3>
        <ul>{categoryCounts.map((c) => <li><a href={`/categorie/${c.slug}/`}><Icon name={c.slug} size={20} /><span>{c.label}</span><span class="mono">{c.count}</span></a></li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ═══ FRAÎCHEMENT PUBLIÉS ═══ -->
  {latest.length > 0 && (
    <section class="section section--tight" aria-labelledby="derniers-titre">
      <div class="wide">
        <div class="section__head">
          <h2 id="derniers-titre" class="section__title">Fraîchement publiés</h2>
          <a class="section__link" href="/articles/">Voir tout <Icon name="arrow" size={16} /></a>
        </div>
        <div class="grid3">{latest.map((a) => <ArticleCard article={a} />)}</div>
      </div>
    </section>
  )}

  <!-- ═══ OUTILS ═══ -->
  <section class="section section--tight" aria-labelledby="outils-titre">
    <div class="wide">
      <div class="section__head">
        <div>
          <h2 id="outils-titre" class="section__title">Règle ton poste avant d'acheter</h2>
          <p class="section__lede">Le premier gain ne coûte souvent rien : un écran à la bonne hauteur, un siège bien réglé. Nos outils gratuits donnent les repères.</p>
        </div>
        <a class="section__link" href="/outils/">Tous les outils <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="outils">{tools.map((t) => <li><a href={t.href}><span class="outils__ico"><Icon name={t.icon} size={22} /></span><span class="outils__titre">{t.title}</span><span class="outils__desc">{t.desc}</span></a></li>)}</ul>
    </div>
  </section>

  <!-- ═══ MÉTHODE + FAQ ═══ -->
  <section class="section" aria-labelledby="methode-titre">
    <div class="wide methode">
      <div class="methode__texte">
        <h2 id="methode-titre" class="section__title">Comment on compare</h2>
        <p>Chaque comparatif part d'un usage concret (setup gaming, télétravail, dos fragile) et compare ce qui se vérifie : <strong>plage de réglage, charge admise, niveau sonore, autonomie, compatibilité</strong>. Pas de classement gonflé, pas de « meilleur » universel qui n'existe pas.</p>
        <p>Les notes affichées sont les <strong>vraies notes Amazon</strong>, jamais retouchées, et on regarde le volume d'avis autant que la note. Le site est <strong>100 % indépendant</strong> : on se finance par l'affiliation, et on l'indique toujours.</p>
        <a class="btn btn--outline" href="/a-propos/">Notre méthode en détail</a>
      </div>
      <div class="faq">
        <h2 class="section__title">Questions fréquentes</h2>
        <div class="faq__liste">
          {faqs.map((item, i) => (
            <details class="faq__item" open={i === 0}>
              <summary class="faq__q"><span>{item.q}</span><span class="faq__signe" aria-hidden="true"></span></summary>
              <p class="faq__a">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) })} />
</BaseLayout>

<script is:inline>
  // Ta taille : les repères de la photo et le verdict suivent la valeur saisie.
  (function () {
    var nb = document.getElementById('taille-nb');
    var verdict = document.getElementById('verdict');
    if (!nb) return;
    var cibles = Array.prototype.slice.call(document.querySelectorAll('.cote-val[data-ratio]'));
    var reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function texteVerdict(assis) {
      var d = assis - 74;
      if (Math.abs(d) <= 1) return 'Un bureau standard (74 cm) te va : règle ta chaise pour garder les coudes à 90°.';
      if (d < 0) return 'Un bureau standard (74 cm) est ' + (-d) + ' cm trop haut pour toi : monte ta chaise et ajoute un <a href="/articles/repose-pieds-ergonomique-bureau/">repose-pieds</a>, ou passe au <a href="/articles/bureau-assis-debout-electrique/">bureau réglable</a>.';
      return 'Un bureau standard (74 cm) est ' + d + ' cm trop bas pour toi : un <a href="/articles/bureau-assis-debout-electrique/">bureau réglable en hauteur</a> corrige ça.';
    }
    function rendre() {
      var t = Math.min(210, Math.max(140, parseInt(nb.value, 10) || 175));
      cibles.forEach(function (el) {
        var v = String(Math.round(parseFloat(el.getAttribute('data-ratio')) * t));
        if (el.textContent === v) return;
        el.textContent = v;
        if (!reduit) { el.classList.remove('is-new'); void el.offsetWidth; el.classList.add('is-new'); clearTimeout(el._t); el._t = setTimeout(function () { el.classList.remove('is-new'); }, 400); }
      });
      if (verdict) verdict.innerHTML = texteVerdict(Math.round(0.42 * t));
    }
    nb.addEventListener('input', rendre);
    nb.addEventListener('blur', function () { if (!nb.value) nb.value = 175; rendre(); });
  })();
</script>

<style>
  /* ═══ OUVERTURE ═══ */
  .hero { position: relative; overflow: hidden; min-height: 620px; display: flex; align-items: center; background: var(--papier-2); }
  .hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 58%; transform: scale(1.06); animation: respire 18s ease-in-out infinite alternate; }
  @keyframes respire { to { transform: scale(1) translateX(-1.5%); } }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, color-mix(in srgb, var(--calque) 97%, transparent) 0%, color-mix(in srgb, var(--calque) 88%, transparent) 36%, color-mix(in srgb, var(--calque) 12%, transparent) 68%, color-mix(in srgb, var(--calque) 25%, transparent) 100%), linear-gradient(0deg, var(--calque) 0%, transparent 26%); }
  .hero__in { position: relative; z-index: 2; width: 100%; padding-top: clamp(3rem, 8vh, 6rem); padding-bottom: clamp(3rem, 8vh, 5rem); }
  .hero__txt { max-width: 560px; }
  .hero__titre { margin: 0 0 1.2rem; font-size: clamp(2.3rem, 1.2rem + 3.4vw, 4.3rem); line-height: 1; letter-spacing: -0.035em; }
  .hero__lede { margin: 0; max-width: 44ch; font-size: 1.1rem; line-height: 1.55; color: var(--gris); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.7rem; margin: 1.7rem 0 1.4rem; }
  .taille { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 0.9rem; margin: 0; }
  .taille__label { font-weight: 700; font-size: 0.95rem; }
  .taille__champ { display: inline-flex; align-items: baseline; gap: 0.35rem; padding: 0.35rem 0.9rem 0.35rem 1rem; background: var(--papier); border: 1px solid var(--filet); border-radius: 999px; font-family: var(--font-mono); font-size: 0.95rem; color: var(--gris); box-shadow: var(--ombre); }
  .taille__champ:focus-within { border-color: var(--jaune); box-shadow: 0 0 0 3px var(--jaune-pale); }
  .taille__nb { width: 3.2ch; padding: 0; border: 0; background: transparent; color: var(--mine); font-family: var(--font-display); font-weight: 800; font-size: 1.3rem; line-height: 1.2; font-variant-numeric: tabular-nums; -moz-appearance: textfield; appearance: textfield; }
  .taille__nb::-webkit-outer-spin-button, .taille__nb::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .taille__nb:focus { outline: none; }
  .taille__aide { font-size: 0.82rem; color: var(--gris); }
  .hero__verdict { position: relative; margin: 1rem 0 0; max-width: 46ch; font-size: 0.95rem; line-height: 1.5; padding-left: 1.25rem; }
  .hero__verdict::before { content: ''; position: absolute; left: 0; top: 0.5em; width: 0.55em; height: 0.55em; border-radius: 50%; background: var(--jaune); box-shadow: 0 0 0 3px var(--jaune-pale); }
  .hots { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .hots .hot { pointer-events: auto; }
  .hot.h1 { left: 63%; top: 24%; animation-delay: 0.5s; }
  .hot.h2 { left: 66%; top: 63%; animation-delay: 1.1s; }
  .hot.h3 { left: auto; right: 7%; top: 82%; flex-direction: row-reverse; animation-delay: 1.7s; }
  .cote-val { font-style: normal; font-weight: 700; transition: background-color 0.4s var(--ease-out); border-radius: 3px; }
  .cote-val.is-new { background: var(--jaune); color: var(--sur-jaune); }

  /* ═══ RAIL DES PIÈCES ═══ */
  .rail-wrap { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; padding-bottom: 0.6rem; }
  .rail { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(260px, 1fr); gap: 1rem; }
  .piece { display: grid; grid-template-rows: auto auto auto auto 1fr; gap: 0.6rem; padding: 0.9rem; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); box-shadow: var(--ombre); scroll-snap-align: start; transition: transform 0.35s var(--ease-out), box-shadow 0.35s ease; }
  .piece:hover { transform: translateY(-6px) rotate(-0.4deg); box-shadow: var(--ombre-2); }
  .piece__media { display: block; padding: 0.9rem; background: var(--image-fond); border: 1px solid var(--filet); border-radius: var(--radius); }
  .piece__media img { width: 100%; height: 170px; object-fit: contain; display: block; }
  .piece__nom { margin: 0.3rem 0 0; font-size: 1rem; line-height: 1.25; }
  .piece__nom a { text-decoration: none; }
  .piece__nom a:hover { text-decoration: underline; text-decoration-color: var(--jaune); text-decoration-thickness: 0.4em; text-underline-offset: -0.16em; }
  .piece__mesures { margin: 0; font-size: 0.78rem; color: var(--gris); }
  .piece__vide { margin: 0; font-size: 0.82rem; color: var(--gris); }
  .piece .reglette { grid-template-columns: 1fr; }
