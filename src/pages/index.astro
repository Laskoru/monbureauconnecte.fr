---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { siteConfig } from '../siteConfig';
import { categories } from '../categories';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const latest = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 10);

const categoryCounts = categories.map((cat) => ({
  ...cat,
  count: allArticles.filter((a) => a.data.category === cat.slug).length,
}));

const stats = [
  { value: String(allArticles.length), label: 'Comparatifs publiés' },
  { value: String(categories.length), label: 'Catégories couvertes' },
  { value: '100%', label: 'Rédaction indépendante' },
];
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="hero">
    <div class="wide hero__inner">
      <p class="hero__badge"><span class="hero__badge-dot"></span> Comparatifs indépendants · bureau · gaming · télétravail</p>
      <h1 class="hero__title">{siteConfig.tagline}</h1>
      <p class="hero__lede">{siteConfig.description}</p>
      <div class="hero__actions">
        {latest.length > 0 && (
          <a class="btn btn--primary" href={`/articles/${latest[0].slug}`}>Lire le dernier comparatif →</a>
        )}
        <a class="btn btn--glass" href="/articles">Voir tous les articles</a>
      </div>

      <div class="hero__stats">
        {stats.map((stat) => (
          <div class="hero__stat">
            <p class="hero__stat-value">{stat.value}</p>
            <p class="hero__stat-label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="wide categories">
    <h2 class="categories__title">Trouve ce qu'il te faut</h2>
    <p class="categories__lede">Nos guides sont classés par ce que tu es en train d'équiper.</p>
    <div class="categories__grid">
      {categoryCounts.map((cat) => (
        <a class="categories__item card card--hover" href={`/categorie/${cat.slug}`}>
          <span class="categories__icon">{cat.icon}</span>
          <p class="categories__label">{cat.label}</p>
          <p class="categories__count">{cat.count} article{cat.count > 1 ? 's' : ''}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="container intro">
    <h2>Notre approche</h2>
    <p>
      Choisir un accessoire de bureau, ce n'est pas se ruiner sur le premier modèle à la mode. Que ce soit pour
      un setup gaming, un poste de télétravail au quotidien ou simplement un bureau plus confortable, chaque
      article part d'un usage concret et compare des critères mesurables — charge admise, plage de réglage,
      niveau sonore, autonomie — plutôt que des impressions vagues.
    </p>
    <p>
      On évite le jargon marketing et les classements gonflés artificiellement : chaque produit recommandé est
      vraiment testé et comparé avant d'atterrir dans un article, avec ses compromis assumés. Les accessoires
      bureau, gaming et télétravail évoluent vite, alors les comparatifs déjà publiés sont revus régulièrement
      pour vérifier que les modèles conseillés restent pertinents et que les prix collent encore au marché.
    </p>
  </section>

  <section class="container article-list">
    <h2 class="article-list__title">Derniers articles</h2>
    {latest.length === 0 && <p>Aucun article publié pour le moment.</p>}
    {latest.map((article) => <ArticleCard article={article} />)}
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    color: #fff;
    background-color: #0b0d13;
    background-image:
      linear-gradient(96deg, rgba(9, 11, 17, 0.95) 0%, rgba(9, 11, 17, 0.74) 46%, rgba(9, 11, 17, 0.34) 100%),
      linear-gradient(180deg, rgba(9, 11, 17, 0.35) 0%, rgba(9, 11, 17, 0) 32%, var(--color-bg) 100%),
      url('https://images.unsplash.com/photo-1626218174358-7769486c4b79?q=80&w=2000&auto=format&fit=crop');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  /* halo d'accent, discret */
  .hero::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 55%;
    height: 90%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-accent) 30%, transparent), transparent 70%);
    filter: blur(30px);
    z-index: -1;
    pointer-events: none;
  }
  .hero__inner {
    padding: clamp(4rem, 13vh, 8rem) 1.25rem clamp(3.5rem, 9vh, 6rem);
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px);
    padding: 0.5em 1em;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.92);
    margin: 0 0 1.5rem;
  }
  .hero__badge-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-signal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-signal) 30%, transparent);
  }
  .hero__title {
    font-size: clamp(2.3rem, 5.2vw, 3.9rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 1.2rem;
    max-width: 17ch;
    text-wrap: balance;
  }
  .hero__lede {
    font-size: clamp(1.02rem, 1.6vw, 1.18rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.82);
    max-width: 56ch;
    margin: 0 0 2rem;
  }
  .hero__actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 3rem; }
  .btn--glass {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(6px);
  }
  .btn--glass:hover { background: rgba(255, 255, 255, 0.16); border-color: rgba(255, 255, 255, 0.5); }

  .hero__stats {
    display: flex;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    flex-wrap: wrap;
    padding-top: 1.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    max-width: 560px;
  }
  .hero__stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    font-weight: 700;
    margin: 0;
    color: #fff;
  }
  .hero__stat-label {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.65);
    margin: 0.2rem 0 0;
  }

  .intro { padding: 3.6rem 1.25rem 0.5rem; }
  .intro h2 { margin-top: 0; }
  .intro p { color: var(--color-text-muted); line-height: 1.7; }

  .categories { padding: 3.4rem 1.25rem 1rem; }
  .categories__title { margin: 0 0 0.4rem; }
  .categories__lede { color: var(--color-text-muted); margin: 0 0 1.8rem; }
  .categories__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .categories__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: inherit;
    padding: 1.8rem 1.2rem;
  }
  .categories__icon { font-size: 2.1rem; margin-bottom: 0.6rem; }
  .categories__label { font-weight: 700; margin: 0 0 0.25rem; }
  .categories__count { font-size: 0.82rem; color: var(--color-text-faint); margin: 0; }

  .article-list { display: flex; flex-direction: column; gap: 1.1rem; padding: 2.8rem 1.25rem 3.5rem; }
  .article-list__title { margin-top: 0; }

  @media (max-width: 680px) {
    .categories__grid { grid-template-columns: 1fr; }
  }
</style>
