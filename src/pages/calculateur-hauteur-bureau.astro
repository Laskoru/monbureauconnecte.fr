---
import PageHead from '../components/PageHead.astro';
import EpurePoste from '../components/EpurePoste.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../siteConfig';

// Ratios anthropométriques usuels (proportion de la taille debout).
// Ils servent de POINT DE DÉPART à ajuster au ressenti — voir la note sur la page.
const RATIOS = {
  assise: 0.25, // hauteur du siège (creux du genou au sol)
  plateauAssis: 0.42, // dessus du plateau en position assise
  plateauDebout: 0.62, // dessus du plateau en position debout
  yeux: 0.7, // hauteur des yeux assis = haut de l'écran
};

// Hauteur d'un bureau fixe standard vendu dans le commerce (norme de fait).
const BUREAU_STANDARD = 74;

const faq = [
  {
    question: 'Ces hauteurs conviennent-elles à tout le monde ?',
    answer:
      "Ce sont des points de départ statistiques, calculés à partir de proportions moyennes du corps humain. Les longueurs de jambes et de buste varient d'une personne à l'autre à taille égale : considère ces valeurs comme un réglage initial, puis ajuste de un ou deux centimètres selon ton ressenti après quelques jours.",
  },
  {
    question: 'Mon bureau fixe est trop haut, que faire ?',
    answer:
      "C'est le cas le plus fréquent, surtout en dessous d'1,75 m : les bureaux du commerce sont presque tous à 74 cm. La solution n'est pas de baisser le siège (tes bras seraient trop bas), mais de garder la bonne hauteur d'assise et d'ajouter un repose-pieds pour que tes pieds restent à plat. Un bureau réglable règle le problème à la source.",
  },
  {
    question: 'Faut-il vraiment que le haut de l’écran soit au niveau des yeux ?',
    answer:
      "Le haut de la dalle doit se situer à hauteur des yeux ou légèrement en dessous, pour que le regard descende naturellement plutôt que de forcer la nuque vers le haut. Sur un ordinateur portable posé directement sur le bureau, l'écran est toujours trop bas : un support ou un écran externe est le seul vrai remède.",
  },
  {
    question: 'Et pour la position debout ?',
    answer:
      "Le plateau doit arriver à hauteur de coudes debout, bras relâchés le long du corps et avant-bras à l'horizontale. L'écran monte d'autant. Debout, l'erreur la plus courante est un plateau trop bas, qui pousse à se pencher en avant.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculateur de hauteur de bureau ergonomique',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Tout navigateur',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  description:
    "Calcule la hauteur idéale de ton bureau (assis et debout), de ton siège et de ton écran à partir de ta taille.",
};
---

<BaseLayout
  title="Calculateur de hauteur de bureau idéale (assis et debout)"
  description="Entre ta taille : ce calculateur gratuit donne la hauteur idéale de ton bureau assis et debout, de ton siège et de ton écran, et te dit si ton bureau est trop haut."
  jsonLd={[appSchema, faqSchema]}
>
  <PageHead eyebrow="Outil gratuit · sans inscription" title="Quelle est la bonne hauteur pour ton bureau ?" lede="La quasi-totalité des bureaux vendus en France mesurent 74 cm — une hauteur pensée pour une personne d'environ 1,78 m. Si tu ne fais pas cette taille, ton poste est probablement mal réglé sans que tu le saches. Entre ta taille pour obtenir tes hauteurs." icon="ruler" crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Outils', href: '/outils/' }, { label: 'Calculateur de hauteur de bureau' }]} width="narrow" />
  <section class="container calc">

    <!-- ---------- Outil ---------- -->
    <div class="calc__tool">
      <div class="calc__field">
        <label for="taille">Ta taille</label>
        <div class="calc__inputs">
          <input type="range" id="taille-range" min="140" max="210" value="175" step="1"
                 aria-label="Ta taille en centimètres (curseur)" />
          <div class="calc__number">
            <input type="number" id="taille" min="140" max="210" value="175" step="1" inputmode="numeric" />
            <span>cm</span>
          </div>
        </div>
      </div>

      <div class="calc__results" id="results">
        <div class="calc__result">
          <p class="calc__result-label">Plateau du bureau <em>assis</em></p>
          <p class="calc__result-value"><span data-out="plateauAssis">73</span> cm</p>
          <p class="calc__result-hint"><span data-range="plateauAssis">71 – 75</span> cm</p>
        </div>
        <div class="calc__result">
          <p class="calc__result-label">Plateau du bureau <em>debout</em></p>
          <p class="calc__result-value"><span data-out="plateauDebout">109</span> cm</p>
          <p class="calc__result-hint"><span data-range="plateauDebout">107 – 111</span> cm</p>
        </div>
        <div class="calc__result">
          <p class="calc__result-label">Assise du siège</p>
          <p class="calc__result-value"><span data-out="assise">44</span> cm</p>
          <p class="calc__result-hint"><span data-range="assise">42 – 46</span> cm</p>
        </div>
        <div class="calc__result">
          <p class="calc__result-label">Haut de l'écran</p>
          <p class="calc__result-value"><span data-out="yeux">123</span> cm</p>
          <p class="calc__result-hint">au niveau des yeux, du sol</p>
        </div>
      </div>

      <p class="calc__verdict" id="verdict" role="status"></p>
    </div>

    <!-- ---------- Schéma : l'épure cotée suit la taille saisie ---------- -->
    <figure class="calc__figure">
      <EpurePoste taille={175} />
      <figcaption>
        Les trois hauteurs se mesurent toujours <strong>depuis le sol</strong>, plateau et assise
        compris.
      </figcaption>
    </figure>

    <!-- ---------- Vérifications ---------- -->
    <h2>Vérifier au ressenti, une fois réglé</h2>
    <p>
      Les chiffres donnent le point de départ ; ton corps donne la confirmation. Une fois installé,
      ces quatre repères doivent être vrais en même temps :
    </p>
    <ul class="calc__checks">
      <li>Tes <strong>coudes forment un angle d'environ 90°</strong>, épaules relâchées, quand tes mains sont sur le clavier.</li>
      <li>Tes <strong>poignets sont droits</strong>, jamais cassés vers le haut pour atteindre les touches.</li>
      <li>Tes <strong>pieds reposent à plat</strong> au sol, cuisses à peu près parallèles au sol.</li>
      <li>Ton <strong>regard descend légèrement</strong> vers l'écran, sans que tu aies à lever le menton.</li>
    </ul>
    <p class="calc__caveat">
      Ces valeurs sont calculées à partir de proportions moyennes du corps humain. À taille égale,
      la longueur des jambes varie&nbsp;: ajuste d'un ou deux centimètres après quelques jours
      d'essai. En cas de douleur persistante, un professionnel de santé reste le bon interlocuteur.
    </p>

    <!-- ---------- Aller plus loin ---------- -->
    <h2>Corriger ce qui ne va pas</h2>
    <div class="calc__links">
      <a class="calc__link" href="/articles/bureau-assis-debout-electrique/">
        <strong>Bureau assis-debout</strong>
        <span>La seule solution qui donne exactement les deux hauteurs calculées ici.</span>
        <Icon name="arrow" size={18} />
      </a>
      <a class="calc__link" href="/articles/repose-pieds-ergonomique-bureau/">
        <strong>Repose-pieds</strong>
        <span>Le correctif quand le bureau est trop haut et qu'on ne peut pas le baisser.</span>
        <Icon name="arrow" size={18} />
      </a>
      <a class="calc__link" href="/articles/support-ordinateur-portable-ergonomique/">
        <strong>Support pour portable</strong>
        <span>Pour remonter un écran de portable au niveau des yeux.</span>
        <Icon name="arrow" size={18} />
      </a>
      <a class="calc__link" href="/articles/bras-support-ecran-articule/">
        <strong>Bras d'écran articulé</strong>
        <span>Règle la hauteur de l'écran au centimètre près et libère le plateau.</span>
        <Icon name="arrow" size={18} />
      </a>
    </div>

    <!-- ---------- FAQ ---------- -->
    <h2>Questions fréquentes</h2>
    <div class="calc__faq">
      {faq.map((f) => (
        <details>
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>

    <p class="calc__share">
      Cet outil est en accès libre&nbsp;: n'hésite pas à le partager ou à y faire un lien. Une
      remarque, une erreur à signaler&nbsp;? Écris-nous à
      <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>.
    </p>
  </section>
</BaseLayout>

<script define:vars={{ RATIOS, BUREAU_STANDARD }}>
  (function () {
    var range = document.getElementById('taille-range');
    var number = document.getElementById('taille');
    var verdict = document.getElementById('verdict');
    var outs = document.querySelectorAll('[data-out]');
    var ranges = document.querySelectorAll('[data-range]');
    // Cotes de l'épure (EpurePoste) : même ratios, recalculés à chaque changement de taille
    var cotes = document.querySelectorAll('.calc__figure [data-ratio]');
    var reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function compute(taille) {
      var v = {};
      for (var key in RATIOS) v[key] = Math.round(RATIOS[key] * taille);
      return v;
    }

    function render(taille) {
      var v = compute(taille);

      outs.forEach(function (el) {
        el.textContent = v[el.getAttribute('data-out')];
      });
      ranges.forEach(function (el) {
        var k = el.getAttribute('data-range');
        el.textContent = v[k] - 2 + ' – ' + (v[k] + 2);
      });

      // Comparaison avec le bureau standard du commerce
      var ecart = BUREAU_STANDARD - v.plateauAssis;
      var msg;
      if (ecart >= 3) {
        msg =
          'Un bureau standard (74 cm) est <strong>trop haut de ' + ecart + ' cm</strong> pour toi. ' +
          'Garde la bonne hauteur d\'assise et ajoute un repose-pieds, ou passe à un plateau réglable.';
        verdict.className = 'calc__verdict calc__verdict--warn';
      } else if (ecart <= -3) {
        msg =
          'Un bureau standard (74 cm) est <strong>trop bas de ' + Math.abs(ecart) + ' cm</strong> pour toi. ' +
          'Il faut le surélever (rehausseurs) ou choisir un modèle réglable en hauteur.';
        verdict.className = 'calc__verdict calc__verdict--warn';
      } else {
        msg =
          'Bonne nouvelle&nbsp;: un bureau standard (74 cm) ' +
          (ecart === 0
            ? 'correspond <strong>exactement</strong> à ta taille.'
            : 'te convient, à <strong>' + Math.abs(ecart) + ' cm près</strong>.') +
          ' Concentre-toi sur le réglage du siège et de l\'écran.';
        verdict.className = 'calc__verdict calc__verdict--ok';
      }
      verdict.innerHTML = msg;

      // Règle graduée : le jaune se déroule jusqu'au curseur
      range.style.setProperty('--p', ((taille - 140) / 70) * 100 + '%');

      // Épure : chaque valeur recalculée s'éclaire en jaune pendant 400 ms
      cotes.forEach(function (el) {
        var val = String(Math.round(parseFloat(el.getAttribute('data-ratio')) * taille));
        if (el.textContent === val) return;
        el.textContent = val;
        var g = el.closest('.cote-label');
        if (g && !reduit) {
          g.classList.remove('is-new');
          void g.getBBox();
          g.classList.add('is-new');
          clearTimeout(g._t);
          g._t = setTimeout(function () { g.classList.remove('is-new'); }, 400);
        }
      });
    }

    function sync(value, source) {
      var t = parseInt(value, 10);
      if (isNaN(t)) return;
      t = Math.min(210, Math.max(140, t));
      if (source !== 'range') range.value = t;
      if (source !== 'number') number.value = t;
      render(t);
    }

    range.addEventListener('input', function () { sync(range.value, 'range'); });
    number.addEventListener('input', function () { sync(number.value, 'number'); });
    number.addEventListener('blur', function () { sync(number.value, ''); });

    render(parseInt(range.value, 10));
  })();
</script>

<style>
  .calc { padding-top: 2.6rem; padding-bottom: 4.5rem; }
  .calc h2 { margin: 3.2rem 0 0.8rem; font-size: clamp(1.5rem, 1.2rem + 1vw, 1.9rem); }

  /* ---- Outil : un curseur à piste arrondie, un champ pilule, quatre cartes de résultat ---- */
  .calc__tool { margin: 0 0 2.6rem; }
  .calc__field { display: flex; flex-direction: column; gap: 0.6rem; }
  .calc__field label { font-weight: 700; font-size: 0.95rem; color: var(--mine); }
  .calc__inputs { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.6rem; }

  /* Curseur : piste arrondie sur papier-2, lime jusqu'au curseur, poignée ronde */
  .calc__inputs input[type='range'] { --p: 50%; flex: 1 1 260px; min-width: 0; height: 44px; margin: 0; background: transparent; cursor: pointer; -webkit-appearance: none; appearance: none; }
  .calc__inputs input[type='range']::-webkit-slider-runnable-track { height: 10px; border-radius: 5px; background: linear-gradient(var(--jaune), var(--jaune)) left center / var(--p) 100% no-repeat, var(--papier-2); }
  .calc__inputs input[type='range']::-moz-range-track { height: 10px; border-radius: 5px; background: linear-gradient(var(--jaune), var(--jaune)) left center / var(--p) 100% no-repeat, var(--papier-2); }
  .calc__inputs input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; box-sizing: border-box; width: 26px; height: 26px; margin-top: -8px; background: var(--mine); border: 4px solid var(--papier); border-radius: 50%; box-shadow: var(--ombre); }
  .calc__inputs input[type='range']::-moz-range-thumb { box-sizing: border-box; width: 26px; height: 26px; background: var(--mine); border: 4px solid var(--papier); border-radius: 50%; box-shadow: var(--ombre); }
  .calc__inputs input[type='range']:focus-visible { outline: 3px solid var(--jaune); outline-offset: 4px; box-shadow: none; border-radius: 999px; }

  /* Champ : pilule papier à filet, valeur en Unbounded ; au focus, filet et anneau lime */
  .calc__number { flex: none; display: inline-flex; align-items: baseline; gap: 0.35rem; padding: 0.35rem 1.1rem 0.35rem 1.2rem; background: var(--papier); border: 1px solid var(--filet); border-radius: 999px; box-shadow: var(--ombre); transition: border-color 0.18s ease, box-shadow 0.18s ease; }
  .calc__number:focus-within { border-color: var(--jaune); box-shadow: 0 0 0 3px var(--jaune-pale); }
  .calc__number input { width: 3.4ch; padding: 0; border: 0; background: transparent; color: var(--mine); font-family: var(--font-display); font-weight: 800; font-size: 1.6rem; line-height: 1.2; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; -moz-appearance: textfield; appearance: textfield; }
  .calc__number input::-webkit-outer-spin-button, .calc__number input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .calc__number input:focus { outline: none; box-shadow: none; }
  .calc__number span { font-family: var(--font-mono); font-size: 0.95rem; color: var(--gris); }

  /* Résultats : quatre cartes papier, la valeur en Unbounded 800, l'unité et la plage en mono */
  .calc__results { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.8rem; margin: 1.8rem 0 0; }
  .calc__result { min-width: 0; padding: 0.9rem 1rem 1rem; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); box-shadow: var(--ombre); }
  .calc__result-label { margin: 0; font-weight: 600; font-size: 0.82rem; line-height: 1.35; color: var(--gris); }
  .calc__result-label em { font-style: normal; font-weight: 700; color: var(--mine); }
  .calc__result-value { margin: 0.5rem 0 0.25rem; font-family: var(--font-mono); font-size: 0.9rem; line-height: 1; color: var(--gris); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .calc__result-value span { font-family: var(--font-display); font-weight: 800; font-size: 2rem; letter-spacing: -0.03em; color: var(--mine); }
  .calc__result-hint { margin: 0; font-family: var(--font-mono); font-size: 0.78rem; line-height: 1.4; color: var(--gris); font-variant-numeric: tabular-nums; }

  /* Verdict : une bande arrondie sur papier-2 ; l'écart mesuré est surligné en lime */
  .calc__verdict { max-width: 60ch; margin: 1.4rem 0 0; padding: 0.9rem 1.1rem; background: var(--papier-2); border-radius: var(--radius); font-size: 1rem; line-height: 1.6; }
  .calc__verdict:empty { display: none; }
  .calc__verdict :global(strong) { padding: 0 0.2em; border-radius: 4px; }
  .calc__verdict--warn :global(strong) { background: var(--jaune); color: var(--sur-jaune); }
  .calc__verdict--ok :global(strong) { background: var(--jaune-pale); }

  /* ---- Schéma ---- */
  .calc__figure { margin: 0; }
  .calc__figure figcaption { margin-top: 0.8rem; font-size: 0.88rem; line-height: 1.55; color: var(--gris); }
  .calc__figure figcaption strong { color: var(--mine); }

  /* ---- Repères au ressenti : une carte papier, une ligne par repère, puce lime ---- */
  .calc__checks { list-style: none; margin: 1.2rem 0 0; padding: 0.2rem 1.2rem; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); box-shadow: var(--ombre); }
  .calc__checks li { position: relative; padding: 0.8rem 0.2rem 0.8rem 1.5rem; line-height: 1.55; }
  .calc__checks li + li { border-top: 1px solid var(--filet); }
  .calc__checks li::before { content: ''; position: absolute; left: 0.2rem; top: 1.45rem; width: 0.55em; height: 0.55em; border-radius: 50%; background: var(--jaune); }
  .calc__caveat { margin: 1.4rem 0 0; font-size: 0.9rem; line-height: 1.6; color: var(--gris); }

  /* ---- Liens : quatre cartes papier, flèche en pastille ---- */
  .calc__links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .calc__link { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto 1fr; align-items: start; gap: 0.35rem 1rem; padding: 1.1rem 1.2rem 1.2rem; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); box-shadow: var(--ombre); color: var(--mine); text-decoration: none; transition: transform 0.3s var(--ease-out), box-shadow 0.3s ease; }
  .calc__link:hover { transform: translateY(-4px); box-shadow: var(--ombre-2); }
  .calc__link strong { font-family: var(--font-display); font-weight: 700; font-size: 1rem; line-height: 1.3; letter-spacing: -0.02em; }
  .calc__link span { grid-column: 1; font-size: 0.92rem; line-height: 1.5; color: var(--gris); }
  .calc__link :global(svg) { grid-column: 2; grid-row: 1 / span 2; align-self: center; width: 36px; height: 36px; padding: 9px; border-radius: 50%; border: 1px solid var(--filet); transition: transform 0.18s var(--ease-out), background-color 0.18s ease, border-color 0.18s ease; }
  .calc__link:hover :global(svg) { transform: translateX(4px); background: var(--jaune); border-color: var(--jaune); color: var(--sur-jaune); }

  /* ---- FAQ : accordéon en cartes papier, signe plus sur pastille lime pâle ---- */
  .calc__faq { display: grid; gap: 0.6rem; }
  .calc__faq details { padding: 0 1.2rem; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); }
  .calc__faq summary { display: flex; align-items: center; gap: 1rem; padding: 1rem 0; cursor: pointer; list-style: none; font-weight: 600; font-size: 1.02rem; line-height: 1.4; }
  .calc__faq summary::-webkit-details-marker { display: none; }
  .calc__faq summary::after { content: ''; flex-shrink: 0; width: 28px; height: 28px; margin-left: auto; border-radius: 50%; background: linear-gradient(var(--mine), var(--mine)) center / 12px 2px no-repeat, linear-gradient(var(--mine), var(--mine)) center / 2px 12px no-repeat, var(--jaune-pale); }
  .calc__faq details[open] > summary::after { background: linear-gradient(var(--mine), var(--mine)) center / 12px 2px no-repeat, var(--jaune-pale); }
  .calc__faq p { margin: 0 0 1.1rem; padding-right: 2rem; line-height: 1.65; color: var(--gris); }

  .calc__share { margin-top: 2.6rem; font-size: 0.9rem; color: var(--gris); }

  @media (max-width: 600px) {
    .calc__links { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .calc__results { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
    .calc__result { padding: 0.8rem 0.85rem 0.9rem; }
    .calc__result-value span { font-size: 1.7rem; }
    .calc__number input { font-size: 1.4rem; }
    .calc__checks { padding: 0.2rem 1rem; }
  }
</style>
