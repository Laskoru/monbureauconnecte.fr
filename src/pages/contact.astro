---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../siteConfig';
---

<BaseLayout
  title="Contact"
  description={`Contacter ${siteConfig.name} : question, suggestion de comparatif ou signalement.`}
>
  <PageHead eyebrow="Contact" title="Nous écrire" lede="Une question sur un article, une erreur à signaler, un produit ou une idée de comparatif à nous soumettre ? On lit tous les messages avec plaisir." width="narrow" />
  <section class="container contact">

    <a class="btn btn--primary contact__cta" href={`mailto:${siteConfig.contactEmail}`}>
      <Icon name="mail" size={18} /> {siteConfig.contactEmail}
    </a>

    <div class="contact__cards">
      <div class="contact__card">
        <h2>Suggérer un comparatif</h2>
        <p>Un accessoire de bureau, gaming ou télétravail que tu aimerais voir comparé ? Dis-le-nous, ça
          nous aide à choisir les prochains sujets.</p>
      </div>
      <div class="contact__card">
        <h2>Signaler une erreur</h2>
        <p>Un prix qui a changé, un lien cassé, une info à corriger ? Merci de nous prévenir : on tient à
          garder les articles à jour.</p>
      </div>
      <div class="contact__card">
        <h2>Partenariats</h2>
        <p>Pour toute proposition, écris-nous à la même adresse en précisant l'objet. On répond aux
          demandes sérieuses et compatibles avec notre indépendance éditoriale.</p>
      </div>
    </div>

    <p class="contact__note">
      Réponse généralement sous quelques jours. Pour les demandes relatives à tes données personnelles,
      consulte notre <a href="/politique-de-confidentialite/">politique de confidentialité</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .contact { padding-top: 2.6rem; padding-bottom: 4.5rem; }
  .contact__cta { max-width: 100%; margin: 0 0 2.6rem; white-space: normal; overflow-wrap: anywhere; }
  /* Les motifs d'écriture en lignes réglées : intitulé à gauche, détail à droite */
  .contact__cards { border-top: 1.5px solid var(--mine); }
  .contact__card { display: grid; grid-template-columns: minmax(0, 13rem) minmax(0, 1fr); gap: 0.4rem 1.6rem; padding: 1rem 0.2rem 1.1rem; border-bottom: 1px solid var(--filet); }
  .contact__card h2 { margin: 0; font-family: var(--font-body); font-stretch: 100%; font-weight: 600; font-size: 1.05rem; line-height: 1.4; letter-spacing: -0.005em; }
  .contact__card p { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--gris); }
  .contact__note { margin-top: 2rem; font-size: 0.9rem; color: var(--gris); }
  @media (max-width: 600px) { .contact__card { grid-template-columns: 1fr; } }
</style>
