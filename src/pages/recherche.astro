---
// Recherche interne : interface maison légère au-dessus de l'index Pagefind (dist/pagefind/),
// généré après le build (`npm run build` = astro build && pagefind --site dist).
// Seuls les comparatifs, conseils, guides, budgets et outils sont indexés (data-pagefind-body
// posé par BaseLayout via la prop `search`). Page en noindex et hors sitemap (astro.config.mjs).
// L'adresse /recherche/?q=chaise lance directement la recherche.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';

const suggestions = ['chaise', 'mal de dos', 'clavier', 'webcam', 'bureau assis-debout', 'PC gaming'];
---

<BaseLayout title="Rechercher sur le site" description="Cherche un comparatif, un conseil, un guide ou un outil sur Mon Bureau Connecté." noindex>
  <PageHead title="Rechercher" lede="Un produit, une douleur, une mesure : tape ce que tu cherches, les comparatifs, guides et outils correspondants s'affichent." crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Recherche' }]} width="narrow" />

  <section class="container srch">
    <form class="srch__form" action="/recherche/" method="get" role="search">
      <label class="visually-hidden" for="srch-q">Rechercher sur le site</label>
      <Icon name="search" size={20} class="srch__ico" />
      <input class="srch__input" id="srch-q" name="q" type="search" autocomplete="off" spellcheck="false" enterkeyhint="search" placeholder="Ex. chaise, clavier, mal de dos" />
    </form>

    <div class="srch__hints" id="srch-hints">
      <p class="srch__hints-title">Essaie :</p>
      <ul>
        {suggestions.map((s) => <li><a class="chip srch__chip" href={`/recherche/?q=${encodeURIComponent(s)}`} data-q={s}>{s}</a></li>)}
      </ul>
    </div>

    <p class="srch__status" id="srch-status" role="status" aria-live="polite"></p>
    <ol class="srch__results" id="srch-results"></ol>

    <div class="srch__empty" id="srch-empty" hidden>
      <p>Rien ne correspond. Essaie un mot plus court ou plus courant (« chaise » plutôt que « fauteuil ergonomique réglable »), ou pars de ton besoin :</p>
      <p class="srch__empty-links"><a class="btn btn--outline btn--sm" href="/guides/">Guides par besoin</a> <a class="btn btn--outline btn--sm" href="/articles/">Tous les comparatifs</a></p>
    </div>

    <noscript><p class="srch__status">La recherche a besoin de JavaScript. Tu peux parcourir les <a href="/guides/">guides par besoin</a> ou <a href="/articles/">tous les comparatifs</a>.</p></noscript>
  </section>
</BaseLayout>

<script is:inline type="module">
  const form = document.querySelector('.srch__form');
  const input = document.getElementById('srch-q');
  const status = document.getElementById('srch-status');
  const list = document.getElementById('srch-results');
  const empty = document.getElementById('srch-empty');
  const hints = document.getElementById('srch-hints');
  const MAX = 20;
  let pagefind = null;

  async function load() {
    if (pagefind) return pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.options({ excerptLength: 26 });
      pagefind.init();
    } catch (e) {
      pagefind = null;
      status.textContent = 'La recherche est indisponible pour le moment (index introuvable).';
    }
    return pagefind;
  }

  function syncUrl(q) {
    const url = new URL(location.href);
    if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  }

  function render(items, total, q) {
    list.replaceChildren();
    empty.hidden = total > 0;
    status.textContent = total === 0
      ? `Aucun résultat pour « ${q} ».`
      : `${total} résultat${total > 1 ? 's' : ''} pour « ${q} »${total > items.length ? ` (les ${items.length} plus pertinents)` : ''}.`;
    for (const d of items) {
      const li = document.createElement('li');
      li.className = 'srch__item';
      const a = document.createElement('a');
      a.className = 'srch__link';
      a.href = d.url;
      a.textContent = d.meta.title || d.url;
      const h = document.createElement('h2');
      h.className = 'srch__title';
      h.append(a);
      const p = document.createElement('p');
      p.className = 'srch__excerpt';
      p.innerHTML = d.excerpt; // extrait échappé par Pagefind, seuls les <mark> sont du HTML
      li.append(h, p);
      if (d.meta.type) {
        const t = document.createElement('p');
        t.className = 'srch__type';
        t.textContent = d.meta.type;
        li.append(t);
      }
      list.append(li);
    }
  }

  async function run(q, immediate) {
    q = q.trim();
    syncUrl(q);
    hints.hidden = q.length > 0;
    if (!q) { list.replaceChildren(); empty.hidden = true; status.textContent = ''; return; }
    const pf = await load();
    if (!pf) return;
    const search = immediate ? await pf.search(q) : await pf.debouncedSearch(q, {}, 220);
    if (search === null || input.value.trim() !== q) return; // remplacée par une frappe plus récente
    const items = await Promise.all(search.results.slice(0, MAX).map((r) => r.data()));
    if (input.value.trim() !== q) return;
    render(items, search.results.length, q);
  }

  input.addEventListener('input', () => run(input.value, false));
  form.addEventListener('submit', (e) => { e.preventDefault(); run(input.value, true); });
  hints.addEventListener('click', (e) => {
    const chip = e.target.closest('[data-q]');
    if (!chip) return;
    e.preventDefault();
    input.value = chip.dataset.q;
    run(input.value, true);
    input.focus();
  });

  const initial = new URLSearchParams(location.search).get('q') || '';
  if (initial) { input.value = initial; run(initial, true); }
  else { input.focus({ preventScroll: true }); load(); }
</script>

<!-- Styles globaux : les résultats sont créés en JS, sans l'attribut de portée d'Astro. Classes préfixées srch__. -->
<style is:global>
  .srch .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .srch { min-height: 42vh; padding-bottom: clamp(3rem, 6vw, 5rem); }
  .srch__form { position: relative; }
  .srch__form .srch__ico { position: absolute; left: 1.1rem; top: 50%; transform: translateY(-50%); color: var(--gris); pointer-events: none; }
  .srch__input { width: 100%; min-height: 56px; padding: 0 1.2rem 0 3.1rem; font: 500 1.0625rem/1.2 var(--font-body); color: var(--mine); background: var(--papier); border: 1.5px solid var(--filet); border-radius: 999px; box-shadow: var(--ombre); transition: border-color 0.18s ease; -webkit-appearance: none; appearance: none; }
  .srch__input::placeholder { color: var(--gris); opacity: 1; }
  .srch__input:hover { border-color: var(--filet-fort); }
  .srch .srch__input:focus, .srch .srch__input:focus-visible { outline: none; border-radius: 999px; border-color: var(--jaune); box-shadow: 0 0 0 3px var(--jaune-pale), var(--ombre); }
  .srch__input::-webkit-search-cancel-button { cursor: pointer; }

  .srch__hints { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.8rem; margin-top: 1.2rem; }
  .srch__hints[hidden] { display: none; }
  .srch__hints-title { margin: 0; font-size: 0.85rem; font-weight: 600; color: var(--gris); }
  .srch__hints ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .srch__chip { min-height: 40px; padding: 0.45em 0.95em; font-size: 0.9rem; }
  .srch__chip:hover { border-color: var(--mine); text-decoration: none; }

  .srch__status { margin: 1.6rem 0 0.9rem; font-size: 0.95rem; color: var(--gris); }
  .srch__status:empty { margin: 0; }
  .srch__results { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .srch__item { position: relative; padding: 1.1rem 1.3rem 1.15rem; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); box-shadow: var(--ombre); transition: box-shadow 0.18s ease, border-color 0.18s ease; overflow-wrap: anywhere; }
  .srch__item:hover { border-color: var(--filet-fort); box-shadow: var(--ombre-2); }
  .srch__title { margin: 0 0 0.45rem; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; line-height: 1.25; letter-spacing: -0.01em; }
  .srch__link { color: var(--mine); text-decoration: none; }
  .srch__link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; } /* toute la carte est cliquable */
  .srch__link:hover { text-decoration-line: underline; } /* épaisseur et couleur : règle a:hover du site */
  .srch__excerpt { margin: 0; font-size: 0.98rem; line-height: 1.55; color: var(--gris); }
  .srch__excerpt mark { background: var(--jaune); color: var(--sur-jaune); padding: 0 0.1em; border-radius: 3px; }
  .srch__type { margin: 0.6rem 0 0; font-family: var(--font-mono); font-size: 0.78rem; font-weight: 500; color: var(--gris); }

  .srch__empty { margin-top: 0.4rem; padding: 1.2rem 1.3rem; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); }
  .srch__empty p { margin: 0; line-height: 1.55; }
  .srch__empty-links { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem !important; }

  @media (max-width: 640px) {
    .srch__item { padding: 1rem 1.05rem; }
    .srch__title { font-size: 1.05rem; }
  }
  @media (prefers-reduced-motion: reduce) { .srch__item, .srch__input { transition: none; } }
</style>
