---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { siteConfig } from '../siteConfig';

const personSameAs = [siteConfig.social?.pinterest, siteConfig.social?.flipboard].filter(Boolean);
const authorName = siteConfig.author; // "Hugo B."
const siteUrl = Astro.site?.origin ?? Astro.url.origin;

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const recent = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const initials = authorName
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();

// Données structurées : page profil + personne rattachée à l'organisation.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    '@id': `${siteUrl}/auteur/#person`,
    name: authorName,
    url: `${siteUrl}/auteur/`,
    ...(personSameAs.length ? { sameAs: personSameAs } : {}),
    jobTitle: 'Fondateur et rédacteur',
    worksFor: { '@id': `${siteUrl}/#organization` },
    knowsAbout: ['ergonomie du poste de travail', 'matériel de bureau', 'télétravail', 'périphériques gaming'],
  },
};
---

<BaseLayout
  title={`${authorName} — auteur`}
  description={`${authorName}, fondateur et rédacteur de ${siteConfig.name}. Qui écrit les comparatifs, avec quelle méthode et en toute indépendance.`}
  jsonLd={jsonLd}
>
  <section class="container author">
    <div class="author__head">
      <div class="author__avatar" aria-hidden="true">{initials}</div>
      <div>
        <h1>{authorName}</h1>
        <p class="author__role">Fondateur &amp; rédacteur de {siteConfig.name}</p>
      </div>
    </div>

    <div class="author__bio">
      <p>
        Bonjour, je suis Hugo, la personne derrière {siteConfig.name}. J'ai lancé ce site pour une raison
        simple : choisir du bon matériel de bureau, de télétravail ou de gaming est devenu un casse-tête, entre
        le marketing, les faux avis et les milliers de références qui se ressemblent.
      </p>
      <p>
        Mon travail, ce n'est pas de tester chaque produit en laboratoire — je préfère être honnête là-dessus
        plutôt que de le prétendre. C'est de <strong>comparer méthodiquement</strong> les caractéristiques qui
        comptent vraiment à l'usage (plage de réglage, charge, autonomie, niveau sonore…), de croiser des
        <strong>retours d'utilisateurs réels</strong>, et d'en tirer des recommandations claires, pour un profil
        et un budget donnés — plutôt que de désigner un « meilleur » universel qui n'existe pas.
      </p>
      <p>
        Le site est <strong>100 % indépendant</strong> : aucune marque ne paie pour figurer ou être mieux
        classée. {siteConfig.name} se finance uniquement via l'affiliation Amazon — si tu achètes après avoir
        cliqué sur un lien, je touche une petite commission, <strong>sans aucun surcoût pour toi</strong>. Ça ne
        change jamais mon avis : quand un produit a des défauts, je le dis.
      </p>
      <p class="author__links">
        <a class="btn btn--outline" href="/a-propos/">Notre méthode en détail</a>
        <a class="btn btn--outline" href="/contact/">Me contacter</a>
      </p>
    </div>

    <h2 class="author__section">Les derniers comparatifs</h2>
    <div class="article-list">
      {recent.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .author { padding-top: 2.6rem; padding-bottom: 4.5rem; }
  .author__head { display: flex; align-items: center; gap: 1.4rem; }
  /* Monogramme sur pastille ronde lime pâle, initiales en Unbounded */
  .author__avatar {
    flex-shrink: 0;
    width: 84px; height: 84px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--jaune-pale); color: var(--mine); border-radius: 50%;
    font-family: var(--font-display); font-weight: 800; font-size: 1.7rem; line-height: 1; letter-spacing: -0.03em;
  }
  .author__head h1 { margin: 0 0 0.3rem; font-size: clamp(2.1rem, 1.2rem + 3vw, 3.4rem); }
  .author__role { margin: 0; font-size: 1.05rem; color: var(--gris); }
  .author__bio { margin-top: 2rem; padding-top: 1.6rem; border-top: 1px solid var(--filet); }
  .author__bio p { color: var(--gris); line-height: 1.75; }
  .author__bio strong { color: var(--mine); }
  .author__links { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.6rem; }
  .author__section { margin: 3.5rem 0 0; font-size: clamp(1.5rem, 1.2rem + 1vw, 1.9rem); }
  .article-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2.4rem 2rem; margin-top: 1.6rem; }
  @media (max-width: 520px) {
    .author__head { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .author__avatar { width: 64px; height: 64px; font-size: 1.3rem; }
  }
</style>
