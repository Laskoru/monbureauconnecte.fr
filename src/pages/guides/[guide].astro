---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { guides } from '../../guides';

export async function getStaticPaths() {
  return guides.map((guide) => ({ params: { guide: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const bySlug = new Map(allArticles.map((a) => [a.slug, a]));
// On respecte l'ordre défini dans guides.ts, en ignorant les slugs absents.
const articles = guide.articles.map((slug) => bySlug.get(slug)).filter((a) => a !== undefined);
const otherGuides = guides.filter((g) => g.slug !== guide.slug);
---

<BaseLayout title={guide.title} description={guide.description} noindex={articles.length === 0}>
  <PageHead
    eyebrow="Guide par besoin"
    title={guide.title}
    lede={guide.description}
    icon={guide.slug}
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Par besoin', href: '/guides/' }, { label: guide.title }]}
    count={String(articles.length).padStart(2, '0')}
  />

  <section class="wide g">
    <div class="g__grid">
      <div class="g__main">
        <div class="g__intro">
          {guide.intro.map((p) => <p set:html={p} />)}
        </div>

        <h2 class="g__section">Les comparatifs à lire</h2>
        <ol class="g__steps">
          {articles.map((article, i) => (
            <li class="g__step">
              <span class="g__step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="g__step-card"><ArticleCard article={article} variant="row" /></div>
            </li>
          ))}
        </ol>
      </div>

      <aside class="g__side">
        <div class="g__box">
          <p class="g__box-title"><Icon name="map" size={16} /> Autres chemins</p>
          {otherGuides.map((g) => (
            <a class="g__link" href={`/guides/${g.slug}/`}><Icon name={g.slug} size={18} /> <span>{g.title}</span> <Icon name="arrow" size={14} /></a>
          ))}
        </div>
        <div class="g__box g__box--tool">
          <p class="g__box-title"><Icon name="ruler" size={16} /> Outil gratuit</p>
          <p class="g__box-text">Ta taille → la hauteur de ton bureau, de ton siège et de ton écran. Réponse en deux secondes.</p>
          <a class="btn btn--primary btn--sm" href="/calculateur-hauteur-bureau/">Calculer ma hauteur</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .g { padding-top: 2.6rem; padding-bottom: 4.5rem; }
  .g__grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 3.5rem; align-items: start; }
  .g__intro { font-size: 1.08rem; line-height: 1.7; max-width: 66ch; }
  .g__intro p { margin: 0 0 1em; }
  .g__section { margin: 2.4rem 0 1rem; font-size: clamp(1.5rem, 1.15rem + 1.2vw, 2.1rem); }
  /* L'ordre de lecture en lignes réglées : le rang en mono, puis le comparatif */
  .g__steps { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--mine); }
  .g__step { display: grid; grid-template-columns: 2.6rem minmax(0, 1fr); align-items: center; gap: 0 0.6rem; border-bottom: 1px solid var(--filet); }
  .g__step-num { padding-left: 0.3rem; font-family: var(--font-mono); font-size: 0.8rem; color: var(--gris); font-variant-numeric: tabular-nums; }
  .g__step-card { min-width: 0; }
  .g__step :global(.row) { border-top: 0; }
  /* Colonne latérale : blocs réglés (filet mine en tête), liens en lignes à filets */
  .g__side { position: sticky; top: 88px; display: flex; flex-direction: column; gap: 2rem; }
  .g__box { display: flex; flex-direction: column; padding-top: 0.9rem; border-top: 1.5px solid var(--mine); }
  .g__box-title { display: flex; align-items: center; gap: 0.5em; margin: 0 0 0.5rem; font-weight: 600; font-size: 1rem; line-height: 1.3; color: var(--mine); }
  .g__box-text { margin: 0 0 1rem; font-size: 0.93rem; line-height: 1.55; color: var(--gris); }
  .g__box .btn { align-self: flex-start; }
  .g__link { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.7rem; padding: 0.65rem 0.3rem; border-bottom: 1px solid var(--filet); text-decoration: none; color: var(--mine); font-weight: 600; font-size: 0.95rem; line-height: 1.35; transition: background-color 0.18s ease; }
  .g__link:hover { background: var(--jaune-pale); }
  @media (max-width: 960px) { .g__grid { grid-template-columns: 1fr; } .g__side { position: static; } }
  @media (max-width: 480px) { .g__step { grid-template-columns: 2rem minmax(0, 1fr); } .g__step-num { padding-left: 0.1rem; } }
</style>
