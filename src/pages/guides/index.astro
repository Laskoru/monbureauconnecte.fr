---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../siteConfig';
import { guides } from '../../guides';

const published = new Set((await getCollection('articles', ({ data }) => !data.draft)).map((a) => a.slug));
const guideCounts = guides.map((g) => ({
  ...g,
  count: g.articles.filter((slug) => published.has(slug)).length,
}));
---

<BaseLayout
  title="Guides par besoin"
  description={`Nos comparatifs rangés par problème concret : télétravail, setup gaming, ergonomie, mal de dos, poignets, petit bureau. ${siteConfig.name}.`}
>
  <PageHead
    eyebrow="Navigation par besoin"
    title="Par où commencer ?"
    lede="Chaque guide part d'un problème concret — un dos qui tire, des poignets qui chauffent, un bureau trop petit — et te dit quoi lire, dans quel ordre. Choisis ton parcours."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Par besoin' }]}
  />

  <section class="wide gi">
    <div class="gi__list">
      {guideCounts.map((guide) => (
        <article class="gi__row">
          <h2 class="gi__title"><a class="stretched-link" href={`/guides/${guide.slug}/`}>{guide.title}</a></h2>
          <p class="gi__desc">{guide.description}</p>
          <p class="gi__count">{guide.count} comparatif{guide.count > 1 ? 's' : ''} à suivre</p>
          <Icon name="arrow" size={24} class="gi__fleche" />
        </article>
      ))}
    </div>

    <div class="gi__tools">
      <h2 class="gi__tools-title">Et pour trancher vite</h2>
      <div class="gi__tools-links">
        <a class="btn btn--primary" href="/calculateur-hauteur-bureau/"><Icon name="ruler" size={18} /> Calculer ma hauteur de bureau</a>
        <a class="btn btn--outline" href="/checklist-bureau-ergonomique/"><Icon name="checklist" size={18} /> Checklist ergonomie</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .gi { padding-top: 2.6rem; padding-bottom: 4.5rem; }
  /* Les parcours en cartes papier : le problème en grand, le compte en mono, flèche en pastille */
  .gi__list { display: grid; gap: 1rem; }
  .gi__row { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto auto; grid-template-areas: 'title count fleche' 'desc count fleche'; align-items: center; gap: 0.45rem 2rem; padding: 1.4rem 1.6rem 1.5rem; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); box-shadow: var(--ombre); transition: transform 0.3s var(--ease-out), box-shadow 0.3s ease; }
  .gi__row:hover, .gi__row:focus-within { transform: translateY(-4px); box-shadow: var(--ombre-2); }
  .gi__title { grid-area: title; margin: 0; font-size: clamp(1.25rem, 1rem + 1.1vw, 1.8rem); line-height: 1.1; }
  .gi__title a { color: var(--mine); text-decoration: none; }
  .gi__desc { grid-area: desc; max-width: 70ch; margin: 0; font-size: 0.98rem; line-height: 1.55; color: var(--gris); }
  .gi__count { grid-area: count; margin: 0; font-family: var(--font-mono); font-size: 0.8rem; color: var(--gris); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .gi__row :global(.gi__fleche) { grid-area: fleche; width: 44px; height: 44px; padding: 10px; border-radius: 50%; border: 1px solid var(--filet); transition: transform 0.2s var(--ease-out), background-color 0.18s ease, border-color 0.18s ease; }
  .gi__row:hover :global(.gi__fleche) { transform: translateX(4px); background: var(--jaune); border-color: var(--jaune); color: var(--sur-jaune); }

  .gi__tools { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.2rem 2rem; margin-top: clamp(3rem, 6vw, 4.5rem); padding-top: 2rem; border-top: 1px solid var(--filet); }
  .gi__tools-title { margin: 0; font-size: clamp(1.6rem, 1.15rem + 1.5vw, 2.4rem); }
  .gi__tools-links { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  @media (max-width: 720px) {
    .gi__row { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'title fleche' 'desc fleche' 'count fleche'; gap: 0.4rem 1rem; padding: 1.1rem 1.2rem 1.2rem; }
  }
</style>
