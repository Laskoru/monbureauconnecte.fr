---
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import { siteConfig } from '../siteConfig';
import { searchUrl } from '../lib/availability';

// Une recherche Amazon par composant plutôt qu'une fiche produit précise :
// le CPU/GPU est la catégorie qui bouge le plus vite (prix, stocks, nouveaux
// modèles chaque trimestre) — un lien de recherche bien ciblé ne meurt
// jamais et reste pertinent bien plus longtemps qu'un ASIN figé.
//
// Structure inspirée des guides d'achat qui fonctionnent (TopAchat, etc.) :
// chaque palier a une personnalité propre (badge), une ligne de specs lisible
// d'un coup d'œil, et un vrai raisonnement — pas juste une liste de liens.
const tiers = [
  {
    id: 'budget-800',
    badge: 'Le meilleur prix',
    price: '≈ 950 €',
    specLine: 'Ryzen 5 5600 (AM4) + RTX 4060 8 Go + 16 Go DDR4 + SSD 500 Go',
    reasoning:
      "La plateforme AM4, plus ancienne, coûte nettement moins cher que l'AM5/DDR5 actuel — de quoi mettre l'essentiel du budget sur la carte graphique, le poste qui compte vraiment pour les FPS. De quoi jouer confortablement en 1080p sur la plupart des jeux récents.",
    parts: [
      { icon: 'cpu', label: 'CPU', name: 'AMD Ryzen 5 5600', search: 'AMD Ryzen 5 5600 AM4' },
      { icon: 'board', label: 'Carte mère', name: 'B550 (AM4, DDR4)', search: 'carte mère B550 AM4 DDR4' },
      { icon: 'ram', label: 'RAM', name: '16 Go DDR4 3200 MHz', search: 'RAM DDR4 16 Go 3200 MHz' },
      { icon: 'gpu', label: 'GPU', name: 'RTX 4060 8 Go', search: 'carte graphique RTX 4060 8 Go' },
      { icon: 'ssd', label: 'SSD', name: '500 Go NVMe PCIe 3.0', search: 'SSD NVMe 500 Go PCIe 3.0' },
      { icon: 'psu', label: 'Alimentation', name: '550 W 80+ Bronze', search: 'alimentation PC 550W 80+ Bronze' },
      { icon: 'tower', label: 'Boîtier', name: 'ATX, entrée de gamme', search: 'boîtier PC ATX pas cher' },
    ],
  },
  {
    id: 'budget-1000',
    badge: 'Le bon compromis',
    price: '≈ 1250 €',
    specLine: 'Ryzen 5 8400F (AM5) + RTX 4060 8 Go + 16 Go DDR5 + SSD 1 To',
    reasoning:
      "Le premier palier sur la plateforme actuelle (AM5, DDR5) : un CPU accessible et une carte mère d'entrée de gamme suffisent, ce qui laisse le budget se concentrer sur la même carte graphique que le palier précédent. L'avantage : une vraie marge pour upgrader le processeur dans quelques années sans tout changer.",
    parts: [
      { icon: 'cpu', label: 'CPU', name: 'AMD Ryzen 5 8400F', search: 'AMD Ryzen 5 8400F AM5' },
      { icon: 'board', label: 'Carte mère', name: 'A620 (AM5, DDR5, Micro-ATX)', search: 'carte mère A620 AM5 DDR5 Micro-ATX' },
      { icon: 'ram', label: 'RAM', name: '16 Go DDR5 5200 MHz', search: 'RAM DDR5 16 Go 5200 MHz' },
      { icon: 'gpu', label: 'GPU', name: 'RTX 4060 8 Go', search: 'carte graphique RTX 4060 8 Go' },
      { icon: 'ssd', label: 'SSD', name: '1 To NVMe PCIe 4.0', search: 'SSD NVMe 1 To PCIe 4.0' },
      { icon: 'psu', label: 'Alimentation', name: '650 W 80+ Bronze', search: 'alimentation PC 650W 80+ Bronze' },
      { icon: 'tower', label: 'Boîtier', name: 'ATX airflow', search: 'boîtier PC ATX airflow' },
    ],
  },
  {
    id: 'budget-1500',
    badge: 'Notre recommandation',
    price: '≈ 2000 €',
    specLine: 'Ryzen 5 9600X (AM5) + RTX 5070 12 Go + 32 Go DDR5 + SSD 2 To',
    reasoning:
      "Le point d'équilibre : processeur et carte mère de génération courante, 32 Go de RAM pour ne plus jamais y repenser, une carte graphique qui passe confortablement en 1440p, et 2 To de stockage pour ne pas jongler avec les désinstallations. C'est la configuration qu'on choisirait pour un usage gaming sérieux, sans se ruiner.",
    highlight: true,
    parts: [
      { icon: 'cpu', label: 'CPU', name: 'AMD Ryzen 5 9600X', search: 'AMD Ryzen 5 9600X AM5' },
      { icon: 'board', label: 'Carte mère', name: 'B650 (AM5, DDR5)', search: 'carte mère B650 AM5 DDR5' },
      { icon: 'ram', label: 'RAM', name: '32 Go DDR5 5600 MHz', search: 'RAM DDR5 32 Go 5600 MHz' },
      { icon: 'gpu', label: 'GPU', name: 'RTX 5070 12 Go', search: 'carte graphique RTX 5070 12 Go' },
      { icon: 'ssd', label: 'SSD', name: '2 To NVMe PCIe 4.0', search: 'SSD NVMe 2 To PCIe 4.0' },
      { icon: 'psu', label: 'Alimentation', name: '750 W 80+ Gold, modulaire', search: 'alimentation PC 750W 80+ Gold modulaire' },
      { icon: 'tower', label: 'Boîtier', name: 'ATX airflow', search: 'boîtier PC ATX airflow' },
    ],
  },
  {
    id: 'budget-2500',
    badge: 'Sans compromis',
    price: '≈ 3200 €',
    specLine: 'Ryzen 7 9800X3D (AM5) + RTX 5080 16 Go + 32 Go DDR5 rapide + SSD 2 To',
    reasoning:
      "Le 9800X3D reste le processeur le plus performant du marché en gaming pur grâce à sa mémoire cache 3D, et la RTX 5080 pousse confortablement jusqu'en 4K. Une config pensée pour ne pas devoir y retoucher avant plusieurs années, quel que soit le jeu.",
    parts: [
      { icon: 'cpu', label: 'CPU', name: 'AMD Ryzen 7 9800X3D', search: 'AMD Ryzen 7 9800X3D AM5' },
      { icon: 'board', label: 'Carte mère', name: 'X870 (AM5, DDR5)', search: 'carte mère X870 AM5 DDR5' },
      { icon: 'ram', label: 'RAM', name: '32 Go DDR5 6000 MHz', search: 'RAM DDR5 32 Go 6000 MHz' },
      { icon: 'gpu', label: 'GPU', name: 'RTX 5080 16 Go', search: 'carte graphique RTX 5080 16 Go' },
      { icon: 'ssd', label: 'SSD', name: '2 To NVMe PCIe 4.0', search: 'SSD NVMe 2 To PCIe 4.0' },
      { icon: 'psu', label: 'Alimentation', name: '1000 W 80+ Gold, ATX 3.0', search: 'alimentation PC 1000W 80+ Gold ATX 3.0' },
      { icon: 'tower', label: 'Boîtier', name: 'ATX premium airflow', search: 'boîtier PC ATX premium airflow' },
    ],
  },
];

// Ce qui compte pour bien choisir chaque pièce, indépendamment du palier —
// présenté en accordéon pour rester consultable sans alourdir la page.
const parts = [
  {
    id: 'cpu',
    icon: 'cpu',
    title: 'Le processeur (CPU)',
    criteria: [
      'Le socket : il doit correspondre à la carte mère (AM5 pour AMD récent, LGA1700 pour Intel récent, AM4 pour les configs d’entrée de gamme). Impossible de mélanger deux sockets différents.',
      "Le nombre de cœurs : 6 cœurs suffisent pour la quasi-totalité des jeux actuels ; au-delà, le gain se voit surtout en montage vidéo ou streaming simultané.",
      "Le ventilateur fourni : plusieurs CPU milieu de gamme incluent un refroidisseur correct de série, ce qui évite un achat supplémentaire.",
      "L'iGPU (puce graphique intégrée) : un vrai filet de sécurité pour afficher une image le temps de recevoir la carte graphique, ou en cas de panne GPU.",
    ],
  },
  {
    id: 'carte-mere',
    icon: 'board',
    title: 'La carte mère',
    criteria: [
      'Le chipset : il détermine le niveau de fonctionnalités (A620/B550 en entrée de gamme, B650/B850 en milieu de gamme, X670/X870 en haut de gamme) sans changer le socket du processeur.',
      "Le format : ATX pour un boîtier standard, Micro-ATX si l'encombrement compte plus que les emplacements d'extension.",
      "Le nombre de ports M.2 : au moins deux, pour ajouter un second SSD plus tard sans tout démonter.",
      'La connectique arrière : Wi-Fi intégré et USB-C évitent d’avoir à ajouter une carte séparée par la suite.',
    ],
  },
  {
    id: 'ram',
    icon: 'ram',
    title: 'La mémoire (RAM)',
    criteria: [
      'Le type : DDR5 sur toute plateforme AM5/LGA1700 récente, DDR4 sur une plateforme plus ancienne (AM4) — les deux ne sont pas interchangeables, la carte mère impose le format.',
      '16 Go conviennent pour un usage gaming simple, 32 Go (2x16 Go) évitent d’y revenir dans un an dès qu’on ajoute du stream, du multitâche ou des jeux plus gourmands.',
      'Le kit à 2 barrettes plutôt qu’une seule : la carte mère fonctionne en double canal, ce qui améliore réellement les performances.',
      "La fréquence et le profil XMP/EXPO : vérifie que la vitesse annoncée est bien supportée par la carte mère choisie.",
    ],
  },
  {
    id: 'gpu',
    icon: 'gpu',
    title: 'La carte graphique (GPU)',
    criteria: [
      'La définition visée : une carte d’entrée ou de milieu de gamme couvre bien le 1080p et le 1440p ; le 4K demande une gamme au-dessus.',
      'La mémoire vidéo (VRAM) : 8 Go est le minimum confortable aujourd’hui pour ne pas se retrouver limité dans deux ou trois ans.',
      "L'encombrement : mesure l'espace disponible dans le boîtier avant d'acheter — certains modèles dépassent 30 cm de long.",
      "L'alimentation nécessaire : chaque fiche produit indique la puissance minimale recommandée ; vérifie que ton alimentation suit.",
    ],
  },
  {
    id: 'stockage',
    icon: 'ssd',
    title: 'Le stockage (SSD)',
    criteria: [
      "La capacité : 500 Go suffit pour démarrer, 1 To est plus confortable — un jeu récent peut à lui seul dépasser 100 Go.",
      "L'interface : NVMe PCIe 4.0 offre déjà des débits très largement suffisants pour jouer ; le PCIe 5.0 profite surtout aux gros transferts de fichiers.",
      "Le format M.2 2280 : le standard quasi universel, vérifie juste qu'il correspond aux ports de la carte mère choisie.",
      'Un dissipateur thermique intégré évite la chauffe sur de longues sessions, surtout dans un boîtier compact.',
    ],
  },
  {
    id: 'alimentation',
    icon: 'psu',
    title: "L'alimentation (PSU)",
    criteria: [
      "La puissance : additionne les besoins du CPU et du GPU, puis prends une marge confortable plutôt que le strict minimum.",
      'La certification 80+ (Bronze, Gold, Platine) : indique le rendement énergétique — viser au moins Gold à partir du milieu de gamme.',
      'Le modulaire : les câbles non utilisés se débranchent entièrement, ce qui facilite le montage et améliore la circulation d’air.',
      "La marque et la garantie : une alimentation défaillante peut endommager tout le reste — ce n'est pas le poste où économiser au maximum.",
    ],
  },
  {
    id: 'boitier',
    icon: 'tower',
    title: 'Le boîtier',
    criteria: [
      "La compatibilité : vérifie qu'il accepte le format de la carte mère (ATX) et la longueur de la carte graphique choisie.",
      "Le flux d'air : un boîtier avec de vraies grilles d'aération (« airflow ») refroidit mieux qu'un modèle tout en verre trempé, même si ce dernier est plus spectaculaire.",
      'Le nombre de ventilateurs inclus : en avoir 2 ou 3 dès l’achat évite d’en racheter immédiatement.',
      "La gestion des câbles : un espace dédié à l'arrière facilite grandement le montage et le nettoyage futur.",
    ],
  },
];

const faq = [
  {
    question: 'Faut-il forcément assembler le PC soi-même ?',
    answer:
      "Non, mais c'est plus simple qu'il n'y paraît : compter environ deux à trois heures pour un premier montage, avec des tutoriels vidéo pour chaque étape. Si l'idée ne tente vraiment pas, la plupart des composants ci-dessus se retrouvent aussi dans des configurations pré-montées équivalentes.",
  },
  {
    question: 'Ces pièces sont-elles compatibles entre elles ?',
    answer:
      "Oui, chaque palier proposé reste cohérent en interne : le processeur et la carte mère partagent le même socket, la RAM est au format attendu par la carte mère (DDR4 ou DDR5 selon la plateforme), et l'alimentation dépasse largement la consommation du processeur et de la carte graphique réunis. En revanche, ne mélange pas des pièces de paliers différents sans vérifier : un processeur du palier « 950 € » (socket AM4) n'est par exemple pas compatible avec une carte mère du palier « 2000 € » (socket AM5).",
  },
  {
    question: 'Pourquoi le palier « 950 € » utilise une plateforme différente (AM4) ?',
    answer:
      "Parce que c'est ce qui reste le plus rentable à ce budget : les cartes mères et la mémoire DDR4 coûtent nettement moins cher que leurs équivalents DDR5, ce qui laisse plus de budget pour la carte graphique — le poste qui compte le plus pour les performances en jeu. À partir d'environ 1250 €, la plateforme actuelle (AM5, DDR5) devient plus pertinente, notamment pour la marge d'évolution qu'elle offre.",
  },
  {
    question: 'Faut-il un système de refroidissement supplémentaire ?',
    answer:
      "Pas pour les paliers « 950 € », « 1250 € » et « 2000 € » : le ventilateur fourni avec le processeur suffit largement à un usage gaming classique. Pour le palier « 3200 € », un refroidissement à air haut de gamme ou un watercooling AIO 240-360 mm est recommandé, le processeur et la carte graphique dégageant nettement plus de chaleur.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<BaseLayout
  title="Monter un PC gaming : le guide pièce par pièce"
  description="4 configurations PC gaming complètes selon ton budget (950 à 3200 €), avec les critères qui comptent pour bien choisir chaque composant."
  jsonLd={faqSchema}
>
  <PageHead eyebrow="Guide d'achat" title="Monter un PC gaming : le guide pièce par pièce" lede="Quatre configurations cohérentes selon ton budget, d'environ 950 € à plus de 3 200 € — choisis ton palier, puis suis les liens pour chaque pièce. Les critères détaillés plus bas expliquent le « pourquoi » si tu veux creuser." icon="cpu" crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Outils', href: '/outils/' }, { label: 'Guide PC gaming' }]} width="narrow" />
  <section class="container pcguide">
    <p class="pcguide__note">
      Cette page couvre uniquement la tour (les composants internes). Les périphériques — écran,
      clavier, souris, casque — sont traités dans notre
      <a href="/guides/setup-gaming/">guide setup gaming</a> séparément.
    </p>
    <p class="pcguide__note">
      <strong>À propos des prix</strong> : la RAM et les SSD traversent une pénurie mondiale de
      mémoire depuis fin 2025, qui a fait grimper leurs tarifs de façon inhabituelle. Les montants
      ci-dessous reflètent le marché actuel et peuvent encore bouger dans les mois qui viennent —
      vérifie toujours le prix affiché sur la fiche produit avant d'acheter.
    </p>

    <AffiliateDisclosure />

    <div class="pcguide__tiers">
      {tiers.map((t) => (
        <div class:list={['pcguide__tier', { 'pcguide__tier--highlight': t.highlight }]}>
          {t.highlight && <p class="pcguide__tier-label">Notre choix</p>}
          <p class="pcguide__tier-badge">{t.badge}</p>
          <p class="pcguide__tier-price">{t.price}</p>
          <p class="pcguide__tier-spec">{t.specLine}</p>
          <p class="pcguide__tier-reasoning">{t.reasoning}</p>
          <ul class="pcguide__tier-list">
            {t.parts.map((c) => (
              <li>
                <a href={searchUrl(c.search)} target="_blank" rel="nofollow sponsored noopener">
                  <span class="pcguide__tier-item-label"><Icon name={c.icon} size={16} /> {c.label}</span>
                  <span class="pcguide__tier-item-name">{c.name}</span>
                  <Icon name="external" size={16} class="pcguide__tier-item-arrow" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <h2>Le détail, pièce par pièce</h2>
    <p class="pcguide__section-lede">
      Ce qui compte pour bien choisir chaque composant, indépendamment du palier visé — utile si tu
      veux adapter une configuration ou juste comprendre les choix ci-dessus.
    </p>
    <div class="pcguide__parts">
      {parts.map((p) => (
        <details class="pcguide__part" id={p.id}>
          <summary><Icon name={p.icon} size={18} /> {p.title}</summary>
          <ul class="pcguide__criteria">
            {p.criteria.map((c) => <li>{c}</li>)}
          </ul>
        </details>
      ))}
    </div>

    <h2>Questions fréquentes</h2>
    <div class="pcguide__faq">
      {faq.map((f) => (
        <details>
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .pcguide { padding-top: 2.6rem; padding-bottom: 4.5rem; }
  .pcguide__note { margin: 0 0 1.2rem; padding: 0.1rem 0 0.1rem 0.9rem; border-left: 1px solid var(--filet-fort); font-size: 0.93rem; line-height: 1.6; color: var(--gris); }
  .pcguide__note strong { color: var(--mine); }
  .pcguide h2 { margin: 3.2rem 0 0.5rem; font-size: clamp(1.5rem, 1.2rem + 1vw, 1.9rem); }
  .pcguide__section-lede { margin: 0 0 1.4rem; line-height: 1.6; color: var(--gris); }

  /* ---- Paliers de budget : le cœur de la page ----
     Quatre fiches cotées l'une sous l'autre (la colonne de lecture fait 700 px) :
     nom et prix sur la même ligne, la ligne de specs en mono, puis la
     nomenclature des pièces en lignes réglées. « Notre choix » : filet jaune
     de 4 px en tête de fiche et libellé mono, comme les fiches produit. */
  .pcguide__tiers { display: flex; flex-direction: column; gap: 1.6rem; margin: 2rem 0; }
  .pcguide__tier { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; column-gap: 1.5rem; padding: 1.2rem 1.3rem 0.4rem; background: var(--papier); border: 1px solid var(--filet); }
  .pcguide__tier--highlight { border-color: var(--mine); border-top: 4px solid var(--jaune); }
  .pcguide__tier-label { grid-column: 1 / -1; margin: 0 0 0.5rem; font-family: var(--font-mono); font-weight: 700; font-size: 0.75rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--mine); }
  .pcguide__tier-badge { grid-column: 1; margin: 0; font-weight: 600; font-size: 1.15rem; line-height: 1.3; }
  .pcguide__tier-price { grid-column: 2; margin: 0; font-family: var(--font-mono); font-size: 1.5rem; line-height: 1.2; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pcguide__tier-spec { grid-column: 1 / -1; margin: 0.7rem 0 0.8rem; font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.55; color: var(--gris); }
  .pcguide__tier-reasoning { grid-column: 1 / -1; margin: 0 0 1.1rem; font-size: 0.95rem; line-height: 1.6; color: var(--gris); }
  .pcguide__tier-list { grid-column: 1 / -1; list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--mine); }
  .pcguide__tier-list li + li { border-top: 1px solid var(--filet); }
  .pcguide__tier-list a { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr) auto; align-items: center; gap: 0.3rem 1rem; padding: 0.65rem 0.3rem; color: var(--mine); text-decoration: none; transition: background-color 0.18s ease; }
  .pcguide__tier-list a:hover { background: var(--jaune-pale); }
  .pcguide__tier-item-label { display: inline-flex; align-items: center; gap: 0.45em; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--gris); }
  .pcguide__tier-item-name { font-weight: 600; font-size: 0.95rem; line-height: 1.35; }
  .pcguide__tier-list :global(.pcguide__tier-item-arrow) { color: var(--gris); }
  /* Sous 560 px : ligne 1 = étiquette + flèche (courte et fixe, jamais de
     débordement possible) ; ligne 2 = le nom du composant, longueur variable,
     libre de passer à la ligne (cf. le bug de débordement du 17/08/2026 sur
     un motif similaire). */
  @media (max-width: 560px) {
    .pcguide__tier { padding: 1rem 1rem 0.3rem; }
    .pcguide__tier-list a { grid-template-columns: minmax(0, 1fr) auto; }
    .pcguide__tier-item-label { grid-column: 1; grid-row: 1; }
    .pcguide__tier-list :global(.pcguide__tier-item-arrow) { grid-column: 2; grid-row: 1; }
    .pcguide__tier-item-name { grid-column: 1 / -1; grid-row: 2; }
  }

  /* ---- Détail par pièce : accordéon réglé ---- */
  .pcguide__parts { margin: 0 0 1rem; border-top: 1.5px solid var(--mine); }
  .pcguide__part { border-bottom: 1px solid var(--filet); scroll-margin-top: 5rem; }
  .pcguide__part summary { display: flex; align-items: center; gap: 0.7rem; padding: 0.95rem 0.2rem; cursor: pointer; list-style: none; font-weight: 600; font-size: 1.02rem; line-height: 1.35; }
  .pcguide__part summary::-webkit-details-marker { display: none; }
  .pcguide__part summary :global(svg) { flex-shrink: 0; }
  .pcguide__part summary::after, .pcguide__faq summary::after { content: ''; flex-shrink: 0; width: 14px; height: 14px; margin-left: auto; background: linear-gradient(var(--mine), var(--mine)) center / 100% 1.5px no-repeat, linear-gradient(var(--mine), var(--mine)) center / 1.5px 100% no-repeat; }
  .pcguide__part[open] > summary::after, .pcguide__faq details[open] > summary::after { background: linear-gradient(var(--mine), var(--mine)) center / 100% 1.5px no-repeat; }
  .pcguide__criteria { list-style: none; margin: 0 0 1.1rem; padding: 0 2rem 0 0; display: flex; flex-direction: column; gap: 0.55rem; font-size: 0.95rem; line-height: 1.6; color: var(--gris); }
  .pcguide__criteria li { position: relative; padding-left: 1.5em; }
  .pcguide__criteria li::before { content: ''; position: absolute; left: 0.1em; top: 0.8em; width: 0.7em; height: 1.5px; background: var(--mine); }

  /* ---- FAQ : accordéon réglé ---- */
  .pcguide__faq { margin: 0 0 1rem; border-top: 1.5px solid var(--mine); }
  .pcguide__faq details { border-bottom: 1px solid var(--filet); }
  .pcguide__faq summary { display: flex; align-items: center; gap: 1rem; padding: 1rem 0.2rem; cursor: pointer; list-style: none; font-weight: 600; font-size: 1.02rem; line-height: 1.4; }
  .pcguide__faq summary::-webkit-details-marker { display: none; }
  .pcguide__faq p { margin: 0 0 1.1rem; padding-right: 2rem; line-height: 1.65; color: var(--gris); }
</style>
