---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { siteConfig } from '../siteConfig';
import { lexique, lexiqueGroups } from '../lexique';

// On ne lie que vers des articles réellement publiés
const articles = await getCollection('articles', ({ data }) => !data.draft);
const titleBySlug = new Map(articles.map((a) => [a.slug, a.data.title]));

// slug d'ancre : sans accents, kebab-case (ex. « Écrans & image » → ecrans-image)
const slugify = (s: string) =>
  s
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const groups = lexiqueGroups
  .map((group) => ({
    group,
    id: slugify(group),
    entries: lexique.filter((e) => e.group === group),
  }))
  .filter((g) => g.entries.length > 0);

// Rich snippet FAQ : Google peut afficher ces questions directement dans ses résultats
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: lexique.map((e) => ({
    '@type': 'Question',
    name: e.question,
    acceptedAnswer: { '@type': 'Answer', text: e.answer },
  })),
};

const description = `Lexique du bureau et du télétravail : VESA, DPI, ANC, Power Delivery, switchs… ${lexique.length} termes expliqués simplement.`;
---

<BaseLayout title="Lexique du bureau : tous les termes expliqués" description={description} jsonLd={faqSchema}>
  <PageHead eyebrow="Vocabulaire" title="Lexique du bureau et du télétravail" lede={`VESA, DPI, ANC, Power Delivery, switch tactile… Le vocabulaire technique est souvent le premier obstacle quand on cherche à s’équiper. Voici ${lexique.length} termes expliqués en clair, sans jargon marketing, avec un lien vers le comparatif concerné quand il existe.`} icon="book" crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Outils', href: '/outils/' }, { label: 'Lexique' }]} width="narrow" />
  <section class="container lexique">

    <nav class="lexique__toc" aria-label="Sommaire du lexique">
      {groups.map((g) => (
        <a href={`#${g.id}`}>{g.group}</a>
      ))}
    </nav>

    {groups.map((g) => {
      return (
        <section class="lexique__group">
          <h2 id={g.id}>{g.group}</h2>
          <div class="lexique__list">
            {g.entries.map((entry) => (
              <article class="lexique__item">
                <h3 class="lexique__term">{entry.term}</h3>
                <p class="lexique__question">{entry.question}</p>
                <p class="lexique__answer">{entry.answer}</p>
                {entry.related && entry.related.filter((s) => titleBySlug.has(s)).length > 0 && (
                  <p class="lexique__related">
                    <span>À lire :</span>
                    {entry.related
                      .filter((s) => titleBySlug.has(s))
                      .map((slug) => (
                        <a href={`/articles/${slug}/`}>{titleBySlug.get(slug)}</a>
                      ))}
                  </p>
                )}
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <p class="lexique__outro">
      Un terme manque ou une explication n’est pas claire ? <a href="/contact/">Écris-nous</a> — le lexique
      est complété au fil des questions qu’on nous pose.
    </p>
  </section>
</BaseLayout>

<style>
  .lexique { padding-top: 2.6rem; padding-bottom: 4.5rem; }

  /* Sommaire : étiquettes à angles vifs */
  .lexique__toc { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 3rem; }
  .lexique__toc a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.35em 0.75em;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--mine);
    text-decoration: none;
    background: var(--papier);
    border: 1px solid var(--filet);
    border-radius: var(--radius-sm);
    transition: border-color 0.18s ease;
  }
  .lexique__toc a:hover { border-color: var(--mine); }

  /* Chaque groupe : un titre, puis les termes en lignes réglées (le terme à gauche, la définition à droite) */
  .lexique__group { margin-bottom: 3.5rem; }
  .lexique__group h2 { margin: 0 0 1rem; font-size: clamp(1.5rem, 1.2rem + 1vw, 1.9rem); scroll-margin-top: 5rem; }
  .lexique__list { border-top: 1.5px solid var(--mine); }
  .lexique__item { display: grid; grid-template-columns: minmax(0, 10.5rem) minmax(0, 1fr); gap: 0.2rem 1.6rem; padding: 1.1rem 0.2rem 1.2rem; border-bottom: 1px solid var(--filet); scroll-margin-top: 5rem; }
  .lexique__term { grid-row: span 3; margin: 0; font-size: 1.08rem; line-height: 1.35; }
  .lexique__question { grid-column: 2; margin: 0 0 0.35rem; font-weight: 600; font-size: 0.95rem; line-height: 1.45; }
  .lexique__answer { grid-column: 2; margin: 0; font-size: 0.95rem; line-height: 1.65; color: var(--gris); }
  .lexique__related { grid-column: 2; margin: 0.7rem 0 0; display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; font-size: 0.88rem; }
  .lexique__related span { font-weight: 600; color: var(--gris); }

  .lexique__outro { margin: 1rem 0 0; padding: 0.1rem 0 0.1rem 0.9rem; border-left: 1px solid var(--filet-fort); font-size: 0.95rem; line-height: 1.6; color: var(--gris); }
  @media (max-width: 600px) {
    .lexique__item { grid-template-columns: minmax(0, 1fr); }
    .lexique__term { grid-row: auto; margin-bottom: 0.3rem; }
    .lexique__question, .lexique__answer, .lexique__related { grid-column: 1; }
  }
</style>
