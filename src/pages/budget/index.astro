---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../siteConfig';
import { budgets } from '../../budgets';

const published = new Set((await getCollection('articles', ({ data }) => !data.draft)).map((a) => a.slug));
const budgetCounts = budgets.map((b) => ({
  ...b,
  count: b.articles.filter((slug) => published.has(slug)).length,
}));
---

<BaseLayout
  title="Choisir par budget"
  description={`Équiper son poste de travail selon son budget : petit budget, équilibré ou setup complet. ${siteConfig.name}.`}
>
  <PageHead
    eyebrow="Navigation par budget"
    title="Combien veux-tu y mettre ?"
    lede="Chaque enveloppe a ses bons choix. Dis-nous combien tu veux y mettre, on te montre les comparatifs qui donnent le meilleur résultat pour ce prix — du geste gratuit à l'investissement qui dure."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Par budget' }]}
  />

  <section class="wide bi">
    <div class="bi__intro">
      <p>Un même inconfort se corrige parfois avec un simple réglage, parfois avec un accessoire à petit prix, parfois seulement avec un meuble plus coûteux. C’est pourquoi nos comparatifs sont aussi rangés par enveloppe : tu compares des choix du même ordre de prix, au lieu d’opposer un repose-poignet à un bureau électrique. Avant toute dépense, commence par les <a href="/articles/bien-regler-chaise-ecran-ergonomie-gratuite/">réglages gratuits de la chaise et de l’écran</a> : ils corrigent déjà une bonne part des douleurs.</p>
      <p>Le <a href="/budget/petit-budget/">petit budget</a> réunit les accessoires malins qui corrigent l’essentiel sans te ruiner, comme un <a href="/articles/coussin-lombaire-chaise-bureau/">coussin lombaire</a>. L’enveloppe <a href="/budget/equilibre/">équilibrée</a> vise le meilleur rapport qualité-prix pour l’équipement du quotidien, choisi pour tenir plusieurs années. Le <a href="/budget/setup-complet/">setup complet</a> regroupe les pièces maîtresses qu’on garde longtemps, du <a href="/articles/bureau-assis-debout-electrique/">bureau assis-debout</a> au siège.</p>
    </div>
    <div class="bi__list">
      {budgetCounts.map((b) => (
        <article class="bi__row">
          <Icon name={b.slug} size={24} class="bi__icon" />
          <div class="bi__text">
            <h2 class="bi__title"><a class="stretched-link" href={`/budget/${b.slug}/`}>{b.label}</a></h2>
            <p class="bi__desc">{b.tagline}</p>
          </div>
          <p class="bi__data"><span class="bi__range">{b.range}</span><span class="bi__count">{b.count} comparatif{b.count > 1 ? 's' : ''}</span></p>
          <Icon name="arrow" size={22} class="bi__fleche" />
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .bi { padding-top: 2.6rem; padding-bottom: 4.5rem; }
  /* Texte d'introduction : même lecture que l'intro des pages budget */
  .bi__intro { max-width: 66ch; margin: 0 0 2.4rem; font-size: 1.08rem; line-height: 1.7; }
  .bi__intro p { margin: 0 0 1em; }
  .bi__intro p:last-child { margin-bottom: 0; }
  /* Trois enveloppes en cartes papier : nom en grand, repère de prix et compte en mono, flèche en pastille */
  .bi__list { display: grid; gap: 1rem; }
  .bi__row { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(10rem, 14rem) auto; align-items: center; gap: 0.4rem 1.6rem; padding: 1.4rem 1.5rem; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); box-shadow: var(--ombre); transition: transform 0.3s var(--ease-out), box-shadow 0.3s ease; }
  .bi__row:hover, .bi__row:focus-within { transform: translateY(-4px); box-shadow: var(--ombre-2); }
  .bi__row :global(.bi__icon) { width: 48px; height: 48px; padding: 12px; border-radius: 50%; background: var(--jaune-pale); color: var(--mine); }
  .bi__text { min-width: 0; }
  .bi__title { margin: 0 0 0.35rem; font-size: clamp(1.3rem, 1rem + 1.2vw, 1.9rem); line-height: 1.08; }
  .bi__title a { color: var(--mine); text-decoration: none; }
  .bi__desc { margin: 0; font-size: 0.98rem; line-height: 1.5; color: var(--gris); }
  .bi__data { margin: 0; display: flex; flex-direction: column; gap: 0.2rem; font-family: var(--font-mono); font-size: 0.82rem; line-height: 1.4; font-variant-numeric: tabular-nums; }
  .bi__range { color: var(--mine); }
  .bi__count { color: var(--gris); }
  .bi__row :global(.bi__fleche) { width: 40px; height: 40px; padding: 9px; border-radius: 50%; border: 1px solid var(--filet); transition: transform 0.2s var(--ease-out), background-color 0.18s ease, border-color 0.18s ease; }
  .bi__row:hover :global(.bi__fleche) { transform: translateX(4px); background: var(--jaune); border-color: var(--jaune); color: var(--sur-jaune); }
  @media (max-width: 760px) {
    .bi__row { grid-template-columns: auto minmax(0, 1fr) auto; gap: 0.5rem 1rem; padding: 1.1rem 1.1rem 1.2rem; }
    .bi__row :global(.bi__icon) { align-self: start; }
    .bi__data { grid-column: 2; grid-row: 2; flex-direction: row; flex-wrap: wrap; gap: 0.2rem 1rem; }
    .bi__row :global(.bi__fleche) { grid-column: 3; grid-row: 1 / span 2; }
  }
</style>
