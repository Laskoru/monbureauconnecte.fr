---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../siteConfig';
import { budgets } from '../../budgets';

const published = new Set((await getCollection('articles', ({ data }) => !data.draft)).map((a) => a.slug));
const budgetCounts = budgets.map((b) => ({
  ...b,
  count: b.articles.filter((slug) => published.has(slug)).length,
}));
---

<BaseLayout
  title="Choisir par budget"
  description={`Équiper son poste de travail selon son budget : petit budget, équilibré ou setup complet. ${siteConfig.name}.`}
>
  <PageHead
    eyebrow="Navigation par budget"
    title="Combien veux-tu y mettre ?"
    lede="Chaque enveloppe a ses bons choix. Dis-nous combien tu veux y mettre, on te montre les comparatifs qui donnent le meilleur résultat pour ce prix — du geste gratuit à l'investissement qui dure."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Par budget' }]}
  />

  <section class="wide bi">
    <div class="bi__list">
      {budgetCounts.map((b) => (
        <article class="bi__row">
          <Icon name={b.slug} size={24} class="bi__icon" />
          <div class="bi__text">
            <h2 class="bi__title"><a class="stretched-link" href={`/budget/${b.slug}/`}>{b.label}</a></h2>
            <p class="bi__desc">{b.tagline}</p>
          </div>
          <p class="bi__data"><span class="bi__range">{b.range}</span><span class="bi__count">{b.count} comparatif{b.count > 1 ? 's' : ''}</span></p>
          <Icon name="arrow" size={22} class="bi__fleche" />
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .bi { padding-top: 2.6rem; padding-bottom: 4.5rem; }
  /* Trois enveloppes en lignes réglées : nom en grand, repère de prix et compte en mono */
  .bi__list { border-top: 1.5px solid var(--mine); }
  .bi__row { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(10rem, 14rem) auto; align-items: center; gap: 0.4rem 1.6rem; padding: 1.4rem 0.4rem; border-bottom: 1px solid var(--filet); transition: background-color 0.18s ease; }
  .bi__row:hover, .bi__row:focus-within { background: var(--jaune-pale); }
  .bi__row :global(.bi__icon) { align-self: start; margin-top: 0.3rem; color: var(--mine); }
  .bi__text { min-width: 0; }
  .bi__title { margin: 0 0 0.35rem; font-weight: 300; font-size: clamp(1.5rem, 1rem + 1.6vw, 2.3rem); line-height: 1.08; }
  .bi__title a { color: var(--mine); text-decoration: none; }
  .bi__desc { margin: 0; font-size: 0.98rem; line-height: 1.5; color: var(--gris); }
  .bi__data { margin: 0; display: flex; flex-direction: column; gap: 0.2rem; font-family: var(--font-mono); font-size: 0.82rem; line-height: 1.4; font-variant-numeric: tabular-nums; }
  .bi__range { color: var(--mine); }
  .bi__count { color: var(--gris); }
  .bi__row :global(.bi__fleche) { transition: transform 0.2s var(--ease-out); }
  .bi__row:hover :global(.bi__fleche) { transform: translateX(6px); }
  @media (max-width: 760px) {
    .bi__row { grid-template-columns: auto minmax(0, 1fr) auto; gap: 0.5rem 1rem; }
    .bi__data { grid-column: 2; grid-row: 2; flex-direction: row; flex-wrap: wrap; gap: 0.2rem 1rem; }
    .bi__row :global(.bi__fleche) { grid-column: 3; grid-row: 1 / span 2; }
  }
</style>
