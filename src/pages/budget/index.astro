---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../siteConfig';
import { budgets } from '../../budgets';

const published = new Set((await getCollection('articles', ({ data }) => !data.draft)).map((a) => a.slug));
const budgetCounts = budgets.map((b) => ({
  ...b,
  count: b.articles.filter((slug) => published.has(slug)).length,
}));
---

<BaseLayout
  title="Choisir par budget"
  description={`Équiper son poste de travail selon son budget : petit budget, équilibré ou setup complet. ${siteConfig.name}.`}
>
  <PageHead
    eyebrow="Navigation par budget"
    title="Combien veux-tu y mettre ?"
    lede="Chaque enveloppe a ses bons choix. Dis-nous combien tu veux y mettre, on te montre les comparatifs qui donnent le meilleur résultat pour ce prix — du geste gratuit à l'investissement qui dure."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Par budget' }]}
  />

  <section class="wide bi">
    <div class="bi__grid">
      {budgetCounts.map((b) => (
        <article class="bi__card card card--hover">
          <div class="bi__top"><span class="bi__icon"><Icon name={b.slug} size={24} /></span><span class="spec"><b>{b.range}</b></span></div>
          <h2 class="bi__title"><a class="stretched-link" href={`/budget/${b.slug}/`}>{b.label}</a></h2>
          <p class="bi__desc">{b.tagline}</p>
          <p class="bi__count">{b.count} comparatif{b.count > 1 ? 's' : ''} <Icon name="arrow" size={14} /></p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .bi { padding: 2.2rem 1.25rem 3.5rem; }
  .bi__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .bi__card { padding: 1.5rem 1.5rem 1.4rem; display: flex; flex-direction: column; }
  .bi__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .bi__icon { display: inline-flex; align-items: center; justify-content: center; width: 50px; height: 50px; border-radius: var(--radius); background: var(--color-signal-soft); color: var(--color-signal-text); }
  .bi__top .spec b { color: var(--color-signal-text); }
  .bi__title { margin: 0 0 .4rem; font-size: 1.6rem; }
  .bi__title a { color: var(--color-text); text-decoration: none; }
  .bi__card:hover .bi__title a { color: var(--color-accent-text); }
  .bi__desc { margin: 0 0 1rem; color: var(--color-text-muted); font-size: .95rem; line-height: 1.55; flex: 1; }
  .bi__count { margin: 0; display: inline-flex; align-items: center; gap: .35em; font-weight: 700; font-size: .85rem; color: var(--color-accent-text); }
  @media (max-width: 900px) { .bi__grid { grid-template-columns: 1fr; } }
</style>
