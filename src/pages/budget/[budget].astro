---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import { budgets } from '../../budgets';

export async function getStaticPaths() {
  return budgets.map((budget) => ({ params: { budget: budget.slug }, props: { budget } }));
}

const { budget } = Astro.props;

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const bySlug = new Map(allArticles.map((a) => [a.slug, a]));
const articles = budget.articles.map((slug) => bySlug.get(slug)).filter((a) => a !== undefined);
const others = budgets.filter((b) => b.slug !== budget.slug);
---

<BaseLayout title={`${budget.label} — ${budget.tagline}`} description={budget.description}>
  <PageHead
    eyebrow={`Par budget · ${budget.range}`}
    title={budget.label}
    lede={budget.tagline}
    icon={budget.slug}
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Par budget', href: '/budget/' }, { label: budget.label }]}
    count={String(articles.length).padStart(2, '0')}
  />

  <section class="wide bd">
    <div class="bd__grid">
      <div class="bd__main">
        <div class="bd__intro">
          {budget.intro.map((p) => <p set:html={p} />)}
        </div>
        <h2 class="bd__section">Les comparatifs de cette enveloppe</h2>
        <div class="bd__list">
          {articles.map((article) => <ArticleCard article={article} variant="row" />)}
        </div>
      </div>
      <aside class="bd__side">
        <div class="bd__box">
          <p class="bd__box-title"><Icon name="euro" size={16} /> Autres budgets</p>
          {others.map((b) => (
            <a class="bd__link" href={`/budget/${b.slug}/`}><Icon name={b.slug} size={18} /> <span>{b.label}<small>{b.range}</small></span> <Icon name="arrow" size={14} /></a>
          ))}
        </div>
        <div class="bd__box bd__box--tool">
          <p class="bd__box-title"><Icon name="ruler" size={16} /> Le gain gratuit</p>
          <p class="bd__box-text">Avant d'acheter, règle ton poste : la bonne hauteur de bureau et d'écran ne coûte rien.</p>
          <a class="btn btn--primary btn--sm" href="/calculateur-hauteur-bureau/">Calculer ma hauteur</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .bd { padding-top: 2.6rem; padding-bottom: 4.5rem; }
  .bd__grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 3.5rem; align-items: start; }
  .bd__intro { font-size: 1.08rem; line-height: 1.7; max-width: 66ch; }
  .bd__intro :global(p) { margin: 0 0 1em; }
  .bd__section { margin: 2.4rem 0 1rem; font-size: clamp(1.5rem, 1.15rem + 1.2vw, 2.1rem); }
  /* Les comparatifs en lignes réglées : filet mine en tête, filets fins entre les lignes */
  .bd__list { border-top: 1.5px solid var(--mine); border-bottom: 1px solid var(--filet); }
  .bd__list :global(.row:first-child) { border-top: 0; }
  .bd__side { position: sticky; top: 88px; display: flex; flex-direction: column; gap: 2rem; }
  .bd__box { display: flex; flex-direction: column; padding-top: 0.9rem; border-top: 1.5px solid var(--mine); }
  .bd__box-title { margin: 0 0 0.5rem; display: flex; align-items: center; gap: 0.5em; font-weight: 600; font-size: 1rem; line-height: 1.3; color: var(--mine); }
  .bd__box-text { margin: 0 0 1rem; font-size: 0.93rem; line-height: 1.55; color: var(--gris); }
  .bd__box .btn { align-self: flex-start; }
  .bd__link { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.7rem; padding: 0.65rem 0.3rem; border-bottom: 1px solid var(--filet); text-decoration: none; color: var(--mine); font-weight: 600; font-size: 0.95rem; line-height: 1.35; transition: background-color 0.18s ease; }
  .bd__link:hover { background: var(--jaune-pale); }
  .bd__link span { display: flex; flex-direction: column; }
  .bd__link small { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 400; color: var(--gris); }
  @media (max-width: 900px) { .bd__grid { grid-template-columns: 1fr; } .bd__side { position: static; } }
</style>
