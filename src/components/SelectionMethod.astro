---
// Bloc « Comment nous choisissons » : transparence sur la méthode de sélection.
import Icon from './Icon.astro';
const criteria = [
  { icon: 'monitor', title: 'Le bon usage (ton setup)', text: 'On part de ton poste et de ton budget, pas de la liste des best-sellers.' },
  { icon: 'ruler', title: 'Des critères mesurables', text: 'Ergonomie, compatibilité, durabilité : ce qui change vraiment le quotidien.' },
  { icon: 'star', title: 'Les avis réels, pas gonflés', text: 'Les notes affichées sont les vraies notes Amazon, jamais retouchées.' },
  { icon: 'shield', title: 'Indépendance & franchise', text: 'Aucune marque ne paie pour figurer. Quand un produit a des limites, on les écrit.' },
];
---

<aside class="selmethod blueprint" aria-label="Comment nous choisissons">
  <p class="selmethod__eyebrow"><Icon name="sliders" size={14} /> Comment nous choisissons</p>
  <ul class="selmethod__grid">
    {criteria.map((c) => (
      <li class="selmethod__item">
        <span class="selmethod__icon" aria-hidden="true"><Icon name={c.icon} size={18} /></span>
        <div>
          <p class="selmethod__title">{c.title}</p>
          <p class="selmethod__text">{c.text}</p>
        </div>
      </li>
    ))}
  </ul>
</aside>

<style>
  .selmethod { margin: 2.4rem 0 .6rem; padding: 1.3rem 1.5rem; border-radius: var(--radius-lg); background-color: var(--color-bg-soft); border: 1px solid var(--color-border); }
  .selmethod__eyebrow { margin: 0 0 .9rem; display: flex; align-items: center; gap: .5em; font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-accent-text); }
  .selmethod__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 1.4rem; }
  .selmethod__item { display: flex; gap: .7rem; align-items: flex-start; }
  .selmethod__icon { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: var(--radius-sm); background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-accent-text); }
  .selmethod__title { margin: 0 0 .15rem; font-weight: 700; font-size: .95rem; color: var(--color-text); }
  .selmethod__text { margin: 0; font-size: .88rem; line-height: 1.5; color: var(--color-text-muted); }
  @media (max-width: 560px) { .selmethod__grid { grid-template-columns: 1fr; } }
</style>
