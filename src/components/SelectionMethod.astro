---
// Bloc « Comment nous choisissons » : transparence sur la méthode de sélection.
import Icon from './Icon.astro';
const criteria = [
  { icon: 'monitor', title: 'Le bon usage (ton setup)', text: 'On part de ton poste et de ton budget, pas de la liste des best-sellers.' },
  { icon: 'ruler', title: 'Des critères mesurables', text: 'Ergonomie, compatibilité, durabilité : ce qui change vraiment le quotidien.' },
  { icon: 'star', title: 'Les avis réels, pas gonflés', text: 'Les notes affichées sont les vraies notes Amazon, jamais retouchées.' },
  { icon: 'shield', title: 'Indépendance & franchise', text: 'Aucune marque ne paie pour figurer. Quand un produit a des limites, on les écrit.' },
];
---

<aside class="selmethod" aria-label="Comment nous choisissons">
  <p class="selmethod__head">Comment nous choisissons</p>
  <ul class="selmethod__grid">
    {criteria.map((c) => (
      <li class="selmethod__item">
        <Icon name={c.icon} size={20} />
        <div>
          <p class="selmethod__title">{c.title}</p>
          <p class="selmethod__text">{c.text}</p>
        </div>
      </li>
    ))}
  </ul>
</aside>

<style>
  /* Quatre critères dans une carte papier arrondie, icônes sur pastilles lime pâle */
  .selmethod { margin: 3rem 0 0.6rem; padding: 1.3rem 1.4rem 1.4rem; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); box-shadow: var(--ombre); }
  .selmethod__head { margin: 0 0 1rem; font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; line-height: 1.3; letter-spacing: -0.02em; color: var(--mine); }
  .selmethod__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.1rem 1.6rem; }
  .selmethod__item { display: flex; gap: 0.8rem; align-items: flex-start; }
  .selmethod__item :global(svg) { flex: none; width: 38px; height: 38px; padding: 9px; border-radius: 50%; background: var(--jaune-pale); color: var(--mine); }
  .selmethod__title { margin: 0 0 0.2rem; font-weight: 700; font-size: 0.95rem; line-height: 1.35; color: var(--mine); }
  .selmethod__text { margin: 0; font-size: 0.9rem; line-height: 1.55; color: var(--gris); }
  @media (max-width: 560px) { .selmethod { padding: 1.1rem 1.1rem 1.2rem; } .selmethod__grid { grid-template-columns: 1fr; } }
</style>
