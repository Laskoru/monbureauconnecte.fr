---
// Bloc « Comment nous choisissons » : transparence sur la méthode de sélection.
import Icon from './Icon.astro';
const criteria = [
  { icon: 'monitor', title: 'Le bon usage (ton setup)', text: 'On part de ton poste et de ton budget, pas de la liste des best-sellers.' },
  { icon: 'ruler', title: 'Des critères mesurables', text: 'Ergonomie, compatibilité, durabilité : ce qui change vraiment le quotidien.' },
  { icon: 'star', title: 'Les avis réels, pas gonflés', text: 'Les notes affichées sont les vraies notes Amazon, jamais retouchées.' },
  { icon: 'shield', title: 'Indépendance & franchise', text: 'Aucune marque ne paie pour figurer. Quand un produit a des limites, on les écrit.' },
];
---

<aside class="selmethod" aria-label="Comment nous choisissons">
  <p class="selmethod__head">Comment nous choisissons</p>
  <ul class="selmethod__grid">
    {criteria.map((c) => (
      <li class="selmethod__item">
        <Icon name={c.icon} size={20} />
        <div>
          <p class="selmethod__title">{c.title}</p>
          <p class="selmethod__text">{c.text}</p>
        </div>
      </li>
    ))}
  </ul>
</aside>

<style>
  /* Quatre critères en lignes réglées : filet mine en tête, filets fins entre les lignes */
  .selmethod { margin: 3rem 0 0.6rem; }
  .selmethod__head { margin: 0 0 0.8rem; font-weight: 600; font-size: 1.15rem; line-height: 1.3; color: var(--mine); }
  .selmethod__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.8rem; border-top: 1.5px solid var(--mine); }
  .selmethod__item { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.9rem 0.1rem; border-bottom: 1px solid var(--filet); }
  .selmethod__item :global(svg) { flex: none; margin-top: 0.1rem; color: var(--mine); }
  .selmethod__title { margin: 0 0 0.2rem; font-weight: 600; font-size: 0.98rem; line-height: 1.35; color: var(--mine); }
  .selmethod__text { margin: 0; font-size: 0.9rem; line-height: 1.55; color: var(--gris); }
  @media (max-width: 560px) { .selmethod__grid { grid-template-columns: 1fr; } }
</style>
