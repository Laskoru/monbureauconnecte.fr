---
// Bandeau de consentement minimal conforme RGPD.
// Tant que l'utilisateur n'a pas cliqué "Accepter", aucun script de mesure
// d'audience (Google Analytics, voir BaseLayout.astro) n'est chargé.
---

<div id="cookie-banner" class="cookie-banner" role="region" aria-label="Cookies" aria-hidden="true">
  <div class="cookie-banner__inner">
    <p>
      On mesure l'audience (Google Analytics) seulement si tu l'acceptes.
      <a href="/politique-de-confidentialite/">Politique de confidentialité</a>
    </p>
    <!-- Refuser et Accepter : même style, même taille (CNIL : refuser aussi simple qu'accepter). -->
    <div class="cookie-banner__actions">
      <button id="cookie-refuse" type="button" class="btn btn--outline btn--sm cookie-banner__btn">Refuser</button>
      <button id="cookie-accept" type="button" class="btn btn--outline btn--sm cookie-banner__btn">Accepter</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'cookie-consent';
    var banner = document.getElementById('cookie-banner');
    var stored = localStorage.getItem(KEY);

    function reveal() {
      if (!stored) { banner.classList.add('is-visible'); banner.setAttribute('aria-hidden', 'false'); }
    }

    function setConsent(value) {
      localStorage.setItem(KEY, value);
      banner.classList.remove('is-visible');
      banner.setAttribute('aria-hidden', 'true');
      if (value === 'accepted') {
        document.dispatchEvent(new CustomEvent('cookie-consent-accepted'));
      }
    }

    document.getElementById('cookie-accept').addEventListener('click', function () {
      setConsent('accepted');
    });
    document.getElementById('cookie-refuse').addEventListener('click', function () {
      setConsent('refused');
    });

    if (stored === 'accepted') {
      document.dispatchEvent(new CustomEvent('cookie-consent-accepted'));
    }
    reveal();
  })();
</script>

<style>
  /* Panneau papier arrondi à ombre douce, posé sur la page.
     Hors écran par transform (pas de décalage de mise en page / CLS), il glisse
     quand il faut demander le consentement : entrée ease-out, sortie ease-in. */
  .cookie-banner {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 100;
    max-width: 960px;
    margin: 0 auto;
    padding: 1.1rem 1.3rem;
    background: var(--papier);
    color: var(--mine);
    border: 1px solid var(--filet);
    border-radius: var(--radius-lg);
    box-shadow: var(--ombre-2);
    transform: translateY(calc(100% + 32px));
    visibility: hidden;
    transition: transform 0.32s ease-in, visibility 0s linear 0.32s;
  }
  .cookie-banner.is-visible { transform: none; visibility: visible; transition: transform 0.32s var(--ease-out); }
  @media (prefers-reduced-motion: reduce) { .cookie-banner, .cookie-banner.is-visible { transition: none; } }
  .cookie-banner__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    justify-content: space-between;
  }
  .cookie-banner p { flex: 1 1 420px; min-width: 0; max-width: 640px; margin: 0; font-size: 0.9rem; line-height: 1.5; }
  .cookie-banner p a { white-space: nowrap; }
  .cookie-banner__actions { display: flex; gap: 0.6rem; flex-shrink: 0; }
  /* Deux boutons papier à filet noir, identiques : aucun choix mis en avant. */
  .cookie-banner__btn { min-width: 7.5rem; border-color: var(--mine); }
  /* Mobile : bandeau compact (≈ 110 px à 390 px) qui ne masque plus l'ouverture. */
  @media (max-width: 480px) {
    .cookie-banner { left: 8px; right: 8px; bottom: 8px; padding: 0.7rem 0.8rem 0.8rem; border-radius: var(--radius); }
    .cookie-banner__inner { gap: 0.55rem; }
    .cookie-banner p { flex-basis: 100%; font-size: 0.84rem; line-height: 1.4; }
    .cookie-banner__actions { width: 100%; gap: 0.5rem; }
    .cookie-banner__actions .btn { flex: 1 1 0; min-width: 0; min-height: 44px; }
  }
</style>
