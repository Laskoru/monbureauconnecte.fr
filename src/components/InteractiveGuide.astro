---
// Mini-guide interactif : une question, quelques réponses cliquables, et un
// conseil personnalisé qui s'affiche dynamiquement au clic. Piloté par le
// frontmatter de l'article (champ `interactiveGuide`), donc réutilisable
// partout sans écrire de JS par article.
export interface GuideOption {
  label: string;
  result: string; // HTML simple autorisé (rédigé par nous)
}
export interface Guide {
  title: string;
  question: string;
  intro?: string;
  options: GuideOption[];
}
const { guide } = Astro.props as { guide: Guide };
const results = guide.options.map((o) => o.result);
---

<section class="iguide" aria-label="Mini-guide interactif">
  <h2 class="iguide__title">{guide.title}</h2>
  {guide.intro && <p class="iguide__intro">{guide.intro}</p>}
  <p class="iguide__q">{guide.question}</p>
  <div class="iguide__options" role="group">
    {guide.options.map((o, i) => (
      <button type="button" class="iguide__opt" data-i={i}>{o.label}</button>
    ))}
  </div>
  <div class="iguide__result" hidden>
    <span class="iguide__result-badge">Notre conseil</span>
    <p class="iguide__result-text"></p>
  </div>
</section>

<script is:inline define:vars={{ results }}>
  (function () {
    const root = document.currentScript.previousElementSibling;
    if (!root || !root.classList.contains('iguide')) return;
    const opts = root.querySelectorAll('.iguide__opt');
    const box = root.querySelector('.iguide__result');
    const txt = root.querySelector('.iguide__result-text');
    opts.forEach((btn) => {
      btn.addEventListener('click', () => {
        const i = +btn.getAttribute('data-i');
        opts.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        txt.innerHTML = results[i];
        box.hidden = false;
      });
    });
  })();
</script>

<style>
  /* Bloc réglé (filet mine en tête) ; réponses en boutons au trait ; la réponse
     choisie se remplit de jaune ; le conseil tient dans un panneau papier au
     filet jaune de 4 px, comme « Notre choix ». */
  .iguide { margin: 3rem 0; padding-top: 1.1rem; border-top: 1.5px solid var(--mine); }
  .iguide__title { margin: 0 0 0.5rem; font-size: clamp(1.4rem, 1.15rem + 0.8vw, 1.8rem); line-height: 1.1; }
  .iguide__intro { margin: 0 0 1rem; font-size: 0.98rem; line-height: 1.6; color: var(--gris); }
  .iguide__q { margin: 0 0 0.9rem; font-weight: 600; }
  .iguide__options { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .iguide__opt {
    appearance: none;
    cursor: pointer;
    min-height: 44px;
    padding: 0.55em 1.05em;
    font: inherit;
    font-size: 0.93rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: left;
    color: var(--mine);
    background: transparent;
    border: 1.5px solid var(--mine);
    border-radius: var(--radius-sm);
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  .iguide__opt:hover { background: var(--jaune-pale); }
  .iguide__opt.is-active { background: var(--jaune); color: var(--sur-jaune); }
  .iguide__result {
    margin-top: 1.2rem;
    padding: 1rem 1.2rem 1.1rem;
    background: var(--papier);
    border: 1px solid var(--mine);
    border-top: 4px solid var(--jaune);
    animation: iguide-in 0.32s var(--ease-out);
  }
  .iguide__result-badge { display: block; margin-bottom: 0.35rem; font-weight: 600; font-size: 0.85rem; color: var(--mine); }
  .iguide__result-text { margin: 0; line-height: 1.65; }
  .iguide__result-text :global(strong) { color: var(--mine); }
  @keyframes iguide-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }
</style>
