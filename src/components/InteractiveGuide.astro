---
import Icon from './Icon.astro';
// Mini-guide interactif : une question, quelques réponses cliquables, et un
// conseil personnalisé qui s'affiche dynamiquement au clic. Piloté par le
// frontmatter de l'article (champ `interactiveGuide`), donc réutilisable
// partout sans écrire de JS par article.
export interface GuideOption {
  label: string;
  result: string; // HTML simple autorisé (rédigé par nous)
}
export interface Guide {
  title: string;
  question: string;
  intro?: string;
  options: GuideOption[];
}
const { guide } = Astro.props as { guide: Guide };
const results = guide.options.map((o) => o.result);
---

<section class="iguide" aria-label="Mini-guide interactif">
  <p class="iguide__eyebrow"><Icon name="target" size={14} /> Mini-guide interactif</p>
  <h2 class="iguide__title">{guide.title}</h2>
  {guide.intro && <p class="iguide__intro">{guide.intro}</p>}
  <p class="iguide__q">{guide.question}</p>
  <div class="iguide__options" role="group">
    {guide.options.map((o, i) => (
      <button type="button" class="iguide__opt" data-i={i}>{o.label}</button>
    ))}
  </div>
  <div class="iguide__result" hidden>
    <span class="iguide__result-badge">Notre conseil</span>
    <p class="iguide__result-text"></p>
  </div>
</section>

<script is:inline define:vars={{ results }}>
  (function () {
    const root = document.currentScript.previousElementSibling;
    if (!root || !root.classList.contains('iguide')) return;
    const opts = root.querySelectorAll('.iguide__opt');
    const box = root.querySelector('.iguide__result');
    const txt = root.querySelector('.iguide__result-text');
    opts.forEach((btn) => {
      btn.addEventListener('click', () => {
        const i = +btn.getAttribute('data-i');
        opts.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        txt.innerHTML = results[i];
        box.hidden = false;
      });
    });
  })();
</script>

<style>
  .iguide {
    margin: 2.4rem 0;
    padding: 1.6rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-accent) 8%, var(--color-surface)), var(--color-surface));
    box-shadow: var(--shadow-md);
  }
  .iguide__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.35rem;
  }
  .iguide__title { font-size: 1.2rem; margin: 0 0 0.4rem; line-height: 1.25; }
  .iguide__intro { color: var(--color-text-muted); font-size: 0.94rem; margin: 0 0 0.9rem; }
  .iguide__q { font-weight: 600; margin: 0 0 0.9rem; }
  .iguide__options { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .iguide__opt {
    appearance: none;
    cursor: pointer;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-bg-soft, var(--color-surface));
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.6em 1.1em;
    transition: transform 0.12s ease, border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .iguide__opt:hover { border-color: var(--color-accent); transform: translateY(-1px); }
  .iguide__opt.is-active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }
  .iguide__result {
    margin-top: 1.1rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
    animation: iguide-in 0.22s ease;
  }
  .iguide__result-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }
  .iguide__result-text { margin: 0; line-height: 1.6; }
  .iguide__result-text :global(strong) { color: var(--color-text); }
  @keyframes iguide-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
