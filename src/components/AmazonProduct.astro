---
import { siteConfig } from '../siteConfig';

interface Props {
  asin: string;
  title: string;
  image?: string;
  blurb?: string;
}

const { asin, title, image, blurb } = Astro.props;
const affiliateUrl = `https://www.amazon.fr/dp/${asin}?tag=${siteConfig.amazon.tag}`;
---

<div class="amazon-product">
  {image && (
    <a href={affiliateUrl} target="_blank" rel="nofollow sponsored noopener">
      <img src={image} alt={title} loading="lazy" />
    </a>
  )}
  <div class="amazon-product__body">
    <p class="amazon-product__title">{title}</p>
    {blurb && <p class="amazon-product__blurb">{blurb}</p>}
    <a class="amazon-product__cta" href={affiliateUrl} target="_blank" rel="nofollow sponsored noopener">
      Voir le prix sur Amazon →
    </a>
  </div>
</div>

<style>
  .amazon-product {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1rem;
    margin: 1.75rem 0;
    background: var(--color-surface);
    flex-wrap: wrap;
  }
  .amazon-product img {
    width: 110px;
    height: 110px;
    object-fit: contain;
    flex-shrink: 0;
    border-radius: 4px;
  }
  .amazon-product__body { flex: 1; min-width: 180px; }
  .amazon-product__title { font-weight: 600; margin: 0 0 0.35rem; }
  .amazon-product__blurb { color: var(--color-text-muted); margin: 0 0 0.6rem; font-size: 0.92rem; }
  .amazon-product__cta {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }
  .amazon-product__cta:hover { text-decoration: underline; }
</style>
