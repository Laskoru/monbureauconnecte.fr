---
import { resolveProductImage } from '../lib/products';
import { getRating } from '../lib/ratings';
import { isAvailable, productUrl, searchUrl, queryFromTitle } from '../lib/availability';
import { mesuresProduit } from '../lib/mesures';
import Icon from './Icon.astro';

interface Props {
  asin: string;
  title: string;
  image?: string;
  blurb?: string;
  pros?: string[];
  cons?: string[];
  award?: string;
  featured?: boolean;
  /** requête de repli propre au produit, si le produit n'est plus achetable */
  search?: string;
  /** repli par défaut : le mot-clé principal de l'article (ce que cherche le lecteur) */
  fallbackSearch?: string;
}

const { asin, title, image, blurb, pros = [], cons = [], award, featured = false, search, fallbackSearch } = Astro.props;

// Produit achetable : lien vers la fiche (meilleure conversion). Rupture constatée :
// recherche Amazon ciblée (requête du frontmatter, sinon mot-clé de l'article, sinon
// marque + modèle), pour proposer un équivalent au lieu d'une impasse.
const available = isAvailable(asin);
const affiliateUrl = available ? productUrl(asin) : searchUrl(search || fallbackSearch || queryFromTitle(title));
const resolvedImage = resolveProductImage(asin, image);

// « Coté avant d'être noté » : d'abord les mesures écrites du produit, puis la
// vraie note Amazon (récupérée par le process local, jamais inventée).
const mesures = mesuresProduit({ title, pros, blurb });
const rating = getRating(asin);
const nf = new Intl.NumberFormat('fr-FR');
const ratingLabel = rating ? rating.rating.toFixed(1).replace('.', ',') : null;
const pct = rating ? Math.round((rating.rating / 5) * 1000) / 10 : 0;
const label = featured ? (award && award !== 'Notre choix' ? `Notre choix · ${award}` : 'Notre choix') : award;
---

<article class:list={['fiche', { 'fiche--choix': featured }]}>
  {label && <p class="fiche__label">{label}</p>}
  <div class="fiche__grid">
    {resolvedImage && (
      <a href={affiliateUrl} target="_blank" rel="nofollow sponsored noopener" class="fiche__media" tabindex="-1" aria-hidden="true">
        <img src={resolvedImage} alt="" loading="lazy" decoding="async" width="400" height="400" onerror="this.closest('.fiche__media').remove()" />
      </a>
    )}
    <div class="fiche__body">
      <h3 class="fiche__title">{title}</h3>
      {mesures.length > 0 && <ul class="mesures" aria-label="Mesures du produit">{mesures.map((m) => <li>{m}</li>)}</ul>}
      {rating && (
        <p class="reglette">
          <span class="reglette__rule" style={`--p:${pct}%`} role="img" aria-label={`Note Amazon : ${ratingLabel} sur 5`}></span>
          <span class="reglette__val"><b>{ratingLabel}</b>/5 · {nf.format(rating.count)} avis Amazon</span>
        </p>
      )}
      {blurb && <p class="fiche__blurb">{blurb}</p>}
      {(pros.length > 0 || cons.length > 0) && (
        <div class="fiche__pc">
          {pros.length > 0 && (
            <div class="fiche__col fiche__col--pro">
              <p class="fiche__col-title">On aime</p>
              <ul>{pros.map((p) => <li>{p}</li>)}</ul>
            </div>
          )}
          {cons.length > 0 && (
            <div class="fiche__col fiche__col--con">
              <p class="fiche__col-title">Ce qui peut gêner</p>
              <ul>{cons.map((c) => <li>{c}</li>)}</ul>
            </div>
          )}
        </div>
      )}
      {!available && (
        <p class="fiche__na"><span>Épuisé</span> Ce modèle n'est plus en stock chez Amazon. Le lien ouvre une recherche de modèles équivalents.</p>
      )}
      <a class="btn btn--buy fiche__cta" href={affiliateUrl} target="_blank" rel="nofollow sponsored noopener">
        {available ? 'Voir le prix sur Amazon' : 'Voir les modèles équivalents'} <Icon name="external" size={16} />
      </a>
    </div>
  </div>
</article>

<style>
  .fiche { position: relative; margin: 1.9rem 0; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); box-shadow: var(--ombre); }
  .fiche--choix { border-color: var(--jaune); box-shadow: 0 0 0 3px var(--jaune-pale), var(--ombre); }
  /* Onglet posé sur le filet du haut, comme l'indice de révision d'un plan */
  .fiche__label { position: absolute; top: 0; right: 1.2rem; transform: translateY(-50%); margin: 0; padding: 0.35rem 0.8rem; font-family: var(--font-body); font-weight: 700; font-size: 0.78rem; line-height: 1; color: var(--mine); background: var(--papier); border: 1px solid var(--filet); border-radius: 999px; }
  .fiche--choix .fiche__label { color: var(--sur-jaune); background: var(--jaune); border-color: var(--jaune); }
  .fiche__grid { display: grid; grid-template-columns: 168px minmax(0, 1fr); gap: 1.4rem; padding: 1.1rem 1.2rem 1.3rem; }
  .fiche__media { display: flex; align-items: center; justify-content: center; align-self: start; aspect-ratio: 1; padding: 0.9rem; background: var(--image-fond); border: 1px solid var(--filet); border-radius: var(--radius); }
  .fiche__media img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .fiche__body { display: flex; flex-direction: column; gap: 0.8rem; min-width: 0; }
  .fiche__title { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 1rem; line-height: 1.3; letter-spacing: -0.02em; }
  .fiche__blurb { margin: 0; color: var(--gris); font-size: 0.95rem; line-height: 1.55; }
  .fiche__pc { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem 1.4rem; }
  .fiche__col-title { margin: 0 0 0.35rem; font-family: var(--font-body); font-weight: 700; font-size: 0.82rem; }
  .fiche__col--pro .fiche__col-title { color: var(--ok); }
  .fiche__col--con .fiche__col-title { color: var(--gene); }
  .fiche__col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.3rem; }
  .fiche__col li { position: relative; padding-left: 1.3em; font-size: 0.9rem; line-height: 1.45; }
  .fiche__col li::before, .fiche__col--pro li::after { content: ''; position: absolute; left: 0.1em; top: 0.72em; width: 0.62em; height: 1.5px; background: currentColor; }
  .fiche__col--pro li::before, .fiche__col--pro li::after { background: var(--ok); }
  .fiche__col--pro li::after { transform: rotate(90deg); }
  .fiche__col--con li::before { background: var(--gene); }
  .fiche__na { margin: 0; padding: 0.6rem 0.9rem; font-size: 0.88rem; line-height: 1.5; color: var(--gris); background: var(--papier-2); border-radius: var(--radius); }
  .fiche__na span { margin-right: 0.4em; font-weight: 700; font-size: 0.8rem; color: var(--erreur); }
  .fiche__cta { align-self: flex-start; }
  @media (max-width: 600px) {
    .fiche__grid { grid-template-columns: 1fr; }
    .fiche__media { max-width: 180px; }
    .fiche__pc { grid-template-columns: 1fr; }
  }
</style>
