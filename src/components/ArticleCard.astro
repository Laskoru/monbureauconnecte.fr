---
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '../siteConfig';
import { resolveCoverImage, coverSrcSet } from '../lib/covers';
import { categories } from '../categories';
import Icon from './Icon.astro';
import { frenchNbsp } from '../lib/typo';

interface Props {
  article: CollectionEntry<'articles'>;
  /** « feature » : grande planche horizontale ; « row » : ligne compacte ; sinon planche verticale. */
  variant?: 'default' | 'feature' | 'row';
  eager?: boolean;
  featured?: boolean;
}

const { article, variant = 'default', eager = false } = Astro.props;
const cover = resolveCoverImage(article.slug, article.data.coverImage);
const cat = categories.find((c) => c.slug === article.data.category);
const dateFormatter = new Intl.DateTimeFormat(siteConfig.locale.replace('_', '-'), { day: 'numeric', month: 'short', year: 'numeric' });
const date = article.data.updatedDate ?? article.data.pubDate;
const readingMinutes = Math.max(1, Math.round(article.body.trim().split(/\s+/).length / 200));
const href = `/articles/${article.slug}/`;
const nbProducts = article.data.products?.length ?? 0;
const produits = nbProducts > 0 ? `${nbProducts} produit${nbProducts > 1 ? 's' : ''}` : null;
---

{variant === 'feature' ? (
  <article class="feat">
    <a class="feat__media cadre" href={href} tabindex="-1" aria-hidden="true">
      {cover && <img src={cover} srcset={coverSrcSet(cover)} sizes="(max-width: 900px) 100vw, 560px" alt="" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" width="1600" height="1000" />}
    </a>
    <div class="feat__body">
      <p class="kick">{cat && <span>{cat.label}</span>}{produits && <span class="mono">{produits}</span>}</p>
      <h3 class="feat__title"><a href={href}>{frenchNbsp(article.data.title)}</a></h3>
      <p class="feat__desc">{article.data.description}</p>
      <p class="meta">{dateFormatter.format(date)} · {readingMinutes} min</p>
    </div>
  </article>
) : variant === 'row' ? (
  <article class="row">
    <div class="row__media">{cover && <img src={cover} srcset={coverSrcSet(cover)} sizes="160px" alt="" loading="lazy" decoding="async" width="480" height="300" />}</div>
    <div class="row__body">
      {cat && <span class="row__cat">{cat.label}</span>}
      <h3 class="row__title"><a class="stretched-link" href={href}>{frenchNbsp(article.data.title)}</a></h3>
      <p class="meta">{dateFormatter.format(date)} · {readingMinutes} min</p>
    </div>
  </article>
) : (
  <article class="pc">
    <div class="pc__media cadre">
      {cover ? <img src={cover} srcset={coverSrcSet(cover)} sizes="(max-width: 700px) 100vw, 400px" alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" width="1600" height="1000" /> : <span class="pc__ph" aria-hidden="true"><Icon name={cat?.slug ?? 'monitor'} size={40} /></span>}
    </div>
    <p class="kick">{cat && <span>{cat.label}</span>}{produits && <span class="mono">{produits}</span>}</p>
    <h3 class="pc__title"><a class="stretched-link" href={href}>{frenchNbsp(article.data.title)}</a></h3>
    <p class="pc__desc">{article.data.description}</p>
    <p class="meta">{dateFormatter.format(date)} · {readingMinutes} min</p>
  </article>
)}

<style>
  .kick { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.8rem; font-size: 0.85rem; font-weight: 600; color: var(--mine); }
  .kick .mono { font-weight: 400; font-size: 0.78rem; color: var(--gris); }
  .meta { margin: 0; }

  /* Planche verticale */
  .pc { position: relative; display: flex; flex-direction: column; gap: 0.55rem; height: 100%; }
  .pc__media { position: relative; margin-bottom: 0.4rem; }
  .pc__media img { aspect-ratio: 16 / 10; object-fit: cover; transition: filter 0.3s ease; }
  .pc__ph { display: flex; align-items: center; justify-content: center; aspect-ratio: 16 / 10; background: var(--papier-2); color: var(--gris); }
  .pc__title { margin: 0; font-size: 1.15rem; line-height: 1.3; }
  .pc__title a { text-decoration: none; }
  .pc:hover .pc__title a { text-decoration: underline; text-decoration-color: var(--jaune); text-decoration-thickness: 0.42em; text-underline-offset: -0.18em; }
  .pc__desc { margin: 0; color: var(--gris); font-size: 0.93rem; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pc .meta { margin-top: auto; padding-top: 0.2rem; }

  /* Grande planche horizontale */
  .feat { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 2.5rem; align-items: center; }
  .feat__media img { aspect-ratio: 4 / 3; object-fit: cover; }
  .feat__body { display: flex; flex-direction: column; gap: 0.9rem; }
  .feat__title { margin: 0; font-family: var(--font-display); font-stretch: 125%; font-weight: 300; font-size: clamp(1.6rem, 1.1rem + 1.4vw, 2.3rem); line-height: 1.08; letter-spacing: -0.02em; }
  .feat__title a { text-decoration: none; }
  .feat__title a:hover { text-decoration: underline; text-decoration-color: var(--jaune); text-decoration-thickness: 0.3em; text-underline-offset: -0.12em; }
  .feat__desc { margin: 0; color: var(--gris); font-size: 1.02rem; line-height: 1.6; max-width: 52ch; }

  /* Ligne compacte */
  .row { position: relative; display: grid; grid-template-columns: 112px 1fr; align-items: center; gap: 1rem; padding: 0.8rem 0; border-top: 1px solid var(--filet); }
  .row__media img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 1px solid var(--filet); }
  .row__body { min-width: 0; }
  .row__cat { font-size: 0.8rem; font-weight: 600; color: var(--gris); }
  .row__title { margin: 0.15rem 0 0.3rem; font-size: 1.02rem; line-height: 1.3; }
  .row__title a { text-decoration: none; }
  .row:hover .row__title a { text-decoration: underline; text-decoration-color: var(--jaune); text-decoration-thickness: 0.42em; text-underline-offset: -0.18em; }
  @media (max-width: 760px) { .feat { grid-template-columns: 1fr; gap: 1.2rem; } }
  @media (max-width: 480px) { .row { grid-template-columns: 92px 1fr; } }
</style>
