---
// En-tête de page intérieure : fil d'Ariane, titre, chapeau. Sobre, aligné à gauche.
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import { frenchNbsp } from '../lib/typo';

interface Crumb { label: string; href?: string }
interface Props {
  eyebrow?: string; // conservé pour compatibilité, non affiché
  title: string;
  lede?: string;
  icon?: string;
  crumbs?: Crumb[];
  count?: string;
  /** Largeur du contenu : « narrow » (720) ou « wide » (1160). */
  width?: 'narrow' | 'wide';
}
const { title, lede, icon, crumbs, count, width = 'wide' } = Astro.props;
---

<header class="ph">
  <div class:list={['ph__in', width === 'narrow' ? 'container' : 'wide']}>
    {crumbs && <Breadcrumbs items={crumbs} />}
    <div class="ph__row">
      {icon && <span class="ph__icon"><Icon name={icon} size={24} /></span>}
      <div class="ph__text">
        <h1 class="ph__title">{frenchNbsp(title)}</h1>
        {lede && <p class="ph__lede">{lede}</p>}
        <slot />
      </div>
      {count && <p class="ph__count">{count}<span>comparatifs</span></p>}
    </div>
  </div>
</header>

<style>
  .ph { background: var(--color-surface); border-bottom: 1px solid var(--color-border); }
  .ph__in { padding-top: 1.2rem; padding-bottom: 2rem; }
  .ph__row { display: flex; gap: 1.2rem; align-items: flex-start; margin-top: .6rem; }
  .ph__icon { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; width: 52px; height: 52px; border-radius: var(--radius); background: var(--color-accent-soft); color: var(--color-accent-text); margin-top: .35rem; }
  .ph__text { flex: 1; min-width: 0; }
  .ph__title { margin: 0 0 .6rem; font-size: clamp(1.9rem, 4vw, 2.8rem); }
  .ph__lede { margin: 0; font-size: 1.06rem; line-height: 1.6; color: var(--color-text-muted); max-width: 66ch; }
  .ph__count { flex-shrink: 0; margin: .4rem 0 0; display: flex; flex-direction: column; align-items: center; padding: .6rem 1rem; border-radius: var(--radius); background: var(--color-bg-soft); font-family: var(--font-display); font-weight: 800; font-size: 1.8rem; line-height: 1; color: var(--color-accent-text); }
  .ph__count span { font-family: var(--font-body); font-weight: 600; font-size: .7rem; color: var(--color-text-muted); margin-top: .3rem; }
  @media (max-width: 640px) { .ph__count { display: none; } .ph__icon { width: 44px; height: 44px; } }
</style>
