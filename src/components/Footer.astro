---
import { getCollection } from 'astro:content';
import { siteConfig } from '../siteConfig';
import { categories } from '../categories';
import { guides } from '../guides';
import { budgets } from '../budgets';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const nbArticles = (await getCollection('articles', ({ data }) => !data.draft)).length;
---

<footer class="ftr">
  <div class="wide ftr__grid">
    <div class="ftr__brand">
      <a href="/" class="ftr__logo" aria-label={`${siteConfig.name}, accueil`}>
        <Logo size={40} />
        <span>Mon Bureau Connecté</span>
      </a>
      <p class="ftr__tagline">{siteConfig.tagline}</p>
      <p class="ftr__spec">Plateau 74 cm · coudes à 90° · écran à 50–70 cm</p>
      <div class="ftr__social">
        {siteConfig.social?.pinterest && (
          <a href={siteConfig.social.pinterest} target="_blank" rel="noopener" aria-label="Mon Bureau Connecté sur Pinterest">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.4 9.3-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.5 2.1-.8 3.3-.2 1 .5 1.8 1.5 1.8 1.8 0 3.1-1.9 3.1-4.6 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.5 2.1-4.5 4.4 0 .9.3 1.8.8 2.3.1.1.1.2.1.3l-.3 1.2c0 .2-.2.2-.4.1-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2.1-1.3 2.8.9.3 1.9.4 2.9.4 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
          </a>
        )}
        <a href="/rss.xml" aria-label="Flux RSS">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1" fill="currentColor"/></svg>
        </a>
      </div>
    </div>

    <nav class="ftr__col" aria-label="Rayons et budgets">
      <p class="ftr__heading">Rayons</p>
      {categories.map((cat) => <a href={`/categorie/${cat.slug}/`}>{cat.label}</a>)}
      <a href="/articles/">Tous les comparatifs</a>
      <p class="ftr__heading ftr__heading--2">Budgets</p>
      {budgets.map((b) => <a href={`/budget/${b.slug}/`}>{b.label}</a>)}
    </nav>

    <nav class="ftr__col" aria-label="Guides par besoin">
      <p class="ftr__heading">Par besoin</p>
      {guides.map((g) => <a href={`/guides/${g.slug}/`}>{g.title}</a>)}
    </nav>

    <nav class="ftr__col" aria-label="Outils et le site">
      <p class="ftr__heading">Outils gratuits</p>
      <a href="/calculateur-hauteur-bureau/">Calculateur de hauteur de bureau</a>
      <a href="/poste-de-travail-ideal/">Le poste de travail idéal</a>
      <a href="/checklist-bureau-ergonomique/">Checklist ergonomie</a>
      <a href="/guide-pc-gaming/">Guide PC gaming pièce par pièce</a>
      <a href="/lexique/">Lexique</a>
      <p class="ftr__heading ftr__heading--2">Le site</p>
      <a href="/a-propos/">Notre méthode</a>
      <a href="/auteur/">L'auteur</a>
      <a href="/contact/">Contact</a>
      <a href="/mentions-legales/">Mentions légales</a>
      <a href="/politique-de-confidentialite/">Confidentialité</a>
    </nav>
  </div>

  <div class="wide">
    <dl class="ftr__cartouche">
      <div><dt>Site</dt><dd>{siteConfig.name}</dd></div>
      <div><dt>Comparatifs</dt><dd class="mono">{nbArticles}</dd></div>
      <div><dt>Outils</dt><dd class="mono">5</dd></div>
      <div><dt>Révision</dt><dd class="mono">{year}</dd></div>
      <div><dt>Rédaction</dt><dd>Indépendante, aucune marque ne paie pour figurer</dd></div>
    </dl>
    <p class="ftr__disclosure">
      &copy; {year} {siteConfig.name}. En tant que Partenaire Amazon, {siteConfig.name} réalise un bénéfice sur les achats
      remplissant les conditions requises. Certains liens sont des liens affiliés, sans surcoût pour toi.
    </p>
  </div>
</footer>

<style>
  .ftr { background: var(--bande); color: var(--sur-bande); padding: 4rem 0 2rem; border-top: 4px solid var(--jaune); }
  .ftr__grid { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr); gap: 2.5rem 2rem; }
  .ftr__logo { display: inline-flex; align-items: center; gap: 0.8rem; text-decoration: none; color: var(--sur-bande); font-family: var(--font-display); font-stretch: 125%; font-weight: 500; font-size: 1.15rem; letter-spacing: -0.01em; }
  .ftr__tagline { margin: 1.1rem 0 0.5rem; color: var(--sur-bande-2); max-width: 34ch; line-height: 1.55; }
  .ftr__spec { margin: 0 0 1.3rem; font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.6; color: var(--jaune); text-wrap: balance; }
  .ftr__social { display: flex; gap: 0.5rem; }
  .ftr__social a { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 1px solid var(--bande-filet); border-radius: var(--radius-sm); color: var(--sur-bande); transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease; }
  .ftr__social a:hover { background: var(--jaune); border-color: var(--jaune); color: #15171a; }
  .ftr__social svg { width: 20px; height: 20px; }
  .ftr__col { display: flex; flex-direction: column; gap: 0.35rem; }
  .ftr__heading { margin: 0 0 0.5rem; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sur-bande-2); }
  .ftr__heading--2 { margin-top: 1.3rem; }
  .ftr__col a { color: var(--sur-bande); text-decoration: none; font-size: 0.93rem; line-height: 1.4; padding: 0.2rem 0; }
  .ftr__col a:hover { text-decoration: underline; text-decoration-color: var(--jaune); text-decoration-thickness: 2px; text-underline-offset: 0.25em; }

  .ftr__cartouche { display: grid; grid-template-columns: 1.3fr 0.7fr 0.6fr 0.7fr 2fr; margin: 3.5rem 0 1.2rem; border: 1px solid var(--sur-bande-2); }
  .ftr__cartouche > div { padding: 0.6rem 0.9rem 0.7rem; border-right: 1px solid var(--bande-filet); min-width: 0; }
  .ftr__cartouche > div:last-child { border-right: 0; }
  .ftr__cartouche dt { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--sur-bande-2); }
  .ftr__cartouche dd { margin: 0.2rem 0 0; font-weight: 600; font-size: 0.92rem; line-height: 1.35; }
  .ftr__cartouche dd.mono { font-family: var(--font-mono); font-weight: 400; }
  .ftr__disclosure { margin: 0; font-size: 0.82rem; line-height: 1.6; color: var(--sur-bande-2); max-width: 90ch; }

  @media (max-width: 960px) {
    .ftr__grid { grid-template-columns: 1fr 1fr; }
    .ftr__brand { grid-column: 1 / -1; }
    .ftr__cartouche { grid-template-columns: repeat(4, 1fr); }
    .ftr__cartouche > div:last-child { grid-column: 1 / -1; border-top: 1px solid var(--bande-filet); }
    .ftr__cartouche > div:nth-child(4) { border-right: 0; }
  }
  @media (max-width: 560px) {
    .ftr__grid { grid-template-columns: 1fr; gap: 2rem; }
    .ftr__cartouche { grid-template-columns: 1fr 1fr; }
    .ftr__cartouche > div { border-bottom: 1px solid var(--bande-filet); }
    .ftr__cartouche > div:nth-child(2n) { border-right: 0; }
  }
</style>
