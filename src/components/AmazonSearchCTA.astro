---
import { searchUrl } from '../lib/availability';
import Icon from './Icon.astro';

interface Props {
  /** Le sujet recherché, ex. "chaise gaming" — sert de requête et s'affiche dans le bouton. */
  topic: string;
  intro?: string;
  sub?: string;
}

const {
  topic,
  intro = 'Envie de comparer toi-même les modèles du moment ?',
  sub = 'Prix, avis et disponibilité en direct sur Amazon.',
} = Astro.props;

// Nettoie la requête : on retire les mots qui n'ont aucun sens comme recherche
// Amazon (gratuit, avis, comparatif, meilleur, guide, années…) pour éviter des
// recherches absurdes comme « ergonomie bureau gratuit ».
const cleanTopic = topic
  .replace(/\b(gratuit|gratuite|gratuits|gratuites|avis|comparatif|comparatifs|test|tests|meilleur|meilleure|meilleurs|meilleures|pas cher|guide|20\d\d)\b/gi, '')
  .replace(/\s+/g, ' ')
  .trim() || topic;

const url = searchUrl(cleanTopic);
---

<div class="amazon-search-cta">
  <Icon name="search" size={22} class="amazon-search-cta__icon" />
  <div class="amazon-search-cta__body">
    <p class="amazon-search-cta__intro">{intro}</p>
    <p class="amazon-search-cta__sub">{sub}</p>
  </div>
  <a class="btn btn--buy amazon-search-cta__link" href={url} target="_blank" rel="nofollow sponsored noopener">
    Voir « {cleanTopic} » <Icon name="external" size={16} />
  </a>
</div>

<style>
  /* Bandeau réglé : filet mine en tête, filet fin en pied, bouton d'achat jaune */
  .amazon-search-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.2rem;
    margin: 1.75rem 0;
    padding: 1.1rem 1.2rem;
    background: var(--papier);
    border-top: 1.5px solid var(--mine);
    border-bottom: 1px solid var(--filet);
  }
  .amazon-search-cta :global(.amazon-search-cta__icon) { flex-shrink: 0; color: var(--mine); }
  .amazon-search-cta__body { flex: 1 1 220px; min-width: 0; }
  .amazon-search-cta__intro { margin: 0; font-weight: 600; font-size: 1rem; line-height: 1.4; color: var(--mine); }
  .amazon-search-cta__sub { margin: 0.2rem 0 0; font-size: 0.88rem; line-height: 1.5; color: var(--gris); }
  /* Le texte du bouton dépend du sujet (longueur variable) : il DOIT pouvoir
     passer à la ligne, sinon il déborde du bloc — et donc de la page — sur
     mobile (bug réel rencontré et corrigé le 17/08/2026). */
  .amazon-search-cta__link { flex: 0 1 auto; min-width: 0; white-space: normal; text-align: center; }

  @media (max-width: 480px) {
    .amazon-search-cta :global(.amazon-search-cta__icon) { display: none; }
    .amazon-search-cta__link { width: 100%; }
  }
</style>
