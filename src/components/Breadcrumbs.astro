---
interface Item { label: string; href?: string }

interface Props {
  items: Item[];
}

const { items } = Astro.props;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site ?? Astro.url.origin).toString() } : {}),
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<nav class="breadcrumbs" aria-label="Fil d'Ariane">
  <ol>
    {items.map((item, i) => (
      <li>
        {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        {i < items.length - 1 && <span class="breadcrumbs__sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs { margin-bottom: 0.9rem; }
  .breadcrumbs ol { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.45rem; margin: 0; padding: 0; font-size: 0.85rem; }
  .breadcrumbs li { display: flex; align-items: center; gap: 0.45rem; min-width: 0; }
  .breadcrumbs a { display: inline-flex; align-items: center; min-height: 32px; color: var(--gris); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--mine); text-decoration: underline; text-decoration-color: var(--jaune); text-decoration-thickness: 2px; text-underline-offset: 0.3em; }
  .breadcrumbs span[aria-current] { color: var(--gris); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 46ch; }
  .breadcrumbs__sep { color: var(--filet-fort); }
</style>
