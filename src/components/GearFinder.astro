---
// Guide interactif « Trouve ton matériel » : 2 questions -> reco + lien de recherche Amazon.
import { siteConfig } from '../siteConfig';
const tag = siteConfig.amazon.tag;
---

<section class="finder section" id="guide">
  <div class="wide finder__inner">
    <h2 class="finder__title section__title">Trouve ton matériel en 30 secondes</h2>
    <p class="finder__lede section__lede">Réponds à 2 questions, on te dit exactement quoi regarder — et où.</p>
    <div class="finder__card" id="finderCard" data-tag={tag}></div>
  </div>
</section>

<style>
  /* Un panneau papier au filet mine ; le résultat reçoit le filet jaune de 4 px */
  .finder__card { position: relative; max-width: 720px; padding: 1.6rem 1.6rem 1.5rem; background: var(--papier); color: var(--mine); border: 1px solid var(--mine); }
  .finder__card.is-result { border-top: 4px solid var(--jaune); }
  .finder__card :global(.prog) { display: flex; gap: 6px; margin-bottom: 1.3rem; }
  .finder__card :global(.prog i) { height: 3px; flex: 1; background: var(--filet); transition: background-color 0.3s ease; }
  .finder__card :global(.prog i.on) { background: var(--mine); }
  .finder__card :global(.q) { margin: 0 0 1.2rem; font-family: var(--font-display); font-stretch: 125%; font-weight: 400; font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.7rem); line-height: 1.12; letter-spacing: -0.015em; }
  .finder__card :global(.opts) { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .finder__card :global(.opt) { display: flex; align-items: center; gap: 0.8rem; min-height: 56px; padding: 0.8rem 1rem; text-align: left; border: 1.5px solid var(--mine); border-radius: var(--radius-sm); background: transparent; color: var(--mine); font-family: var(--font-body); font-weight: 600; font-size: 0.98rem; line-height: 1.25; cursor: pointer; transition: background-color 0.18s ease, color 0.18s ease; }
  .finder__card :global(.opt:hover) { background: var(--jaune-pale); }
  .finder__card :global(.opt.is-active), .finder__card :global(.opt:active) { background: var(--jaune); color: var(--sur-jaune); }
  .finder__card :global(.opt svg) { width: 22px; height: 22px; flex: 0 0 auto; }
  .finder__card :global(.back) { display: inline-flex; align-items: center; gap: 0.4em; min-height: 40px; margin: 1rem 0 0; padding: 0; background: none; border: 0; color: var(--gris); font: 600 0.9rem var(--font-body); cursor: pointer; }
  .finder__card :global(.back:hover) { color: var(--mine); }
  .finder__card :global(.back svg) { width: 16px; height: 16px; flex: 0 0 auto; }
  .finder__card :global(.result) { animation: finder-in 0.32s var(--ease-out); }
  @keyframes finder-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .finder__card :global(.result h3) { margin: 0; font-size: 1.4rem; line-height: 1.25; }
  .finder__card :global(.result p) { margin: 0.6rem 0 0; max-width: 52ch; color: var(--gris); line-height: 1.6; }
  .finder__card :global(.ract) { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.4rem; }
  @media (max-width: 560px) { .finder__card :global(.opts) { grid-template-columns: 1fr; } .finder__card { padding: 1.2rem; } }
</style>

<script>
  const card = document.getElementById('finderCard');
  if (card) {
    const TAG = card.dataset.tag || '';
    // Même trait que Icon.astro (1,6 px) : aucune flèche ni aucun symbole en caractère.
    const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
    const I: Record<string, string> = {
      home: svg('<path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>'),
      game: svg('<rect x="2" y="7" width="20" height="10" rx="5"/><path d="M6 12h4M8 10v4"/><path d="M15 11h.01M18 13h.01"/>'),
      brush: svg('<path d="M14 3l7 7-9 9H5v-7z"/><path d="M12 5l7 7"/>'),
      shuffle: svg('<path d="M16 3h5v5"/><path d="M4 20 21 3"/><path d="M21 16v5h-5"/><path d="M15 15l6 6"/><path d="M4 4l5 5"/>'),
      chair: svg('<rect x="7" y="3" width="10" height="9" rx="2"/><path d="M4 14h16"/><path d="M5 14v-2M19 14v-2"/><path d="M6 21l1-7M18 21l-1-7"/>'),
      headphones: svg('<path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/>'),
      ruler: svg('<path d="M21 7 7 21l-4-4L17 3z"/><path d="m14 6 2 2M11 9l2 2M8 12l2 2"/>'),
      plug: svg('<path d="M9 2v6M15 2v6"/><path d="M6 8h12v3a6 6 0 0 1-12 0z"/><path d="M12 17v5"/>'),
      back: svg('<path d="M19 12H5"/><path d="m11 18-6-6 6-6"/>'),
      refresh: svg('<path d="M20 12a8 8 0 1 1-2.3-5.7"/><path d="M20 3v5h-5"/>'),
      external: svg('<path d="M7 17 17 7"/><path d="M8 7h9v9"/>'),
    };
    const STEPS = [
      { key: 'usage', q: 'Tu bosses surtout en…', opts: [
        { v: 'tele', t: 'Télétravail', e: 'home' }, { v: 'game', t: 'Gaming', e: 'game' },
        { v: 'creatif', t: 'Studio créatif', e: 'brush' }, { v: 'mixte', t: 'Un peu de tout', e: 'shuffle' } ] },
      { key: 'pain', q: 'Ta galère n°1 ?', opts: [
        { v: 'dos', t: 'Mal de dos', e: 'chair' }, { v: 'bruit', t: 'Bruit en visio', e: 'headphones' },
        { v: 'place', t: 'Manque de place', e: 'ruler' }, { v: 'cable', t: 'Trop de câbles', e: 'plug' } ] },
    ];
    const RES: Record<string, { e: string; t: string; w: string; q: string; a: string }> = {
      dos: { e: 'chair', t: 'Une assise ergonomique', w: 'Ton dos d’abord : une bonne chaise ergo (ou un coussin lombaire) change tout sur 8 h de poste.', q: 'chaise+bureau+ergonomique', a: '/guides/mal-de-dos/' },
      bruit: { e: 'headphones', t: 'Un casque à réduction de bruit', w: 'Pour des visios nettes et de la concentration : l’ANC coupe l’open space et le brouhaha.', q: 'casque+reduction+de+bruit+teletravail', a: '/articles/casque-reduction-bruit-teletravail/' },
      place: { e: 'ruler', t: 'Du compact malin', w: 'Gagne de la place : un clavier TKL sans pavé numérique et un bureau assis-debout compact.', q: 'clavier+compact+tkl', a: '/guides/petit-bureau-rangement/' },
      cable: { e: 'plug', t: 'Un hub USB-C / station d’accueil', w: 'Un seul câble pour tout brancher : écran, SSD, réseau et charge du PC portable.', q: 'hub+usb+c+station+accueil', a: '/articles/hub-usb-c-station-accueil/' },
    };
    const state: { step: number; ans: Record<string, string> } = { step: 0, ans: {} };
    function reco() {
      const p = state.ans.pain; const r = Object.assign({}, RES[p]);
      if (state.ans.usage === 'game' && p === 'dos') { r.t = 'Une chaise gaming'; r.w = 'Assise enveloppante pensée pour les longues sessions, avec un vrai maintien lombaire.'; r.q = 'chaise+gaming'; r.a = '/articles/meilleures-chaises-gaming/'; }
      return r;
    }
    function render() {
      card.classList.toggle('is-result', state.step >= STEPS.length);
      if (state.step >= STEPS.length) {
        const r = reco();
        card.innerHTML = '<div class="result"><h3>' + r.t + '</h3><p>' + r.w + '</p>'
          + '<div class="ract"><a class="btn btn--outline" href="' + r.a + '">Lire notre comparatif</a>'
          + '<a class="btn btn--buy" target="_blank" rel="sponsored noopener" href="https://www.amazon.fr/s?k=' + r.q + '&tag=' + TAG + '">Voir sur Amazon ' + I.external + '</a></div>'
          + '<button class="back" id="frestart">' + I.refresh + 'Recommencer</button></div>';
        document.getElementById('frestart')!.addEventListener('click', () => { state.step = 0; state.ans = {}; render(); });
        return;
      }
      const s = STEPS[state.step];
      // La réponse déjà donnée (retour arrière) reste marquée en jaune : état sélectionné.
      card.innerHTML = '<div class="prog">' + STEPS.map((_, i) => '<i class="' + (i <= state.step ? 'on' : '') + '"></i>').join('') + '</div>'
        + '<div class="q">' + s.q + '</div>'
        + '<div class="opts">' + s.opts.map((o) => '<button class="opt' + (state.ans[s.key] === o.v ? ' is-active' : '') + '" data-v="' + o.v + '">' + I[o.e] + o.t + '</button>').join('') + '</div>'
        + (state.step > 0 ? '<button class="back" id="fback">' + I.back + 'Retour</button>' : '');
      card.querySelectorAll<HTMLButtonElement>('.opt').forEach((b) => b.addEventListener('click', () => { state.ans[s.key] = b.dataset.v!; state.step++; render(); }));
      const bk = document.getElementById('fback'); if (bk) bk.addEventListener('click', () => { state.step--; render(); });
    }
    render();
  }
</script>
