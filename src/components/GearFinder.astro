---
// Guide interactif « Trouve ton matériel » : 2 questions -> reco + lien de recherche Amazon.
import { siteConfig } from '../siteConfig';
import Icon from './Icon.astro';
const tag = siteConfig.amazon.tag;
---

<section class="finder section night blueprint--night" id="guide">
  <div class="wide finder__inner">
    <p class="finder__eyebrow"><Icon name="sliders" size={16} /> Guide express</p>
    <h2 class="finder__title">Trouve ton matériel en 30 secondes</h2>
    <p class="finder__lede">Réponds à 2 questions, on te dit exactement quoi regarder — et où.</p>
    <div class="finder__card" id="finderCard" data-tag={tag}></div>
  </div>
</section>

<style>
  .finder__inner { text-align: center; }
  .finder__eyebrow { display: inline-flex; align-items: center; gap: .5em; margin: 0 0 .6rem; font-family: var(--font-mono); font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; color: var(--color-signal); }
  .finder__title { margin: 0; font-size: clamp(1.7rem, 3.2vw, 2.4rem); }
  .finder__lede { color: var(--color-on-night-muted); margin: .7rem auto 1.8rem; max-width: 46ch; }
  .finder__card { position: relative; max-width: 640px; margin: 0 auto; text-align: left; background: var(--color-surface); color: var(--color-text); border-radius: var(--radius-lg); padding: 1.8rem; box-shadow: var(--shadow-lg); border-top: 4px solid var(--color-signal); }
  .finder__card :global(.prog) { display: flex; gap: 6px; margin-bottom: 1.3rem; }
  .finder__card :global(.prog i) { height: 4px; flex: 1; background: var(--color-border); transition: background .3s; }
  .finder__card :global(.prog i.on) { background: var(--color-accent); }
  .finder__card :global(.q) { font-family: var(--font-display); font-weight: 700; font-stretch: 106%; font-size: 1.35rem; text-align: center; margin-bottom: 1.2rem; }
  .finder__card :global(.opts) { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; }
  .finder__card :global(.opt) { display: flex; align-items: center; gap: .8rem; text-align: left; min-height: 56px; padding: .8rem 1rem; border-radius: var(--radius); border: 1px solid var(--color-border-strong); background: var(--color-bg); color: var(--color-text); font-family: var(--font-body); font-weight: 600; font-size: .98rem; cursor: pointer; transition: border-color .15s, background .15s, transform .1s; }
  .finder__card :global(.opt:hover) { border-color: var(--color-accent); background: var(--color-accent-soft); transform: translateY(-2px); }
  .finder__card :global(.opt svg) { width: 22px; height: 22px; flex: 0 0 auto; color: var(--color-accent-text); }
  .finder__card :global(.back) { display: block; margin: 1.1rem auto 0; background: none; border: 0; color: var(--color-text-muted); font: 600 .88rem var(--font-body); cursor: pointer; min-height: 32px; }
  .finder__card :global(.back:hover) { color: var(--color-text); }
  .finder__card :global(.result) { text-align: center; animation: finderpop .35s ease; }
  @keyframes finderpop { from { opacity: 0; transform: scale(.96); } to { opacity: 1; transform: none; } }
  .finder__card :global(.result .badge) { display: inline-block; font-family: var(--font-mono); color: var(--color-signal-text); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; background: var(--color-signal-soft); padding: .35em .8em; border-radius: var(--radius-sm); }
  .finder__card :global(.result .ico) { display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: var(--radius); background: var(--color-night); color: var(--color-signal); margin: .9rem 0 .3rem; }
  .finder__card :global(.result .ico svg) { width: 32px; height: 32px; }
  .finder__card :global(.result h3) { font-family: var(--font-display); font-stretch: 106%; font-size: 1.5rem; margin: .4rem 0 0; }
  .finder__card :global(.result p) { color: var(--color-text-muted); max-width: 42ch; margin: .6rem auto 0; }
  .finder__card :global(.ract) { display: flex; gap: .7rem; justify-content: center; flex-wrap: wrap; margin-top: 1.4rem; }
  @media (max-width: 560px) { .finder__card :global(.opts) { grid-template-columns: 1fr; } .finder__card { padding: 1.3rem; } }
</style>

<script>
  const card = document.getElementById('finderCard');
  if (card) {
    const TAG = card.dataset.tag || '';
    const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
    const I: Record<string, string> = {
      home: svg('<path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>'),
      game: svg('<rect x="2" y="7" width="20" height="10" rx="5"/><path d="M6 12h4M8 10v4"/><path d="M15 11h.01M18 13h.01"/>'),
      brush: svg('<path d="M14 3l7 7-9 9H5v-7z"/><path d="M12 5l7 7"/>'),
      shuffle: svg('<path d="M16 3h5v5"/><path d="M4 20 21 3"/><path d="M21 16v5h-5"/><path d="M15 15l6 6"/><path d="M4 4l5 5"/>'),
      chair: svg('<rect x="7" y="3" width="10" height="9" rx="2"/><path d="M4 14h16"/><path d="M5 14v-2M19 14v-2"/><path d="M6 21l1-7M18 21l-1-7"/>'),
      headphones: svg('<path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/>'),
      ruler: svg('<path d="M21 7 7 21l-4-4L17 3z"/><path d="m14 6 2 2M11 9l2 2M8 12l2 2"/>'),
      plug: svg('<path d="M9 2v6M15 2v6"/><path d="M6 8h12v3a6 6 0 0 1-12 0z"/><path d="M12 17v5"/>'),
    };
    const STEPS = [
      { key: 'usage', q: 'Tu bosses surtout en…', opts: [
        { v: 'tele', t: 'Télétravail', e: 'home' }, { v: 'game', t: 'Gaming', e: 'game' },
        { v: 'creatif', t: 'Studio créatif', e: 'brush' }, { v: 'mixte', t: 'Un peu de tout', e: 'shuffle' } ] },
      { key: 'pain', q: 'Ta galère n°1 ?', opts: [
        { v: 'dos', t: 'Mal de dos', e: 'chair' }, { v: 'bruit', t: 'Bruit en visio', e: 'headphones' },
        { v: 'place', t: 'Manque de place', e: 'ruler' }, { v: 'cable', t: 'Trop de câbles', e: 'plug' } ] },
    ];
    const RES: Record<string, { e: string; t: string; w: string; q: string; a: string }> = {
      dos: { e: 'chair', t: 'Une assise ergonomique', w: 'Ton dos d’abord : une bonne chaise ergo (ou un coussin lombaire) change tout sur 8 h de poste.', q: 'chaise+bureau+ergonomique', a: '/guides/mal-de-dos/' },
      bruit: { e: 'headphones', t: 'Un casque à réduction de bruit', w: 'Pour des visios nettes et de la concentration : l’ANC coupe l’open space et le brouhaha.', q: 'casque+reduction+de+bruit+teletravail', a: '/articles/casque-reduction-bruit-teletravail/' },
      place: { e: 'ruler', t: 'Du compact malin', w: 'Gagne de la place : un clavier TKL sans pavé numérique et un bureau assis-debout compact.', q: 'clavier+compact+tkl', a: '/guides/petit-bureau-rangement/' },
      cable: { e: 'plug', t: 'Un hub USB-C / station d’accueil', w: 'Un seul câble pour tout brancher : écran, SSD, réseau et charge du PC portable.', q: 'hub+usb+c+station+accueil', a: '/articles/hub-usb-c-station-accueil/' },
    };
    const state: { step: number; ans: Record<string, string> } = { step: 0, ans: {} };
    function reco() {
      const p = state.ans.pain; const r = Object.assign({}, RES[p]);
      if (state.ans.usage === 'game' && p === 'dos') { r.t = 'Une chaise gaming'; r.w = 'Assise enveloppante pensée pour les longues sessions, avec un vrai maintien lombaire.'; r.q = 'chaise+gaming'; r.a = '/articles/meilleures-chaises-gaming/'; }
      return r;
    }
    function render() {
      if (state.step >= STEPS.length) {
        const r = reco();
        card.innerHTML = '<div class="result"><span class="badge">Notre reco</span>'
          + '<div class="ico">' + I[r.e] + '</div><h3>' + r.t + '</h3><p>' + r.w + '</p>'
          + '<div class="ract"><a class="btn btn--outline" href="' + r.a + '">Lire notre comparatif</a>'
          + '<a class="btn btn--primary" target="_blank" rel="sponsored noopener" href="https://www.amazon.fr/s?k=' + r.q + '&tag=' + TAG + '">Voir sur Amazon →</a></div>'
          + '<button class="back" id="frestart">↺ Recommencer</button></div>';
        document.getElementById('frestart')!.addEventListener('click', () => { state.step = 0; state.ans = {}; render(); });
        return;
      }
      const s = STEPS[state.step];
      card.innerHTML = '<div class="prog">' + STEPS.map((_, i) => '<i class="' + (i <= state.step ? 'on' : '') + '"></i>').join('') + '</div>'
        + '<div class="q">' + s.q + '</div>'
        + '<div class="opts">' + s.opts.map((o) => '<button class="opt" data-v="' + o.v + '">' + I[o.e] + o.t + '</button>').join('') + '</div>'
        + (state.step > 0 ? '<button class="back" id="fback">← Retour</button>' : '');
      card.querySelectorAll<HTMLButtonElement>('.opt').forEach((b) => b.addEventListener('click', () => { state.ans[s.key] = b.dataset.v!; state.step++; render(); }));
      const bk = document.getElementById('fback'); if (bk) bk.addEventListener('click', () => { state.step--; render(); });
    }
    render();
  }
</script>
