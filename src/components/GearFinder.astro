---
// Guide interactif « Trouve ton matériel » : 2 questions -> reco + lien de recherche Amazon.
import { siteConfig } from '../siteConfig';
const tag = siteConfig.amazon.tag;
---
<section class="finder" id="guide">
  <div class="wide finder__inner">
    <p class="finder__eyebrow">✦ Guide express ✦</p>
    <h2 class="finder__title">Trouve ton matériel en 30 secondes</h2>
    <p class="finder__lede">Réponds à 2 questions, on te dit exactement quoi regarder — et où.</p>
    <div class="finder__card" id="finderCard" data-tag={tag}></div>
  </div>
</section>

<style>
  .finder {
    padding: 3.6rem 0;
    background:
      radial-gradient(70% 120% at 12% 0%, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 55%),
      var(--color-bg-soft);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .finder__inner { text-align: center; }
  .finder__eyebrow { color: var(--color-signal); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; font-size: 0.74rem; margin: 0 0 0.6rem; }
  .finder__title { margin: 0; font-size: clamp(1.6rem, 3.4vw, 2.3rem); }
  .finder__lede { color: var(--color-text-muted); margin: 0.7rem auto 1.8rem; max-width: 46ch; }
  .finder__card {
    max-width: 640px; margin: 0 auto; text-align: left;
    background: linear-gradient(180deg, var(--color-surface-raised), var(--color-surface));
    border: 1px solid var(--color-border); border-radius: var(--radius-xl);
    padding: 1.9rem; box-shadow: var(--shadow-md);
  }
  .finder__card :global(.prog) { display: flex; gap: 8px; margin-bottom: 1.4rem; }
  .finder__card :global(.prog i) { height: 5px; flex: 1; border-radius: 3px; background: color-mix(in srgb, var(--color-text) 12%, transparent); transition: background 0.3s; }
  .finder__card :global(.prog i.on) { background: linear-gradient(90deg, var(--color-accent), var(--color-signal)); }
  .finder__card :global(.q) { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; text-align: center; margin-bottom: 1.2rem; }
  .finder__card :global(.opts) { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; }
  .finder__card :global(.opt) {
    display: flex; align-items: center; gap: 0.7rem; text-align: left;
    padding: 0.95rem 1rem; border-radius: var(--radius); border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-text) 3%, transparent); color: var(--color-text);
    font-family: var(--font-body); font-weight: 600; font-size: 0.98rem; cursor: pointer;
    transition: border-color 0.15s, background 0.15s, transform 0.1s;
  }
  .finder__card :global(.opt:hover) { border-color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 10%, transparent); transform: translateY(-2px); }
  .finder__card :global(.opt .emo) { font-size: 1.5rem; line-height: 1; flex: 0 0 auto; }
  .finder__card :global(.back) { display: block; margin: 1.1rem auto 0; background: none; border: 0; color: var(--color-text-muted); font: 600 0.88rem var(--font-body); cursor: pointer; }
  .finder__card :global(.back:hover) { color: var(--color-text); }
  .finder__card :global(.result) { text-align: center; animation: finderpop 0.35s ease; }
  @keyframes finderpop { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: none; } }
  .finder__card :global(.result .badge) { display: inline-block; color: var(--color-signal); font-weight: 700; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; background: color-mix(in srgb, var(--color-signal) 14%, transparent); border: 1px solid var(--color-border); padding: 0.35em 0.9em; border-radius: 999px; }
  .finder__card :global(.result .emo-big) { font-size: 3rem; margin: 0.7rem 0 0.2rem; }
  .finder__card :global(.result h3) { font-family: var(--font-display); font-size: 1.55rem; margin: 0.4rem 0 0; }
  .finder__card :global(.result p) { color: var(--color-text-muted); max-width: 42ch; margin: 0.6rem auto 0; }
  .finder__card :global(.ract) { display: flex; gap: 0.7rem; justify-content: center; flex-wrap: wrap; margin-top: 1.4rem; }
  @media (max-width: 560px) { .finder__card :global(.opts) { grid-template-columns: 1fr; } }
</style>

<script>
  const card = document.getElementById('finderCard');
  if (card) {
    const TAG = card.dataset.tag || '';
    const STEPS = [
      { key: 'usage', q: 'Tu bosses surtout en…', opts: [
        { v: 'tele', t: 'Télétravail', e: '🏠' }, { v: 'game', t: 'Gaming', e: '🎮' },
        { v: 'creatif', t: 'Studio créatif', e: '🎨' }, { v: 'mixte', t: 'Un peu de tout', e: '🔀' } ] },
      { key: 'pain', q: 'Ta galère n°1 ?', opts: [
        { v: 'dos', t: 'Mal de dos', e: '🪑' }, { v: 'bruit', t: 'Bruit en visio', e: '🎧' },
        { v: 'place', t: 'Manque de place', e: '📏' }, { v: 'cable', t: 'Trop de câbles', e: '🔌' } ] },
    ];
    const RES = {
      dos: { e: '🪑', t: 'Une assise ergonomique', w: 'Ton dos d’abord : une bonne chaise ergo (ou un coussin lombaire) change tout sur 8 h de poste.', q: 'chaise+bureau+ergonomique' },
      bruit: { e: '🎧', t: 'Un casque à réduction de bruit', w: 'Pour des visios nettes et de la concentration : l’ANC coupe l’open space et le brouhaha.', q: 'casque+reduction+de+bruit+teletravail' },
      place: { e: '📏', t: 'Du compact malin', w: 'Gagne de la place : un clavier TKL sans pavé numérique et un bureau assis-debout compact.', q: 'clavier+compact+tkl' },
      cable: { e: '🔌', t: 'Un hub USB-C / station d’accueil', w: 'Un seul câble pour tout brancher : écran, SSD, réseau et charge du PC portable.', q: 'hub+usb+c+station+accueil' },
    };
    const state = { step: 0, ans: {} };
    function reco() {
      const p = state.ans.pain; const r = Object.assign({}, RES[p]);
      if (state.ans.usage === 'game' && p === 'dos') { r.t = 'Une chaise gaming'; r.w = 'Assise enveloppante pensée pour les longues sessions, avec un vrai maintien lombaire.'; r.q = 'chaise+gaming'; }
      return r;
    }
    function render() {
      if (state.step >= STEPS.length) {
        const r = reco();
        card.innerHTML = '<div class="result"><span class="badge">✦ Notre reco</span>'
          + '<div class="emo-big">' + r.e + '</div><h3>' + r.t + '</h3><p>' + r.w + '</p>'
          + '<div class="ract"><a class="btn btn--primary" target="_blank" rel="sponsored noopener" href="https://www.amazon.fr/s?k=' + r.q + '&tag=' + TAG + '">Voir sur Amazon →</a>'
          + '<a class="btn btn--outline" href="/articles/">Lire les comparatifs</a></div>'
          + '<button class="back" id="frestart">↺ Recommencer</button></div>';
        document.getElementById('frestart').addEventListener('click', () => { state.step = 0; state.ans = {}; render(); });
        return;
      }
      const s = STEPS[state.step];
      card.innerHTML = '<div class="prog">' + STEPS.map((_, i) => '<i class="' + (i <= state.step ? 'on' : '') + '"></i>').join('') + '</div>'
        + '<div class="q">' + s.q + '</div>'
        + '<div class="opts">' + s.opts.map(o => '<button class="opt" data-v="' + o.v + '"><span class="emo">' + o.e + '</span>' + o.t + '</button>').join('') + '</div>'
        + (state.step > 0 ? '<button class="back" id="fback">← Retour</button>' : '');
      card.querySelectorAll('.opt').forEach(b => b.addEventListener('click', () => { state.ans[s.key] = b.dataset.v; state.step++; render(); }));
      const bk = document.getElementById('fback'); if (bk) bk.addEventListener('click', () => { state.step--; render(); });
    }
    render();
  }
</script>
