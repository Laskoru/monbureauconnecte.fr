---
// Marque « Studio » : un point chaud lime (pastille + anneau) sur un carré
// ardoise arrondi, comme le repère posé sur la photo de poste. Mêmes formes que le favicon.
interface Props { size?: number; class?: string }
const { size = 32, class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <rect width="64" height="64" rx="16" fill="#14161a" />
  <circle cx="32" cy="32" r="17" fill="none" stroke="#c6f135" stroke-width="3" />
  <circle cx="32" cy="32" r="8" fill="#c6f135" />
</svg>
