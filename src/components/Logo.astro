---
// Marque Mon Bureau Connecté : écran sur pied avec une coche (le bon réglage)
// et une LED ambre, dans un carré bleu électrique aux angles nets.
// Mêmes formes que le favicon.
interface Props { size?: number; class?: string }
const { size = 32, class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <rect width="64" height="64" rx="12" fill="var(--color-accent, #2461e6)" />
  <rect x="13" y="15" width="38" height="26" rx="3" fill="#ffffff" />
  <rect x="28.5" y="41" width="7" height="5" fill="#ffffff" />
  <rect x="20" y="46" width="24" height="4" rx="2" fill="#ffffff" />
  <path d="M22 29l6 6 13-13" fill="none" stroke="var(--color-accent, #2461e6)" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="46" cy="36" r="2.2" fill="var(--color-signal, #f2860b)" />
</svg>
