---
// Encart auteur en bas d'article. Signal de confiance (E-E-A-T) : un auteur
// identifié, une bio honnête (aucun faux diplôme), et des liens vers la page
// auteur, la méthode et le contact. Volontairement transparent sur la méthode.
import { siteConfig } from '../siteConfig';
import Icon from './Icon.astro';
const author = (Astro.props as { author?: string }).author || siteConfig.author;
const initials = author
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<aside class="authorbox" aria-label="À propos de l'auteur">
  <div class="authorbox__avatar" aria-hidden="true">{initials}</div>
  <div class="authorbox__body">
    <p class="authorbox__name">
      <a href="/auteur/">{author}</a>
      <span>Fondateur &amp; rédacteur de {siteConfig.name}</span>
    </p>
    <p class="authorbox__text">
      Je compare le matériel de bureau, de télétravail et de gaming pour n'en garder que ce qui vaut
      vraiment le coup. Je ne teste pas en laboratoire — je m'appuie sur des <strong>critères mesurables</strong>
      et de vrais retours d'utilisateurs, et je l'assume. Le site est <strong>100 % indépendant</strong> :
      aucune marque ne me sponsorise, et mes liens Amazon sont affiliés (une petite commission si tu achètes,
      sans surcoût pour toi).
    </p>
    <p class="authorbox__links">
      <a href="/auteur/">En savoir plus sur l'auteur <Icon name="arrow" size={14} /></a>
      <a href="/a-propos/">Notre méthode</a>
      <a href="/contact/">Signaler une erreur</a>
    </p>
  </div>
</aside>

<style>
  /* Carte papier arrondie à ombre douce ; monogramme sur pastille ronde lime pâle */
  .authorbox {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
    margin: 3rem 0 0;
    padding: 1.4rem 1.5rem 1.5rem;
    background: var(--papier);
    border: 1px solid var(--filet);
    border-radius: var(--radius-lg);
    box-shadow: var(--ombre);
  }
  .authorbox__avatar {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--jaune-pale);
    border-radius: 50%;
    color: var(--mine);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .authorbox__body { min-width: 0; }
  .authorbox__name { margin: 0 0 0.5rem; display: flex; flex-direction: column; gap: 0.15rem; line-height: 1.3; }
  .authorbox__name a { font-family: var(--font-display); font-weight: 700; font-size: 1rem; letter-spacing: -0.02em; text-decoration-line: none; }
  .authorbox__name a:hover { text-decoration-line: underline; }
  .authorbox__name span { font-size: 0.85rem; color: var(--gris); }
  .authorbox__text { margin: 0 0 0.8rem; font-size: 0.93rem; line-height: 1.6; color: var(--gris); }
  .authorbox__text strong { color: var(--mine); }
  .authorbox__links { margin: 0; display: flex; flex-wrap: wrap; gap: 0.1rem 1.4rem; font-size: 0.9rem; font-weight: 600; }
  .authorbox__links a { display: inline-flex; align-items: center; gap: 0.35em; min-height: 32px; text-decoration-line: none; }
  .authorbox__links a:hover { text-decoration-line: underline; }
  @media (max-width: 560px) {
    .authorbox { gap: 0.9rem; padding: 1.1rem 1.1rem 1.2rem; }
    .authorbox__avatar { width: 48px; height: 48px; }
  }
</style>
