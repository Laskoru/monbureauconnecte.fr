---
import { siteConfig } from '../siteConfig';
import { categories } from '../categories';
import { guides } from '../guides';
import { budgets } from '../budgets';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const active = (href: string) => path === href || (href !== '/' && path.startsWith(href));

// Menus déroulants (CSS uniquement : survol / focus) — comme sur les comparateurs de référence.
const menus = [
  { label: 'Par besoin', href: '/guides/', items: guides.map((g) => ({ href: `/guides/${g.slug}/`, label: g.title, icon: g.slug })) },
  { label: 'Rayons', href: '/articles/', activeWhen: '/categorie/', items: categories.map((c) => ({ href: `/categorie/${c.slug}/`, label: c.label, icon: c.slug })) },
  { label: 'Par budget', href: '/budget/', items: budgets.map((b) => ({ href: `/budget/${b.slug}/`, label: `${b.label} — ${b.range}`, icon: b.slug })) },
  { label: 'Outils', href: '/outils/', items: [
    { href: '/calculateur-hauteur-bureau/', label: 'Calculateur de hauteur de bureau', icon: 'ruler' },
    { href: '/poste-de-travail-ideal/', label: 'Le poste de travail idéal', icon: 'posture' },
    { href: '/checklist-bureau-ergonomique/', label: 'Checklist ergonomie', icon: 'checklist' },
    { href: '/guide-pc-gaming/', label: 'Guide PC gaming pièce par pièce', icon: 'cpu' },
    { href: '/lexique/', label: 'Lexique', icon: 'book' },
  ] },
];
---

<header class="hdr" id="site-header">
  <div class="wide hdr__in">
    <a href="/" class="hdr__logo" aria-label={`${siteConfig.name} — accueil`}>
      <Logo size={34} />
      <span class="hdr__name">Mon Bureau <span class="hdr__hl">Connecté</span></span>
    </a>

    <nav class="hdr__nav" id="site-nav" aria-label="Navigation principale">
      <div class="hdr__nav-in">
        <ul class="hdr__menus">
          {menus.map((m) => (
            <li class="hdr__menu">
              <a href={m.href} aria-current={active(m.activeWhen ?? m.href) ? 'page' : undefined}>{m.label} <Icon name="chevron" size={14} class="hdr__chev" /></a>
              <ul class="hdr__drop">
                {m.items.map((it) => <li><a href={it.href}><Icon name={it.icon} size={16} /> <span>{it.label}</span></a></li>)}
              </ul>
            </li>
          ))}
          <li class="hdr__menu"><a href="/articles/" aria-current={active('/articles/') ? 'page' : undefined}>Tous les comparatifs</a></li>
        </ul>
      </div>
    </nav>

    <div class="hdr__actions">
      <a class="btn btn--primary btn--sm hdr__cta" href="/calculateur-hauteur-bureau/"><Icon name="ruler" size={16} /> Ma hauteur de bureau</a>
      <button type="button" id="nav-toggle" class="hdr__toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="site-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById('nav-toggle');
    var nav = document.getElementById('site-nav');
    toggle.addEventListener('click', function () {
      var open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      toggle.classList.toggle('is-open', open);
      document.body.classList.toggle('nav-open', open);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) toggle.click();
    });
  })();
</script>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: var(--color-surface); border-bottom: 1px solid var(--color-border); transition: box-shadow .25s ease; }
  .hdr.is-scrolled { box-shadow: 0 8px 24px -20px rgba(15,26,51,.5); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; height: 68px; }
  .hdr__logo { display: inline-flex; align-items: center; gap: .6rem; text-decoration: none; color: var(--color-text); flex-shrink: 0; }
  .hdr__name { font-family: var(--font-display); font-weight: 700; font-stretch: 106%; font-size: 1.1rem; letter-spacing: -.01em; line-height: 1; }
  .hdr__hl { color: var(--color-accent-text); }

  .hdr__menus { list-style: none; margin: 0; padding: 0; display: flex; gap: .1rem; }
  .hdr__menu { position: relative; }
  .hdr__menu > a { display: inline-flex; align-items: center; gap: .3em; min-height: 68px; padding: 0 .85rem; color: var(--color-text); text-decoration: none; font-size: .95rem; font-weight: 600; box-shadow: inset 0 -3px 0 transparent; transition: color .15s ease, box-shadow .15s ease; }
  .hdr__menu > a:hover, .hdr__menu:focus-within > a { color: var(--color-accent-text); }
  .hdr__menu > a[aria-current='page'] { color: var(--color-accent-text); box-shadow: inset 0 -3px 0 var(--color-accent); }
  :global(.hdr__chev) { color: var(--color-text-faint); transition: transform .15s ease; }
  .hdr__menu:hover :global(.hdr__chev), .hdr__menu:focus-within :global(.hdr__chev) { transform: rotate(180deg); }
  .hdr__drop { list-style: none; margin: 0; padding: .5rem; position: absolute; left: 0; top: 100%; min-width: 280px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .15s ease, transform .15s ease, visibility .15s; z-index: 60; }
  .hdr__menu:hover .hdr__drop, .hdr__menu:focus-within .hdr__drop { opacity: 1; visibility: visible; transform: none; }
  .hdr__drop a { display: flex; align-items: center; gap: .6rem; padding: .6rem .7rem; border-radius: var(--radius-sm); color: var(--color-text); text-decoration: none; font-size: .92rem; font-weight: 500; line-height: 1.3; }
  .hdr__drop a:hover { background: var(--color-accent-soft); color: var(--color-accent-text); }
  .hdr__drop a svg { flex-shrink: 0; color: var(--color-accent-text); }

  .hdr__actions { display: flex; align-items: center; gap: .6rem; flex-shrink: 0; }
  .hdr__toggle { display: none; flex-direction: column; justify-content: center; gap: 5px; width: 44px; height: 44px; border-radius: var(--radius-sm); border: 1px solid var(--color-border-strong); background: var(--color-surface); cursor: pointer; padding: 0; }
  .hdr__toggle span { width: 18px; height: 2px; margin: 0 auto; background: var(--color-text); transition: transform .2s ease, opacity .2s ease; }
  .hdr__toggle.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hdr__toggle.is-open span:nth-child(2) { opacity: 0; }
  .hdr__toggle.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 1100px) { .hdr__menu > a { padding: 0 .6rem; font-size: .9rem; } .hdr__cta { display: none; } }
  @media (max-width: 900px) {
    .hdr__in { height: 62px; }
    .hdr__toggle { display: flex; }
    .hdr__nav { position: absolute; top: 100%; left: 0; right: 0; background: var(--color-surface); border-bottom: 1px solid var(--color-border); box-shadow: var(--shadow-lg); display: grid; grid-template-rows: 0fr; transition: grid-template-rows .25s ease; }
    .hdr__nav.is-open { grid-template-rows: 1fr; }
    .hdr__nav-in { min-height: 0; overflow: hidden; }
    .hdr__menus { flex-direction: column; padding: .4rem 0 .6rem; max-height: calc(100vh - 62px); overflow: auto; }
    .hdr__menu > a { min-height: 48px; padding: 0 1.25rem; font-size: 1rem; box-shadow: none; }
    .hdr__menu > a[aria-current='page'] { box-shadow: inset 4px 0 0 var(--color-accent); }
    :global(.hdr__chev) { display: none; }
    .hdr__drop { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: 0; border-radius: 0; padding: 0 .75rem .4rem; min-width: 0; }
    .hdr__drop a { padding: .45rem .5rem; font-size: .92rem; }
  }
</style>
