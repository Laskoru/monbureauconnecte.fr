---
import { siteConfig } from '../siteConfig';
import { categories } from '../categories';
import { guides } from '../guides';
import { budgets } from '../budgets';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const active = (href: string) => path === href || (href !== '/' && path.startsWith(href));

// Menus déroulants (CSS : survol et focus), ouverts en liste sur mobile.
const menus = [
  { label: 'Par besoin', href: '/guides/', items: guides.map((g) => ({ href: `/guides/${g.slug}/`, label: g.title, icon: g.slug })) },
  { label: 'Rayons', href: '/articles/', activeWhen: '/categorie/', items: categories.map((c) => ({ href: `/categorie/${c.slug}/`, label: c.label, icon: c.slug })) },
  { label: 'Par budget', href: '/budget/', items: budgets.map((b) => ({ href: `/budget/${b.slug}/`, label: `${b.label} · ${b.range}`, icon: b.slug })) },
  { label: 'Outils', href: '/outils/', items: [
    { href: '/calculateur-hauteur-bureau/', label: 'Calculateur de hauteur de bureau', icon: 'ruler' },
    { href: '/poste-de-travail-ideal/', label: 'Le poste de travail idéal', icon: 'posture' },
    { href: '/checklist-bureau-ergonomique/', label: 'Checklist ergonomie', icon: 'checklist' },
    { href: '/guide-pc-gaming/', label: 'Guide PC gaming pièce par pièce', icon: 'cpu' },
    { href: '/lexique/', label: 'Lexique', icon: 'book' },
  ] },
];
---

<header class="hdr" id="site-header">
  <div class="wide hdr__in">
    <a href="/" class="hdr__logo" aria-label={`${siteConfig.name}, accueil`}>
      <Logo size={32} />
      <span class="hdr__name">Mon Bureau Connecté</span>
    </a>

    <nav class="hdr__nav" id="site-nav" aria-label="Navigation principale">
      <div class="hdr__nav-in">
        <ul class="hdr__menus">
          {menus.map((m) => (
            <li class="hdr__menu">
              <a href={m.href} aria-current={active(m.activeWhen ?? m.href) ? 'page' : undefined}>{m.label} <Icon name="chevron" size={14} class="hdr__chev" /></a>
              <ul class="hdr__drop">
                {m.items.map((it) => <li><a href={it.href}><Icon name={it.icon} size={18} /> <span>{it.label}</span></a></li>)}
              </ul>
            </li>
          ))}
          <li class="hdr__menu"><a href="/articles/" aria-current={path === '/articles/' ? 'page' : undefined}>Comparatifs</a></li>
        </ul>
      </div>
    </nav>

    <div class="hdr__actions">
      <button type="button" class="hdr__icon-btn theme-btn" id="theme-toggle" aria-label="Passer en thème sombre">
        <Icon name="moon" size={20} class="i-moon" />
        <Icon name="sun" size={20} class="i-sun" />
      </button>
      <a class="btn btn--primary btn--sm hdr__cta" href="/calculateur-hauteur-bureau/"><Icon name="ruler" size={16} /> Ma hauteur de bureau</a>
      <button type="button" id="nav-toggle" class="hdr__icon-btn hdr__toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="site-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById('nav-toggle');
    var nav = document.getElementById('site-nav');
    toggle.addEventListener('click', function () {
      var open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      toggle.classList.toggle('is-open', open);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) toggle.click();
    });

    // Thème : clair ou mine de plomb, mémorisé (clé « theme »), sinon préférence système
    var root = document.documentElement;
    var btn = document.getElementById('theme-toggle');
    var media = window.matchMedia('(prefers-color-scheme: dark)');
    function current() { return root.getAttribute('data-theme') || (media.matches ? 'dark' : 'light'); }
    function label() { btn.setAttribute('aria-label', current() === 'dark' ? 'Passer en thème clair' : 'Passer en thème sombre'); }
    label();
    btn.addEventListener('click', function () {
      var next = current() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
      label();
    });
    if (media.addEventListener) media.addEventListener('change', label);
  })();
</script>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--calque) 88%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid transparent; transition: border-color 0.2s ease; }
  .hdr.is-scrolled { border-bottom-color: var(--filet); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; height: 64px; }
  .hdr__logo { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--mine); flex-shrink: 0; }
  .hdr__name { font-family: var(--font-display); font-weight: 800; font-size: 1rem; letter-spacing: -0.03em; line-height: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .hdr__menus { list-style: none; margin: 0; padding: 0; display: flex; }
  .hdr__menu { position: relative; }
  .hdr__menu > a { display: inline-flex; align-items: center; gap: 0.3em; min-height: 64px; padding: 0 0.8rem; color: var(--mine); text-decoration: none; font-size: 0.95rem; font-weight: 500; box-shadow: inset 0 -3px 0 transparent; transition: box-shadow 0.18s ease; }
  .hdr__menu > a:hover, .hdr__menu:focus-within > a { box-shadow: inset 0 -3px 0 var(--jaune-pale); }
  .hdr__menu > a[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--jaune); }
  :global(.hdr__chev) { color: var(--gris); transition: transform 0.18s ease; }
  .hdr__menu:hover :global(.hdr__chev), .hdr__menu:focus-within :global(.hdr__chev) { transform: rotate(180deg); }
  .hdr__drop { list-style: none; margin: 0; padding: 0.5rem; position: absolute; left: 0; top: 100%; min-width: 300px; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--radius-lg); box-shadow: var(--ombre-2); opacity: 0; visibility: hidden; transform: translateY(4px); transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s; z-index: 60; }
  .hdr__menu:hover .hdr__drop, .hdr__menu:focus-within .hdr__drop { opacity: 1; visibility: visible; transform: none; }
  .hdr__drop a { display: flex; align-items: center; gap: 0.7rem; padding: 0.6rem 0.7rem; border-radius: 8px; color: var(--mine); text-decoration: none; font-size: 0.93rem; line-height: 1.3; }
  .hdr__drop a:hover { background: var(--jaune-pale); }
  .hdr__drop a :global(svg) { flex-shrink: 0; color: var(--gris); }

  .hdr__actions { display: flex; align-items: center; gap: 0.6rem; flex-shrink: 0; }
  .hdr__icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; padding: 0; border: 1px solid var(--filet); border-radius: 50%; background: transparent; color: var(--mine); cursor: pointer; transition: border-color 0.18s ease, background-color 0.18s ease; }
  .hdr__icon-btn:hover { border-color: var(--mine); background: var(--papier); }
  .theme-btn :global(.i-sun) { display: none; }
  :global(:root[data-theme='dark']) .theme-btn :global(.i-sun) { display: block; }
  :global(:root[data-theme='dark']) .theme-btn :global(.i-moon) { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-btn :global(.i-sun) { display: block; }
    :global(:root:not([data-theme='light'])) .theme-btn :global(.i-moon) { display: none; }
  }
  .hdr__toggle { display: none; flex-direction: column; justify-content: center; gap: 5px; }
  .hdr__toggle span { width: 18px; height: 1.5px; margin: 0 auto; background: var(--mine); transition: transform 0.2s ease, opacity 0.2s ease; }
  .hdr__toggle.is-open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .hdr__toggle.is-open span:nth-child(2) { opacity: 0; }
  .hdr__toggle.is-open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  @media (max-width: 1180px) { .hdr__menu > a { padding: 0 0.55rem; font-size: 0.9rem; } .hdr__cta { display: none; } }
  @media (max-width: 960px) {
    .hdr__in { height: 60px; gap: 0.75rem; }
    .hdr__toggle { display: flex; }
    .hdr__nav { position: absolute; top: 100%; left: 0; right: 0; background: var(--calque); border-bottom: 1px solid var(--filet); box-shadow: var(--ombre-2); display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.25s var(--ease-out); }
    .hdr__nav.is-open { grid-template-rows: 1fr; }
    .hdr__nav-in { min-height: 0; overflow: hidden; }
    .hdr__menus { flex-direction: column; padding: 0.4rem 0 0.8rem; max-height: calc(100vh - 60px); overflow: auto; }
    .hdr__menu > a { min-height: 48px; padding: 0 var(--gutter); font-size: 1rem; font-weight: 600; box-shadow: none; }
    .hdr__menu > a[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--jaune); }
    :global(.hdr__chev) { display: none; }
    .hdr__drop { position: static; opacity: 1; visibility: visible; transform: none; border: 0; background: transparent; padding: 0 calc(var(--gutter) - 0.7rem) 0.5rem; min-width: 0; }
    .hdr__drop a { padding: 0.5rem 0.7rem; font-size: 0.95rem; }
  }
  @media (max-width: 430px) { .hdr__name { font-size: 0.88rem; } .hdr__actions { gap: 0.4rem; } }
  @media (max-width: 360px) { .hdr__name { font-size: 0.8rem; } }
</style>
